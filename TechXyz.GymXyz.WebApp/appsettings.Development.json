{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ResetDatabaseOnStartup": true,
  // Rooted on "localhost" so http://teamtrainers.localhost:5173 resolves
  // "teamtrainers" exactly as teamtrainers.gymxyz.fr does in production. Without
  // it there is no subdomain to cut, every host falls back to DefaultSlug, and
  // the login screen is GymXYZ blue whatever the customer.
  "Tenant": {
    "RootDomain": "localhost"
  },
  "ConnectionStrings": {
    "GymXyzDb": "Host=localhost;Port=3306;Database=gymxyz-db;Username=root;Password=password"
  }
}
