@namespace TechXyz.GymXyz.WebApp.Components.Features.Members

@* Subscription history behind the record's "Historique" button, and the place a
   plan is sold to one member. The interim CRUD lot 1 wrote here against a raw
   session count is gone: a subscription is a plan now, and everything it carries
   — how long it runs, what it costs, how many entries it holds — comes off the
   formule rather than off a form. *@

<GxDrawer Title="Abonnements"
          Subtitle="@Subtitle"
          Icon="@GxIconPaths.Card"
          OnClose="OnClose">
    <ChildContent>
        @if (_mode == Mode.List)
        {
            <div class="gx-seclab">Historique</div>
            @if (Subscriptions.Count == 0)
            {
                <div style="font-size:var(--text-sm);color:var(--text-muted)">
                    Aucun abonnement enregistré.
                </div>
            }
            else
            {
                @foreach (var subscription in Subscriptions)
                {
                    <div class="gx-listrow">
                        <div class="main">
                            <div class="t">@subscription.PlanName</div>
                            <div class="s">
                                Du @GxFormats.ShortDate(subscription.StartedOn)
                                au @GxFormats.ShortDate(subscription.EndsOn)
                                @if (subscription.Kind == PlanKind.CreditPack)
                                {
                                    <text> · @subscription.CreditsLabel séances</text>
                                }
                            </div>
                        </div>
                        <GxChip Tone="@ToneFor(subscription)">@LabelFor(subscription)</GxChip>
                        <FluentButton Appearance="Appearance.Stealth" Title="Renouveler" aria-label="Renouveler l'abonnement"
                                      @onclick="() => OnRenew.InvokeAsync(subscription.Id)">
                            <GxIcon Name="@GxIconPaths.Refresh" Size="18"/>
                        </FluentButton>
                        <FluentButton Appearance="Appearance.Stealth" Title="Supprimer" aria-label="Supprimer l'abonnement"
                                      @onclick="() => OnDelete.InvokeAsync(subscription.Id)">
                            <GxIcon Name="@GxIconPaths.Trash" Size="18"/>
                        </FluentButton>
                    </div>
                }
            }
        }
        else
        {
            <div class="gx-seclab">Nouvel abonnement</div>
            @if (Plans.Count == 0)
            {
                <div style="font-size:var(--text-sm);color:var(--text-muted)">
                    Aucune formule n'est proposée pour l'instant.
                </div>
            }
            else
            {
                <div class="gx-form-field">
                    <FluentSelect Label="Formule"
                                  TOption="PlanDto"
                                  Items="Plans"
                                  OptionValue="@(plan => plan.Id.ToString())"
                                  OptionText="@(plan => $"{plan.Name} — {plan.PriceLabel}")"
                                  @bind-SelectedOption="_selectedPlan"
                                  style="width:100%"/>
                </div>
                <div class="gx-form-field">
                    <FluentDatePicker Label="Début" @bind-Value="_startedOn" style="width:100%"/>
                </div>
                @if (_selectedPlan is { } plan)
                {
                    <div style="font-size:var(--text-xs);color:var(--text-muted);margin-bottom:12px">
                        @plan.BillingLabel · couvre @plan.ValidityMonths mois
                        @if (plan.CreditCount is { } credits)
                        {
                            <text> · @credits séances</text>
                        }
                    </div>
                    @if (plan.Kind == PlanKind.Recurring)
                    {
                        <div style="padding:6px 0">
                            <FluentSwitch @bind-Value="_autoRenew">Renouvellement automatique</FluentSwitch>
                        </div>
                    }
                }
            }
        }
    </ChildContent>
    <Footer>
        @if (_mode == Mode.List)
        {
            <span style="margin-left:auto;display:flex;gap:10px">
                <FluentButton Appearance="Appearance.Stealth" @onclick="OnClose">Fermer</FluentButton>
                <FluentButton Appearance="Appearance.Accent" @onclick="StartCreate">
                    <GxIcon Slot="start" Name="@GxIconPaths.Plus" Size="18"/>
                    Ajouter
                </FluentButton>
            </span>
        }
        else
        {
            <span style="margin-left:auto;display:flex;gap:10px">
                <FluentButton Appearance="Appearance.Stealth" @onclick="BackToList">Annuler</FluentButton>
                <FluentButton Appearance="Appearance.Accent" Disabled="@(_selectedPlan is null)" @onclick="SubmitAsync">
                    <GxIcon Slot="start" Name="@GxIconPaths.Check" Size="18"/>
                    Enregistrer
                </FluentButton>
            </span>
        }
    </Footer>
</GxDrawer>

@code {
    private enum Mode { List, Form }

    private Mode _mode = Mode.List;
    private PlanDto? _selectedPlan;
    private DateTime? _startedOn;
    private bool _autoRenew = true;

    [Parameter, EditorRequired] public IReadOnlyList<MemberSubscriptionDto> Subscriptions { get; set; } = [];
    [Parameter, EditorRequired] public IReadOnlyList<PlanDto> Plans { get; set; } = [];
    [Parameter] public string? Subtitle { get; set; }

    /// <summary>Opens straight on the form, prefilled to follow the current cover.</summary>
    [Parameter] public bool StartOnNew { get; set; }

    [Parameter] public MemberSubscriptionDto? CurrentSubscription { get; set; }

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<SubscriptionInput> OnCreate { get; set; }
    [Parameter] public EventCallback<int> OnRenew { get; set; }
    [Parameter] public EventCallback<int> OnDelete { get; set; }

    protected override void OnInitialized()
    {
        if (StartOnNew)
        {
            StartCreate();
        }
    }

    private void StartCreate()
    {
        // A new cover picks up where the current one stops; a first subscription
        // starts today. Neither is a business rule — just a sensible prefill.
        var start = CurrentSubscription is { } current
            ? current.EndsOn.AddDays(1)
            : DateOnly.FromDateTime(DateTime.Today);

        _startedOn = start.ToDateTime(TimeOnly.MinValue);
        _selectedPlan = Plans.FirstOrDefault(plan => plan.Id == CurrentSubscription?.PlanId)
                        ?? Plans.FirstOrDefault(plan => plan.IsFeatured)
                        ?? Plans.FirstOrDefault();
        _autoRenew = CurrentSubscription?.AutoRenew ?? true;
        _mode = Mode.Form;
    }

    private void BackToList() => _mode = Mode.List;

    private async Task SubmitAsync()
    {
        if (_selectedPlan is not { } plan)
        {
            return;
        }

        await OnCreate.InvokeAsync(new SubscriptionInput(
            plan.Id,
            _startedOn is { } start
                ? DateOnly.FromDateTime(start)
                : DateOnly.FromDateTime(DateTime.Today),
            plan.Kind == PlanKind.Recurring && _autoRenew));

        BackToList();
    }

    private static GxTone ToneFor(MemberSubscriptionDto subscription) => subscription.Status switch
    {
        SubscriptionStatus.Active => GxTone.Success,
        SubscriptionStatus.ExpiringSoon => GxTone.Warning,
        SubscriptionStatus.Late => GxTone.Danger,
        _ => GxTone.Neutral
    };

    private static string LabelFor(MemberSubscriptionDto subscription) => subscription.Status switch
    {
        SubscriptionStatus.Active => "En cours",
        SubscriptionStatus.ExpiringSoon => "Expire bientôt",
        SubscriptionStatus.Late => "En retard",
        SubscriptionStatus.Ended => "Terminé",
        // No status at all means the cover has not begun — a renewal booked for
        // after the current one runs out.
        _ => "À venir"
    };

    public sealed record SubscriptionInput(int PlanId, DateOnly StartedOn, bool AutoRenew);
}
