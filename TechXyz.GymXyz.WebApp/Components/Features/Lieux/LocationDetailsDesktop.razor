@namespace TechXyz.GymXyz.WebApp.Components.Features.Lieux

@* Desktop venue record: head, then two columns — figures, the day's schedule
   and either the weekly heatmap or the meeting-point card on the left, the
   description, the equipment and the details on the right.

   Which of the two bottom-left cards is drawn follows the nature of the venue,
   as in the prototype: a studio is measured by how full it gets, a venue you
   travel to is measured by where it is. *@

<Crumb Parts="@Crumbs"/>

<div class="gx-fiche-head">
    <span class="gx-disc-ic big t-@LocationFilters.ToneClass(Location.Tone)">
        <GxIcon Name="@LocationFilters.IconFor(Location.IconKey, Location.Kind)" Size="28"/>
    </span>
    <div class="info">
        <div class="name-row">
            <span class="name">@Location.Name</span>
            <GxChip>@LocationFilters.LabelFor(Location.Kind)</GxChip>
            <GxChip Tone="@LocationFilters.ToneFor(Location.Status)">
                @LocationFilters.LabelFor(Location.Status)
            </GxChip>
        </div>
        <div class="contact">@LocationFilters.SummaryFor(Location)</div>
    </div>
    <FluentButton Appearance="Appearance.Outline" @onclick="OnPlanning">
        <GxIcon Slot="start" Name="@GxIconPaths.Calendar" Size="18"/>
        Planning
    </FluentButton>
    <FluentButton Appearance="Appearance.Accent" @onclick="OnEdit">
        <GxIcon Slot="start" Name="@GxIconPaths.Settings" Size="18"/>
        Éditer
    </FluentButton>
</div>

<div class="gx-grid2" style="grid-template-columns:1.3fr 1fr;align-items:start">
    <div class="gx-col">
        <div class="gx-grid3">
            @if (Location.Kind == LocationKind.Studio)
            {
                <Kpi Label="Occupation"
                     Value="@(Location.Occupancy.AverageRate is { } rate ? $"{rate} %" : "—")"
                     Sub="@TrailingHint"/>
            }
            <Kpi Label="Créneaux / sem."
                 Value="@(Location.Occupancy.SessionsPerWeek is { } slots ? GxFormats.Count(slots) : "—")"
                 Sub="cette semaine"/>
            <Kpi Label="Capacité" Value="@GxFormats.Count(Location.Capacity)" Sub="@CapacitySub"/>
            @if (Location.Kind == LocationKind.Outdoor)
            {
                <Kpi Label="Repli"
                     Value="@(Location.FallbackLocationName ?? "—")"
                     Sub="en cas de pluie"/>
            }
            else if (Location.Kind == LocationKind.Home)
            {
                <Kpi Label="Déplacement" Value="Mobile" Sub="chez le membre"/>
            }
        </div>

        <GxCard Padded="false">
            <CardHead Title="Planning du jour">
                <FluentButton Appearance="Appearance.Stealth" @onclick="OnPlanning">
                    <GxIcon Slot="start" Name="@GxIconPaths.Calendar" Size="16"/>
                    Semaine
                </FluentButton>
            </CardHead>
            <div style="padding:4px 18px 10px">
                @if (Location.Today.Count == 0)
                {
                    <div style="padding:14px 0;font-size:var(--text-sm);color:var(--text-muted)">
                        Aucune séance aujourd'hui. Le planning arrive avec les séances datées.
                    </div>
                }
                else
                {
                    @foreach (var session in Location.Today)
                    {
                        var percent = session.Capacity == 0
                            ? 0
                            : (int)Math.Round(session.Registered * 100d / session.Capacity);

                        <div class="gx-listrow">
                            <span style="width:52px;flex:none;font-size:var(--text-sm);font-weight:var(--weight-bold);color:var(--color-brand)">
                                @session.Time
                            </span>
                            <div class="main">
                                <div class="t">@session.CourseName</div>
                                <div class="s">@(session.CoachName ?? "Accès libre")</div>
                            </div>
                            <GxChip Tone="@(percent >= 100 ? GxTone.Danger : GxTone.Brand)">
                                @(session.IsPrivate ? "Privé" : $"{session.Registered}/{session.Capacity}")
                            </GxChip>
                        </div>
                    }
                }
            </div>
        </GxCard>

        @if (Location.Kind == LocationKind.Studio)
        {
            <GxCard Padded="false">
                <CardHead Title="Occupation de la semaine">
                    <span style="font-size:var(--text-2xs);color:var(--text-muted)">moyenne par jour</span>
                </CardHead>
                <div style="padding:16px 18px">
                    @if (Location.Occupancy.HasHeatmap)
                    {
                        <div class="gx-heat">
                            @for (var day = 0; day < DayLabels.Length; day++)
                            {
                                var rate = Location.Occupancy.DailyRates[day];

                                <div class="d">
                                    <span class="pct">@rate&nbsp;%</span>
                                    <div class="bar">
                                        <i style="height:@(rate)%;background:@HeatColor(rate)"></i>
                                    </div>
                                    <span class="lab">@DayLabels[day]</span>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        @* Seven flat bars would read as "nobody comes here", which
                           is not what an absence of sessions means. *@
                        <div style="font-size:var(--text-sm);color:var(--text-muted)">
                            La courbe d'occupation se remplit avec les séances du planning.
                        </div>
                    }
                </div>
            </GxCard>
        }
        else
        {
            <GxCard Padded="false">
                <CardHead Title="@(IsOutdoor ? "Point de rendez-vous" : "Adresse de la séance")"/>
                <div class="gx-rdv">
                    <span class="pin">
                        <GxIcon Name="@(IsOutdoor ? GxIconPaths.Pin : GxIconPaths.Home)" Size="20"/>
                    </span>
                    <div>
                        <div class="addr">
                            @(IsOutdoor
                                ? LocationFilters.AddressLine(Location.Address) ?? "Point de rendez-vous à préciser"
                                : "Au domicile du membre")
                        </div>
                        <div class="sub">
                            @(IsOutdoor ? Location.Name : "Renseignée sur la fiche du membre")
                        </div>
                    </div>
                </div>
                @if (IsOutdoor)
                {
                    <div class="gx-rdv-repli">
                        <GxIcon Name="@GxIconPaths.Cloud" Size="16"/>
                        <span>
                            @if (Location.FallbackLocationName is { } fallback)
                            {
                                @:En cas de pluie, repli en <b>@fallback</b>
                            }
                            else
                            {
                                @:Aucun lieu de repli n'est défini pour ce lieu.
                            }
                        </span>
                    </div>
                }
                else
                {
                    <div class="gx-rdv-repli">
                        <GxIcon Name="@GxIconPaths.Send" Size="16"/>
                        <span>Transmise au coach avant chaque rendez-vous</span>
                    </div>
                }
            </GxCard>
        }
    </div>

    <div class="gx-col">
        <GxCard Padded="false">
            <CardHead Title="À propos"/>
            <div style="padding:14px 18px 16px;font-size:var(--text-sm);color:var(--text-body);line-height:1.55">
                @(string.IsNullOrWhiteSpace(Location.Note)
                    ? "Aucune description pour l'instant."
                    : Location.Note)
            </div>
        </GxCard>

        <GxCard Padded="false">
            <CardHead Title="@(Location.Kind == LocationKind.Studio ? "Équipement" : "Matériel")">
                <GxChip>@GxFormats.Count(Location.Equipment.Count)</GxChip>
            </CardHead>
            <div style="padding:14px 18px 18px">
                @if (Location.Equipment.Count == 0)
                {
                    <div style="font-size:var(--text-sm);color:var(--text-muted)">
                        Aucun équipement renseigné.
                    </div>
                }
                else
                {
                    <div class="gx-tags">
                        @foreach (var label in Location.Equipment)
                        {
                            <span class="gx-tag brand">@label</span>
                        }
                    </div>
                }
            </div>
        </GxCard>

        <GxCard Padded="false">
            <CardHead Title="Informations"/>
            <div style="padding:4px 18px 10px">
                @foreach (var (key, value) in Details)
                {
                    <div class="gx-kv">
                        <span class="k">@key</span>
                        <span class="v">@value</span>
                    </div>
                }
            </div>
        </GxCard>
    </div>
</div>

@code {
    /// <summary>The window every rate on this build is averaged over.</summary>
    private const string TrailingHint = "sur 4 semaines";

    private static readonly string[] DayLabels = ["Lun", "Mar", "Mer", "Jeu", "Ven", "Sam", "Dim"];

    [Parameter, EditorRequired] public LocationDetailsPageDto Location { get; set; } = default!;

    [Parameter] public EventCallback OnEdit { get; set; }
    [Parameter] public EventCallback OnPlanning { get; set; }

    private bool IsOutdoor => Location.Kind == LocationKind.Outdoor;

    private IReadOnlyList<Crumb.Part> Crumbs =>
    [
        new("Accueil", "/"),
        new("Lieux", "/lieux"),
        new(Location.Name)
    ];

    private string CapacitySub => Location.Kind switch
    {
        LocationKind.Outdoor => "places (souple)",
        LocationKind.Home => "place / séance",
        _ => "places"
    };

    /// <summary>
    /// The "Informations" list, which says something different for each nature
    /// of venue — there is no floor to state about a park.
    /// </summary>
    private IReadOnlyList<(string Key, string Value)> Details
    {
        get
        {
            var type = Location.TypeLabel ?? LocationFilters.LabelFor(Location.Kind);

            return Location.Kind switch
            {
                LocationKind.Outdoor =>
                [
                    ("Type", type),
                    ("Point de RDV", LocationFilters.AddressLine(Location.Address) ?? "—"),
                    ("Capacité", LocationFilters.CapacityLabel(Location.Capacity)),
                    ("Météo", Location.IsWeatherDependent ? "Dépendant" : "Sans incidence"),
                    ("Repli", Location.FallbackLocationName ?? "—")
                ],
                LocationKind.Home =>
                [
                    ("Type", type),
                    ("Adresse", "Chez le membre"),
                    ("Capacité", "1 place"),
                    ("Déplacement", "Coach se déplace")
                ],
                _ =>
                [
                    ("Type", type),
                    ("Surface", LocationFilters.AreaLabel(Location.AreaSqm) ?? "—"),
                    ("Étage", Location.Floor ?? "—"),
                    ("Capacité", LocationFilters.CapacityLabel(Location.Capacity)),
                    ("Site", Location.SiteName ?? "—"),
                    ("Accès", LocationFilters.LabelFor(Location.Status))
                ]
            };
        }
    }

    /// <summary>The prototype's three bands: ≥ 90 danger, ≥ 70 brand, else azure.</summary>
    private static string HeatColor(int rate) => rate switch
    {
        >= 90 => "var(--color-danger)",
        >= 70 => "var(--color-primary)",
        _ => "var(--azure-300)"
    };
}
