@namespace TechXyz.GymXyz.WebApp.Components.Features.Planning
@implements IAsyncDisposable

@using MediatR
@using TechXyz.GymXyz.Application.Queries

@inject ISender Sender
@inject IJSRuntime JS
@inject IUserFeedbackService UserFeedback

@* Owns the generation of the published image, for all three buttons — Accueil
   desktop, Accueil mobile and the head of the Planning. They look different and
   they do the same thing, so the doing lives here and each screen keeps its own
   button.

   The poster is rendered at its true 1080 × 1350 and pushed off-screen rather
   than hidden: display:none and visibility:hidden both stop the layout the
   capture reads, and there would be nothing to rasterise.

   It is only in the DOM while a generation is running, so an idle screen does
   not carry a second copy of the week. *@

@if (_week is not null)
{
    <div class="gx-poster-stage" aria-hidden="true">
        <PlanningPoster Week="_week" Brand="Brand" ElementId="@ElementId"/>
    </div>
}

@code {
    private const string ElementId = "gx-planning-poster";

    [CascadingParameter] private TenantBrandDto? Brand { get; set; }

    /// <summary>Raised so the buttons can show that something is happening.</summary>
    [Parameter] public EventCallback<bool> OnBusyChanged { get; set; }

    private IJSObjectReference? _module;
    private PosterWeekDto? _week;
    private TaskCompletionSource? _staged;

    /// <summary>True while an image is being produced — the buttons read it.</summary>
    public bool IsBusy { get; private set; }

    /// <summary>
    /// Produces the poster for the week <paramref name="anchor"/> falls in — the
    /// week the calling screen is showing — and hands the file to the browser.
    /// </summary>
    public async Task GenerateAsync(DateOnly anchor)
    {
        if (IsBusy)
        {
            return;
        }

        await SetBusyAsync(true);

        try
        {
            // Refused outright for anyone but a manager: the query carries
            // IManagerOnly, so this throws rather than quietly returning the
            // caller's own sessions dressed as the club's week.
            _week = await Sender.Send(new GetPlanningPosterQuery(anchor));

            // The poster has to exist in the DOM before the browser can read it,
            // and a Blazor Server render is a round trip. Resolved by
            // OnAfterRenderAsync below.
            _staged = new TaskCompletionSource(TaskCreationOptions.RunContinuationsAsynchronously);
            StateHasChanged();
            await _staged.Task;

            _module ??= await JS.InvokeAsync<IJSObjectReference>("import", "./js/gx-poster.js");

            var outcome = await _module.InvokeAsync<PosterOutcome>(
                "download",
                ElementId,
                FileName(_week),
                PosterLayout.Width,
                PosterLayout.Height,
                PosterLayout.Scale,
                PosterLayout.DisplayFont(Brand?.ThemeKey));

            if (outcome.Ok)
            {
                UserFeedback.ShowSuccess(BroadcastLabels.Done);
            }
            else
            {
                // Said out loud and kept out of the render: a generation that
                // fails is a message, never a broken image the manager might
                // publish without noticing.
                UserFeedback.Handle(
                    new InvalidOperationException($"Poster generation failed: {outcome.Reason}"),
                    BroadcastLabels.Action);
            }
        }
        catch (Exception exception)
        {
            UserFeedback.Handle(exception, BroadcastLabels.Action);
        }
        finally
        {
            _week = null;
            _staged = null;
            await SetBusyAsync(false);
        }
    }

    protected override void OnAfterRender(bool firstRender)
    {
        // Fires after every render; the source is replaced each generation, so
        // only the one being waited on is ever completed.
        if (_week is not null)
        {
            _staged?.TrySetResult();
        }
    }

    /// <summary>« planning-2026-08-10.png » — the Monday it opens on.</summary>
    private static string FileName(PosterWeekDto week) =>
        $"planning-{week.WeekStart:yyyy-MM-dd}.png";

    private async Task SetBusyAsync(bool busy)
    {
        IsBusy = busy;
        StateHasChanged();

        await OnBusyChanged.InvokeAsync(busy);
    }

    /// <summary>What gx-poster.js answers: it reports refusals, it does not throw them.</summary>
    private sealed record PosterOutcome(bool Ok, string? Reason, long Bytes);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit went away first; there is nothing left to release.
            }
        }
    }
}
