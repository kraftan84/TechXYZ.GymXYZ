@implements IAsyncDisposable
@inject IJSRuntime JS

@* Mobile Accueil: greeting, the week strip, today's classes and the alerts.
   Presentation only — every figure and every navigation comes from Home.razor.

   The mobile mockup had already decided what the desktop one leaves open: a day
   of the strip goes to the Planning (onNavigate('planning')), not to a day
   screen of its own. That is the reading this lot follows on both shells.

   « Diffuser le planning » is the prototype's primary CTA. It renders disabled
   with the reason on it rather than doing nothing quietly: a real broadcast
   needs a seventh NotificationKey, a seventh toggle in the lot 8 panel and a
   recipient list nobody has defined. *@

<div class="gx-m-screen">
    <div class="gx-m-greet">
        <div class="hi">Bonjour @GreetingName</div>
        <div class="sub">Préparez la semaine et diffusez-la à vos membres.</div>
    </div>

    <button type="button" class="gx-m-cta ghost" style="margin-top:16px" disabled
            title="@DashboardFilters.BroadcastDisabledReason">
        <GxIcon Name="@GxIconPaths.Share" Size="20"/>
        Diffuser le planning
    </button>

    <div class="gx-m-sec"><span class="t">@DashboardFilters.RangeLabel(Dashboard.WeekStart)</span></div>
    <div class="gx-m-card">
        <div style="padding:12px 12px 4px">
            <div class="gx-m-weekstrip" @ref="_strip">
                @foreach (var day in Dashboard.Week)
                {
                    var mark = Calendar.MarkFor(day.Date);

                    <div class="gx-m-day @(day.IsToday ? "on" : null)"
                         role="button"
                         tabindex="0"
                         @onclick="() => OnOpenDay.InvokeAsync(day.Date)"
                         aria-label="@AriaFor(day, mark)">
                        <div class="dn">@DashboardFilters.DayName(day.Date)</div>
                        <div class="nm">@day.Date.Day</div>
                        <div class="ct">@day.SessionCount c.</div>
                        @if (mark is not null)
                        {
                            <span class="mk @CalendarFormats.MarkClass(mark.Kind)" title="@mark.Label">
                                <GxIcon Name="@CalendarFormats.MarkIcon(mark.Kind)" Size="10"/>
                            </span>
                        }
                    </div>
                }
            </div>
        </div>
        <div class="gx-m-diffuse">
            <GxIcon Name="@GxIconPaths.Send" Size="16"/>
            <span>@DashboardFilters.BroadcastFootnote</span>
        </div>
    </div>

    <div class="gx-m-sec">
        <span class="t">@DashboardFilters.TodayTitle(Dashboard)</span>
        <span class="more" role="button" tabindex="0" @onclick="() => OnOpenPlanning.InvokeAsync()">
            Planning
            <GxIcon Name="@GxIconPaths.ChevronRight" Size="14"/>
        </span>
    </div>
    <div class="gx-m-card">
        @if (!IsLoaded)
        {
            <div class="gx-m-note">Chargement…</div>
        }
        else if (Dashboard.TodayClasses.Count == 0)
        {
            <div class="gx-m-note">Aucun cours aujourd'hui.</div>
        }
        else
        {
            @foreach (var session in Dashboard.TodayClasses)
            {
                <div class="gx-m-class"
                     role="button"
                     tabindex="0"
                     @onclick="() => OnOpenDay.InvokeAsync(Dashboard.Today)"
                     aria-label="@($"Ouvrir {session.CourseName} dans le planning")">
                    <div class="time">@GxFormats.Time(session.StartsAt)</div>
                    <div class="main">
                        <div class="nm">@session.CourseName</div>
                        <div class="meta">@session.Meta</div>
                    </div>
                    @if (session.IsPrivate)
                    {
                        <div style="flex:none"><GxChip Tone="GxTone.Neutral">Privé</GxChip></div>
                    }
                    else if (session.IsFull)
                    {
                        <div style="flex:none"><GxChip Tone="GxTone.Danger">Complet</GxChip></div>
                    }
                    else
                    {
                        <div class="occ">
                            <div class="n">@session.Registered/@session.Capacity</div>
                            <div class="gx-m-bar">
                                <i style="width:@(session.FillPercent ?? 0)%"></i>
                            </div>
                        </div>
                    }
                </div>
            }
        }
    </div>

    <div class="gx-m-sec"><span class="t">À surveiller</span></div>
    <div class="gx-m-card">
        @if (!IsLoaded)
        {
            <div class="gx-m-note">Chargement…</div>
        }
        else if (_alerts.Count == 0)
        {
            <div class="gx-m-note">Rien à surveiller. Tout est à jour.</div>
        }
        else
        {
            @foreach (var alert in _alerts)
            {
                <div class="gx-m-alert"
                     role="button"
                     tabindex="0"
                     @onclick="() => OnOpenSection.InvokeAsync(alert.Href)"
                     aria-label="@($"{alert.Title}, {alert.Detail}")">
                    <span class="ic" style="@DashboardFilters.AlertIconStyle(alert.Tone)">
                        <GxIcon Name="@alert.Icon" Size="18"/>
                    </span>
                    <div class="main">
                        <div class="t">@alert.Title</div>
                        <div class="d">@alert.Detail</div>
                    </div>
                    <span class="chev">
                        <GxIcon Name="@GxIconPaths.ChevronRight" Size="18"/>
                    </span>
                </div>
            }
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public DashboardDto Dashboard { get; set; } = DashboardDto.Empty;
    [Parameter, EditorRequired] public SchoolCalendarDto Calendar { get; set; } = SchoolCalendarDto.Unavailable("—");
    [Parameter, EditorRequired] public bool IsLoaded { get; set; }
    [Parameter, EditorRequired] public string GreetingName { get; set; } = string.Empty;

    [Parameter] public EventCallback<DateOnly> OnOpenDay { get; set; }
    [Parameter] public EventCallback OnOpenPlanning { get; set; }
    [Parameter] public EventCallback<string> OnOpenSection { get; set; }

    private IReadOnlyList<DashboardAlert> _alerts = [];

    private ElementReference _strip;
    private IJSObjectReference? _module;

    /// <summary>Which week has already been centred, so the user's own scrolling is left alone.</summary>
    private DateOnly? _centredWeek;

    protected override void OnParametersSet() =>
        _alerts = DashboardFilters.Alerts(Dashboard.Alerts);

    /// <summary>
    /// Scrolls today into the middle of the strip, as the mobile mockup does.
    /// Only once per week shown: re-centring on every render would drag the
    /// strip back while somebody is scrolling it.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!IsLoaded || _centredWeek == Dashboard.WeekStart)
        {
            return;
        }

        _centredWeek = Dashboard.WeekStart;

        _module ??= await JS.InvokeAsync<IJSObjectReference>(
            "import", "./Components/Features/Dashboard/AccueilMobile.razor.js");

        await _module.InvokeVoidAsync(
            "centerToday",
            _strip,
            Dashboard.Week.Select((day, index) => (day, index))
                .FirstOrDefault(entry => entry.day.IsToday, (null!, -1)).index);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit went before the module did; nothing left to release.
            }
        }
    }

    private static string AriaFor(DashboardDayDto day, SchoolDayMarkDto? mark)
    {
        var label = $"{PlanningFilters.LongDayLabel(day.Date)}, {GxFormats.Plural(day.SessionCount, "cours", "cours")}";

        return mark is null ? label : $"{label}, {mark.Label}";
    }
}
