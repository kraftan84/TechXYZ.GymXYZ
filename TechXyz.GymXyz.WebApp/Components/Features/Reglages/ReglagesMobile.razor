@namespace TechXyz.GymXyz.WebApp.Components.Features.Reglages

@* Mobile Réglages: a list of sections that opens one sub-panel at a time, as
   the prototype's phone screen does — not the desktop tab strip shrunk down.

   The sub-panels read rather than edit, again following the prototype: typing an
   address or a SIRET on a phone is not what this screen is for, and the two
   things somebody does reach for on a phone — the payment switches and the
   notification switches — are live here. The rest says what it is and where to
   change it.

   The Équipe sub-panel keeps its two segments through GxMobileTabs. *@

<div class="gx-m-screen">
    @if (Panel is null)
    {
        <div class="gx-m-greet">
            <div class="hi">Réglages</div>
            <div class="sub">Identité, équipe, formules et notifications.</div>
        </div>

        <div class="gx-m-sec"><span class="t">Configuration</span></div>
        <div class="gx-m-card">
            @foreach (var section in Sections)
            {
                <button class="gx-m-setrow" @onclick="() => OnOpenPanel.InvokeAsync(section)">
                    <span class="si"><GxIcon Name="@ReglagesDesktop.Icon(section)" Size="18"/></span>
                    <span class="main">
                        <span class="t">@ReglagesDesktop.Title(section)</span>
                        <span class="d">@Caption(section)</span>
                    </span>
                    <span class="chev"><GxIcon Name="@GxIconPaths.ChevronRight" Size="18"/></span>
                </button>
            }
        </div>
    }
    else if (Panel == ReglagesSection.Identite)
    {
        <div class="gx-m-sec"><span class="t">Identité de la salle</span></div>
        <div class="gx-m-card">
            @if (Settings.Identity.WorksFromAnArea)
            {
                <div class="gx-m-kv">
                    <span class="k">Zone</span>
                    <span class="v">@Settings.Identity.AreaLabel</span>
                </div>
            }
            else
            {
                <div class="gx-m-kv">
                    <span class="k">Adresse</span>
                    <span class="v">@(Settings.Identity.Street ?? "—")</span>
                </div>
                <div class="gx-m-kv">
                    <span class="k">Ville</span>
                    <span class="v">@($"{Settings.Identity.ZipCode} {Settings.Identity.City}".Trim())</span>
                </div>
            }
            <div class="gx-m-kv">
                <span class="k">Téléphone</span>
                <span class="v">@(Settings.Identity.Phone ?? "—")</span>
            </div>
            <div class="gx-m-kv">
                <span class="k">E-mail</span>
                <span class="v" style="font-size:var(--text-xs)">@(Settings.Identity.Email ?? "—")</span>
            </div>
            <div class="gx-m-kv">
                <span class="k">SIRET</span>
                <span class="v">@(Settings.Identity.Siret ?? "—")</span>
            </div>
        </div>

        <div class="gx-m-sec"><span class="t">Horaires d'ouverture</span></div>
        <div class="gx-m-card">
            @if (Settings.OpeningHours.Count == 0)
            {
                <div class="gx-m-kv"><span class="v">Non renseignés</span></div>
            }
            else
            {
                @foreach (var hours in Settings.OpeningHours)
                {
                    <div class="gx-m-kv">
                        <span class="k" style="text-transform:none;letter-spacing:0;font-size:var(--text-sm);color:var(--text-strong)">
                            @SettingsLabels.DayRange(hours.DayFrom, hours.DayTo)
                        </span>
                        <span class="v" style="font-variant-numeric:tabular-nums">
                            @SettingsLabels.HoursRange(hours.OpensAt, hours.ClosesAt)
                        </span>
                    </div>
                }
            }
        </div>

        <div class="gx-m-note" style="margin-top:10px">
            L'identité se modifie depuis un écran plus large.
        </div>
    }
    else if (Panel == ReglagesSection.Equipe)
    {
        <GxMobileTabs TValue="EquipePanel.TeamScope"
                      Tabs="_teamTabs"
                      Selected="TeamScope"
                      OnSelect="OnSelectTeamScope"/>

        @if (TeamScope == EquipePanel.TeamScope.Gestion)
        {
            <div class="gx-m-card" style="margin-top:12px">
                @foreach (var person in Settings.Team.Team)
                {
                    <div class="gx-m-row" style="cursor:default">
                        <GxAvatar Name="@person.DisplayName" Size="md"/>
                        <div class="main">
                            <div class="nm">@person.DisplayName</div>
                            <div class="meta">
                                @person.AccessScope · @SettingsLabels.LastSeen(person.LastSeenAt, Now)
                            </div>
                        </div>
                        <div class="trail">
                            <GxChip Tone="@SettingsLabels.RoleTone(person.Role)">
                                @SettingsLabels.RoleLabel(person.Role)
                            </GxChip>
                        </div>
                    </div>
                }
            </div>

            @if (Settings.Team.Invitations.Count > 0)
            {
                <div class="gx-m-sec"><span class="t">Invitations en attente</span></div>
                <div class="gx-m-card">
                    @foreach (var invitation in Settings.Team.Invitations)
                    {
                        <div class="gx-m-row" style="cursor:default">
                            <span class="gx-m-ic t-warning" style="width:36px;height:36px">
                                <GxIcon Name="@GxIconPaths.Mail" Size="17"/>
                            </span>
                            <div class="main">
                                <div class="nm" style="font-size:var(--text-xs);font-weight:600">
                                    @invitation.Email
                                </div>
                                <div class="meta">
                                    @SettingsLabels.RoleLabel(invitation.RoleName) ·
                                    @SettingsLabels.LastSeen(invitation.SentOn, Now)
                                </div>
                            </div>
                            <div class="trail"><GxChip Tone="GxTone.Warning">Envoyée</GxChip></div>
                        </div>
                    }
                </div>
            }
        }
        else
        {
            <div class="gx-m-kpis" style="margin-top:12px">
                <div class="gx-m-kpi">
                    <div class="lab">Comptes actifs</div>
                    <div class="val">@GxFormats.Count(Settings.Team.MemberAccess.WithAccount)</div>
                    <div class="sub">sur @Settings.Team.MemberAccess.Total membres</div>
                </div>
                <div class="gx-m-kpi">
                    <div class="lab">En attente</div>
                    <div class="val">@GxFormats.Count(Settings.Team.MemberAccess.Invited)</div>
                    <div class="sub">@Settings.Team.MemberAccess.WithoutAccess sans accès</div>
                </div>
            </div>

            <div class="gx-m-card" style="margin-top:12px">
                @foreach (var account in Settings.Team.MemberAccounts)
                {
                    <div class="gx-m-row" style="cursor:default">
                        <GxAvatar Name="@account.FullName" Size="md"/>
                        <div class="main">
                            <div class="nm">@account.FullName</div>
                            <div class="meta">@(account.PlanName ?? account.Email)</div>
                        </div>
                        <div class="trail">
                            <GxChip Tone="@SettingsLabels.Tone(account.State)">
                                @SettingsLabels.Label(account.State)
                            </GxChip>
                        </div>
                    </div>
                }
            </div>
        }
    }
    else if (Panel == ReglagesSection.Tarifs)
    {
        <div class="gx-m-sec"><span class="t">Formules d'abonnement</span></div>
        <div class="gx-m-card">
            @foreach (var plan in Plans)
            {
                <div class="gx-m-row" style="cursor:default">
                    <span class="gx-m-ic t-@(plan.IsFeatured ? "brand" : "neutral")" style="width:38px;height:38px">
                        <GxIcon Name="@GxIconPaths.Card" Size="18"/>
                    </span>
                    <div class="main">
                        <div class="nm">@plan.Name</div>
                        <div class="meta">@plan.BillingLabel</div>
                    </div>
                    <div class="trail">
                        <span class="amt">
                            @GxFormats.Number(plan.Price)
                            <span style="font-size:var(--text-2xs);color:var(--text-muted);font-weight:600">
                                @plan.Unit
                            </span>
                        </span>
                    </div>
                </div>
            }
        </div>

        <div class="gx-m-sec"><span class="t">Paiement & facturation</span></div>
        <div class="gx-m-card">
            <div class="gx-m-kv">
                <span class="k">Devise</span>
                <span class="v">@SettingsLabels.CurrencyLabel(PaymentsForm.Currency)</span>
            </div>
            <div class="gx-m-kv">
                <span class="k" style="flex:none">TVA</span>
                <span class="v" style="font-size:var(--text-2xs);max-width:64%">
                    @(PaymentsForm.VatMention ?? "—")
                </span>
            </div>
        </div>

        <div class="gx-m-sec"><span class="t">Moyens de paiement</span></div>
        <div class="gx-m-card">
            @foreach (var method in SettingsLabels.PaymentMethods)
            {
                <div class="gx-m-flex" style="padding:13px 16px;border-bottom:1px solid var(--border-subtle)">
                    <span class="gx-m-grow" style="font-size:var(--text-sm);font-weight:600;color:var(--text-strong)">
                        @SubscriptionLabels.Label(method)
                    </span>
                    <FluentSwitch Value="PaymentsForm.Accepts(method)"
                                  ValueChanged="@(accepted => ToggleMethodAsync(method, accepted))"
                                  TValue="bool"/>
                </div>
            }
        </div>

        <SaveBar IsDirty="IsDirty" IsSaved="IsSaved"
                 UpToDateNote="Les moyens de paiement sont à jour."
                 OnSave="OnSave" OnCancel="OnCancel"/>
    }
    else
    {
        <div class="gx-m-note" style="margin:10px 0">@SettingsLabels.SmsPending</div>

        @foreach (var group in Groups)
        {
            var rows = NotificationForms.Where(form => form.Group == group).ToList();

            @if (rows.Count > 0)
            {
                <div class="gx-m-sec"><span class="t">@SettingsLabels.Title(group)</span></div>
                <div class="gx-m-card">
                    @foreach (var row in rows)
                    {
                        <div class="gx-m-notif">
                            <div class="main">
                                <div class="t">@SettingsLabels.Title(row.Key)</div>
                                <div class="d">@SettingsLabels.Description(row.Key)</div>
                                <div class="gx-m-chan">
                                    @if (row.UsesEmail)
                                    {
                                        <span class="c">Email</span>
                                    }
                                    @if (row.UsesSms)
                                    {
                                        <span class="c">SMS</span>
                                    }
                                </div>
                            </div>
                            <div style="flex:none;padding-top:2px">
                                <FluentSwitch Value="row.IsEnabled"
                                              ValueChanged="@(enabled => ToggleNotificationAsync(row, enabled))"
                                              TValue="bool"/>
                            </div>
                        </div>
                    }
                </div>
            }
        }

        <SaveBar IsDirty="IsDirty" IsSaved="IsSaved"
                 UpToDateNote="Les notifications sont à jour."
                 OnSave="OnSave" OnCancel="OnCancel"/>
    }
</div>

@code {
    private static readonly ReglagesSection[] Sections =
    [
        ReglagesSection.Identite,
        ReglagesSection.Equipe,
        ReglagesSection.Tarifs,
        ReglagesSection.Notifications
    ];

    private static readonly NotificationGroup[] Groups =
    [
        NotificationGroup.MembersAndSubscriptions,
        NotificationGroup.CoursesAndAttendance
    ];

    private readonly (EquipePanel.TeamScope Value, string Label)[] _teamTabs =
    [
        (EquipePanel.TeamScope.Gestion, "Équipe"),
        (EquipePanel.TeamScope.Membres, "Membres")
    ];

    [Parameter, EditorRequired] public GymSettingsPageDto Settings { get; set; } = GymSettingsPageDto.Empty;

    /// <summary>Null on the root list; a section when one is open.</summary>
    [Parameter] public ReglagesSection? Panel { get; set; }

    [Parameter] public PaymentsForm PaymentsForm { get; set; } = new();
    [Parameter] public List<NotificationForm> NotificationForms { get; set; } = [];
    [Parameter] public IReadOnlyList<PlanDto> Plans { get; set; } = [];
    [Parameter] public EquipePanel.TeamScope TeamScope { get; set; }
    [Parameter] public DateTime Now { get; set; } = DateTime.UtcNow;

    [Parameter] public bool IsDirty { get; set; }
    [Parameter] public bool IsSaved { get; set; }

    [Parameter] public EventCallback<ReglagesSection> OnOpenPanel { get; set; }
    [Parameter] public EventCallback<EquipePanel.TeamScope> OnSelectTeamScope { get; set; }
    [Parameter] public EventCallback OnSave { get; set; }
    [Parameter] public EventCallback OnCancel { get; set; }
    [Parameter] public EventCallback OnTouch { get; set; }

    private string Caption(ReglagesSection section) => section switch
    {
        ReglagesSection.Identite => Settings.Identity.WorksFromAnArea
            ? Settings.Identity.AreaLabel ?? "—"
            : string.Join(" · ", new[] { Settings.Identity.Street, Settings.Identity.City }
                .Where(part => !string.IsNullOrWhiteSpace(part))),
        ReglagesSection.Equipe =>
            $"{Settings.Team.Team.Count} dans l'équipe · {Settings.Team.MemberAccess.WithAccount} comptes membres",
        ReglagesSection.Tarifs =>
            $"{Plans.Count} formules · {SettingsLabels.CurrencyLabel(PaymentsForm.Currency)}",
        _ => "Relances, rappels, alertes"
    };

    private async Task ToggleMethodAsync(PaymentMethod method, bool accepted)
    {
        PaymentsForm.Toggle(method, accepted);
        await OnTouch.InvokeAsync();
    }

    private async Task ToggleNotificationAsync(NotificationForm row, bool enabled)
    {
        row.IsEnabled = enabled;

        if (enabled && row.Channels == NotificationChannels.None)
        {
            row.UsesEmail = true;
        }

        await OnTouch.InvokeAsync();
    }
}
