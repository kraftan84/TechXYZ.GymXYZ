@inject ITenantResolver TenantResolver

<!DOCTYPE html>
@* The theme is rendered server-side: no flash of the wrong brand on load. *@
<html lang="fr-FR" data-theme="@ThemeKey">

<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <base href="/"/>
    <ResourcePreloader/>
    <link rel="stylesheet" href="_content/Microsoft.FluentUI.AspNetCore.Components/css/reboot.css"/>
    @* TechXYZ tokens first, then the brand layer, then the app. Order matters. *@
    <link rel="stylesheet" href="@Assets["css/techxyz/styles.css"]"/>
    <link rel="stylesheet" href="@Assets["css/themes.css"]"/>
    <link rel="stylesheet" href="@Assets["css/app.css"]"/>
    <link rel="stylesheet" href="@Assets["css/mobile.css"]"/>
    <link rel="stylesheet" href="@Assets["css/gx-extras.css"]"/>
    @* The entry screens. Their own stylesheet because the split panel carries a
       brand token set nothing else uses — and because Leyssa's panel is light,
       which no app surface is. *@
    <link rel="stylesheet" href="@Assets["css/auth.css"]"/>
    @* The published image. Its own stylesheet because gx-poster.js carries
       exactly these rules into the SVG it rasterises — and nothing else. Found
       by the marker rather than by its file name: MapStaticAssets fingerprints
       the URL, so the name on the href is not the name on disk. *@
    <link rel="stylesheet" href="@Assets["css/poster.css"]" data-gx-poster/>
    @* Loaded after the Fluent stylesheets so the brand tokens win. *@
    <link rel="stylesheet" href="@Assets["css/fluent-bridge.css"]"/>
    <link rel="stylesheet" href="@Assets["TechXyz.GymXyz.WebApp.styles.css"]"/>
    <ImportMap/>
    <link rel="icon" type="image/png" href="favicon.png"/>
    <HeadOutlet/>
</head>

<body>
<Routes @rendermode="RenderModeForPage"/>
<ReconnectModal/>
<script src="_content/Microsoft.FluentUI.AspNetCore.Components/Microsoft.FluentUI.AspNetCore.Components.lib.module.js" type="module" async></script>
<script src="@Assets["_framework/blazor.web.js"]"></script>
@* The eye and the strength gauge on the entry screens. A classic script, not a
   module: those pages render statically — signing in writes a cookie, which a
   circuit cannot — so there is no interop to call it from. *@
<script src="@Assets["js/gx-auth.js"]"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string ThemeKey { get; set; } = "techxyz";

    /// <summary>
    /// Account pages stay on static server rendering: signing in and out needs a
    /// real HTTP response, which a circuit cannot produce.
    /// </summary>
    private IComponentRenderMode? RenderModeForPage =>
        HttpContext?.Request.Path.StartsWithSegments("/account") == true
            ? null
            : RenderMode.InteractiveServer;

    protected override async Task OnInitializedAsync()
    {
        var brand = await TenantResolver.ResolveAsync(HttpContext?.User);

        if (brand is not null)
        {
            ThemeKey = brand.ThemeKey;
        }
    }
}
