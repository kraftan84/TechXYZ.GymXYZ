@inherits LayoutComponentBase
@inject IDialogService DialogService

<div class="app-shell @(isNavOpen ? "nav-open" : "nav-closed")">
    <header class="top-bar">
        <div class="top-bar-left">
            <FluentButton Appearance="Appearance.Stealth"
                          class="icon-button nav-toggle"
                          title="Menu"
                          aria-label="Menu"
                          aria-expanded="@isNavOpen"
                          aria-controls="primary-nav"
                          @onclick="ToggleNav">
                <span class="icon-menu" aria-hidden="true"></span>
            </FluentButton>
            <div class="app-brand">
                <span class="app-logo" aria-hidden="true">GX</span>
                <span class="app-name">GymXYZ</span>
            </div>
        </div>
        <div class="top-bar-actions">
            <FluentButton Appearance="Appearance.Stealth"
                          class="icon-button"
                          title="Notifications"
                          @onclick="OpenNotificationsAsync">
                <span class="icon-bell" aria-hidden="true"></span>
                @if (notificationCount > 0)
                {
                    <span class="notification-badge" aria-label="@($"{notificationCount} notifications")">
                        @notificationCount
                    </span>
                }
            </FluentButton>
            <span class="user-name">Alex Johnson</span>
            <FluentProfileMenu FullName="Alex Johnson"
                               EMail="alex.johnson@example.com"
                               Image="images/avatar-placeholder.svg"/>
        </div>
    </header>
    <div class="app-body">
        <aside class="app-nav" id="primary-nav">
            <NavMenu/>
        </aside>
        <main class="app-content">
            @Body
        </main>
    </div>
    @if (isNavOpen)
    {
        <button class="nav-scrim" aria-hidden="true" tabindex="-1" @onclick="ToggleNav"></button>
    }
</div>

<FluentToastProvider/>
<FluentDialogProvider/>
<FluentTooltipProvider/>
<FluentMessageBarProvider/>
<FluentMenuProvider/>

<div id="blazor-error-ui" data-nosnippet>
    Une erreur non gérée s'est produite.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">X</span>
</div>

@code {
    private bool isNavOpen;
    private int notificationCount = 3;

    private async Task OpenNotificationsAsync()
    {
        var parameters = new DialogParameters
        {
            Title = "Notifications",
            DialogType = DialogType.Panel,
            Alignment = HorizontalAlignment.Right,
            Width = "360px",
            PreventScroll = true,
            ShowDismiss = true
        };

        await DialogService.ShowPanelAsync<NotificationsPanel>(parameters);
    }

    private void ToggleNav()
    {
        isNavOpen = !isNavOpen;
    }
}
