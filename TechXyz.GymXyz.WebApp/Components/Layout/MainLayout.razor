@* One app, two breakpoints. The same page renders inside the desktop shell or
   the mobile one — the business logic above it never knows which. *@

@inherits LayoutComponentBase
@implements IAsyncDisposable

@using TechXyz.GymXyz.WebApp.Components.Layout.Mobile

@inject ResponsiveModeService Responsive
@inject MobileHeaderService MobileHeader_
@inject NavBadgeService Badge
@inject IJSRuntime JsRuntime
@inject PersistentComponentState ApplicationState
@inject IHttpContextAccessor HttpContextAccessor

<div class="gx-root">
    @if (Brand is null)
    {
        <div class="gx-empty">
            <h3>Espace introuvable</h3>
            <p>Cette adresse ne correspond à aucun client GymXYZ.</p>
        </div>
    }
    else if (Responsive.IsMobile)
    {
        <div class="gx-m-app">
            @* Above the header rather than inside the body: it has to stay put
               while a sub-screen swaps the header out under it. *@
            <ImpersonationBar CustomerName="@ImpersonatedCustomer"/>

            @* A record or a detail screen asks for the back-arrow header; every
               root screen keeps the brand one. *@
            <MobileHeader Brand="Brand"
                          Mode="@(MobileHeader_.IsSubScreen ? MobileHeaderMode.Sub : MobileHeaderMode.Brand)"
                          Title="@MobileHeader_.Title"
                          OnBack="@(() => MobileHeader_.Back?.Invoke())">
                <Action>
                    <div class="gx-m-flex" style="gap:8px">
                        <button type="button" class="gx-m-iconbtn" aria-label="Notifications">
                            <GxIcon Name="@GxIconPaths.Bell" Size="20"/>
                            <span class="dot"></span>
                        </button>
                        <button type="button" class="gx-m-iconbtn" aria-label="Profil & plus"
                                style="padding:0;overflow:hidden" @onclick="OpenPlus">
                            <GxAvatar Name="@User.DisplayName" Size="sm"/>
                        </button>
                    </div>
                </Action>
            </MobileHeader>

            <main class="gx-m-body">
                <ErrorBoundary>
                    @Body
                </ErrorBoundary>
            </main>

            <MobileTabBar PlusActive="_plusOpen" OnPlus="TogglePlus" SheetsToPoint="Badge.SheetsToPoint"/>

            @if (_plusOpen)
            {
                <MobilePlusSheet Brand="Brand" User="User" OnClose="ClosePlus"/>
            }
        </div>
    }
    else
    {
        <div class="gx-app">
            <Sidebar Brand="Brand"
                     SheetsToPoint="Badge.SheetsToPoint"
                     SubscriptionsToWatch="Badge.SubscriptionsToWatch"/>
            <div class="gx-main">
                <ImpersonationBar CustomerName="@ImpersonatedCustomer"/>
                <Topbar Brand="Brand" User="User"/>
                <main class="gx-content">
                    <div class="gx-wrap">
                        <ErrorBoundary>
                            @Body
                        </ErrorBoundary>
                    </div>
                </main>
            </div>
        </div>
    }
</div>

<FluentToastProvider/>
<FluentDialogProvider/>
<FluentTooltipProvider/>
<FluentMessageBarProvider/>
<FluentMenuProvider/>

<div id="blazor-error-ui" data-nosnippet>
    Une erreur non gérée s'est produite.
    <a href="." class="reload">Recharger</a>
    <span class="dismiss">X</span>
</div>

@code {
    private const string DeviceModeStateKey = "gx-device-mode";

    [CascadingParameter] private TenantBrandDto? Brand { get; set; }
    [CascadingParameter] private GymUserInfo User { get; set; } = GymUserInfo.Anonymous;

    /// <summary>
    /// Customer on screen while a platform admin is visiting, null otherwise —
    /// which is what keeps the bar off everybody else's screen.
    /// </summary>
    private string? ImpersonatedCustomer => User.IsImpersonating ? Brand?.DisplayName : null;

    private bool _plusOpen;
    private IJSObjectReference? _module;
    private DotNetObjectReference<MainLayout>? _selfReference;
    private int _watchId;
    private PersistingComponentStateSubscription _persistingSubscription;

    protected override void OnInitialized()
    {
        // The cookie is only readable while an HttpContext exists, so the
        // prerender pass hands the mode over to the circuit.
        if (ApplicationState.TryTakeFromJson<DeviceMode>(DeviceModeStateKey, out var restored))
        {
            Responsive.SeedFromCookie(restored == DeviceMode.Mobile ? "mobile" : "desktop");
        }
        else if (HttpContextAccessor.HttpContext?.Request.Cookies
                     .TryGetValue(ResponsiveModeService.CookieName, out var cookie) == true)
        {
            Responsive.SeedFromCookie(cookie);
        }

        _persistingSubscription = ApplicationState.RegisterOnPersisting(PersistDeviceMode);
        Responsive.Changed += OnResponsiveChanged;
        MobileHeader_.Changed += OnMobileHeaderChanged;
        Badge.Changed += OnBadgeChanged;
    }

    private Task PersistDeviceMode()
    {
        ApplicationState.PersistAsJson(DeviceModeStateKey, Responsive.Mode);

        return Task.CompletedTask;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JsRuntime.InvokeAsync<IJSObjectReference>("import", "./js/gx-responsive.js");
        _selfReference = DotNetObjectReference.Create(this);
        _watchId = await _module.InvokeAsync<int>(
            "watch", _selfReference, ResponsiveModeService.MobileBreakpointPx);
    }

    [JSInvokable]
    public void OnViewportChanged(bool isMobile)
    {
        Responsive.SetMode(isMobile ? DeviceMode.Mobile : DeviceMode.Desktop);
    }

    private void OnResponsiveChanged()
    {
        _plusOpen = false;
        InvokeAsync(StateHasChanged);
    }

    private void OnMobileHeaderChanged() => InvokeAsync(StateHasChanged);

    private void OnBadgeChanged() => InvokeAsync(StateHasChanged);

    private void TogglePlus() => _plusOpen = !_plusOpen;

    private void OpenPlus() => _plusOpen = true;

    private void ClosePlus() => _plusOpen = false;

    public async ValueTask DisposeAsync()
    {
        Responsive.Changed -= OnResponsiveChanged;
        MobileHeader_.Changed -= OnMobileHeaderChanged;
        Badge.Changed -= OnBadgeChanged;
        _persistingSubscription.Dispose();

        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("unwatch", _watchId);
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone; nothing left to clean up.
            }
        }

        _selfReference?.Dispose();
    }
}
