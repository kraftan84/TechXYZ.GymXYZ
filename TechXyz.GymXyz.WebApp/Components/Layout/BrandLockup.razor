@* Brand mark + themed wordmark. The only place a customer's identity is read;
   every colour still comes from the theme tokens.

   A customer without a logo file shows its name alone. The mark element is not
   rendered at all in that case rather than left empty: .mark is a fixed 38px box
   with a 10px gap, so an empty span would indent the wordmark by 48px. *@

<div class="@(Mobile ? "gx-m-brand" : "gx-brand")">
    @if (MarkSource is not null)
    {
        <span class="mark @(Brand.CircleLogo ? "circle" : null)">
            <img src="@MarkSource" alt="@Brand.DisplayName"/>
        </span>
    }
    <span class="@(Mobile ? "gx-m-wordmark" : "gx-wordmark")">
        @if (!string.IsNullOrWhiteSpace(Brand.WordmarkText))
        {
            @Brand.WordmarkText
        }
        else
        {
            @Brand.WordmarkPrefix<span class="accent">@Brand.WordmarkAccent</span>
        }
    </span>
</div>

@code {
    [Parameter, EditorRequired] public TenantBrandDto Brand { get; set; } = default!;

    /// <summary>Picks the light-on-dark asset for dark sidebar themes.</summary>
    [Parameter] public bool OnDark { get; set; }

    [Parameter] public bool Mobile { get; set; }

    private string? MarkSource
    {
        get
        {
            var source = OnDark && !string.IsNullOrWhiteSpace(Brand.LogoDarkPath)
                ? Brand.LogoDarkPath
                : Brand.LogoPath;

            return string.IsNullOrWhiteSpace(source) ? null : source;
        }
    }
}
