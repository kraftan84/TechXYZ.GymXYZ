@* Desktop sidebar, 256px. Every colour comes from the --gx-sb-* contract, so a
   brand can turn it into a dark locker room without touching this file. *@

<aside class="gx-sb">
    <BrandLockup Brand="Brand" OnDark="true"/>

    @foreach (var group in GxNavigation.Groups)
    {
        var items = GxNavigation.Visible(group.Items, Viewer).ToList();
        if (items.Count == 0)
        {
            continue;
        }

        <div class="gx-sb-group">@group.Title</div>

        foreach (var item in items)
        {
            <NavLink class="gx-nav" href="@item.Href" ActiveClass="active"
                     Match="@(item.Href == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)"
                     aria-label="@LabelFor(item)">
                <GxIcon Name="@item.Icon" Size="19"/>
                <span>@item.Label</span>
                @* The same count the mobile tab badges, in the room the sidebar
                   has for it — plus the one the mobile shell has no tab for. *@
                @if (CountFor(item) is { } count)
                {
                    <GxChip Tone="@ToneFor(item)">@count</GxChip>
                }
            </NavLink>
        }
    }

    <div class="gx-sb-spacer"></div>

    @* Through the same filter as everything else. Rendered unconditionally until
       this lot, it offered every coach a link that answers "accès refusé". *@
    <div class="gx-sb-foot">
        @foreach (var item in GxNavigation.Visible([GxNavigation.Administration], Viewer))
        {
            <NavLink class="gx-nav" href="@item.Href" ActiveClass="active">
                <GxIcon Name="@item.Icon" Size="19"/>
                <span>@item.Label</span>
            </NavLink>
        }
    </div>
</aside>

@code {
    [Parameter, EditorRequired] public TenantBrandDto Brand { get; set; } = default!;

    /// <summary>The signed-in person, for the sections that are not everybody's.</summary>
    [CascadingParameter] public GymUserInfo User { get; set; } = GymUserInfo.Anonymous;

    /// <summary>
    /// HasCustomer is false for a platform admin outside every customer: the
    /// business sections disappear and only Administration is left in the footer.
    /// </summary>
    private GxNavViewer Viewer => new(
        IsSolo: Brand.IsSolo,
        HasCustomer: !ConsoleBrand.IsConsole(Brand),
        IsManager: User.IsManager,
        IsPlatformAdmin: User.IsPlatformAdmin);

    /// <summary>Sheets waiting to be pointed, or null for no chip at all.</summary>
    [Parameter] public int? SheetsToPoint { get; set; }

    /// <summary>Covers expiring or late — <c>03-SCREENS-DESKTOP.md</c> draws it as « badge 6 ».</summary>
    [Parameter] public int? SubscriptionsToWatch { get; set; }

    private int? CountFor(GxNavItem item) =>
        item.Id == GxNavigation.Presences.Id ? SheetsToPoint
        : item.Id == GxNavigation.Abonnements.Id ? SubscriptionsToWatch
        : null;

    /// <summary>
    /// Sheets are overdue work, covers are work coming — the tones say which is
    /// which rather than making both shout.
    /// </summary>
    private static GxTone ToneFor(GxNavItem item) =>
        item.Id == GxNavigation.Presences.Id ? GxTone.Danger : GxTone.Warning;

    private string LabelFor(GxNavItem item) => CountFor(item) is not { } count
        ? item.Label
        : item.Id == GxNavigation.Presences.Id
            ? $"{item.Label}, {GxFormats.Plural(count, "séance à pointer", "séances à pointer")}"
            : $"{item.Label}, {GxFormats.Plural(count, "abonnement à surveiller", "abonnements à surveiller")}";
}
