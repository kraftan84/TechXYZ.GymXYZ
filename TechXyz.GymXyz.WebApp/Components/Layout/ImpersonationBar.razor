@* Shown on every screen while a platform admin is inside a customer.

   Permanent and not dismissible on purpose: the whole risk of impersonation is
   an admin forgetting whose data is on screen and writing into it. A banner
   that can be closed is a banner that will be. *@

@if (CustomerName is not null)
{
    <div class="gx-impersonation" role="status">
        <GxIcon Name="@GxIconPaths.Shield" Size="16"/>
        <span class="gx-impersonation-text">
            Vous consultez <b>@CustomerName</b> depuis la console TechXYZ.
        </span>
        <a class="gx-impersonation-exit" href="/account/client/sortie">Quitter</a>
    </div>
}

@code {
    /// <summary>Customer being visited, or null when nobody is impersonating.</summary>
    [Parameter] public string? CustomerName { get; set; }
}
