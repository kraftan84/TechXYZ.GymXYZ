@* Desktop topbar, 64px.

   There is no search field. One was drawn here from lot 0 — inert, aria-hidden,
   no input behind it — as a placeholder for a global search that was never
   built. A control that looks like a control and answers nothing is worse than
   its absence: it gets clicked. It comes back with something behind it.

   There is no bell either, and for the same reason. Nothing stores a
   notification, so it had nothing to announce, and its red dot was hard-coded
   on: a permanent alert teaches people to stop reading alerts. *@

<header class="gx-tb">
    <div class="gx-tb-sp"></div>
    @* Réglages has no sidebar entry on desktop — this gear is the whole of it,
       which is why it goes through the same filter rather than being hidden by
       hand. *@
    @foreach (var item in GxNavigation.Visible([GxNavigation.Reglages], Viewer))
    {
        <NavLink class="gx-tb-ic" href="@item.Href" ActiveClass="on" title="@item.Label">
            <GxIcon Name="@item.Icon" Size="20"/>
        </NavLink>
    }
    <span class="gx-tb-div"></span>
    <div class="gx-me">
        <GxAvatar Name="@User.DisplayName" Size="sm"/>
        <div>
            <div class="nm">@User.DisplayName</div>
            <div class="rl">@RoleLine</div>
        </div>
    </div>
</header>

@code {
    [Parameter, EditorRequired] public TenantBrandDto Brand { get; set; } = default!;
    [Parameter, EditorRequired] public GymUserInfo User { get; set; } = default!;

    private GxNavViewer Viewer => new(
        IsSolo: Brand.IsSolo,
        HasCustomer: !ConsoleBrand.IsConsole(Brand),
        IsManager: User.IsManager,
        IsPlatformAdmin: User.IsPlatformAdmin);

    private string RoleLine => string.IsNullOrWhiteSpace(User.RoleLabel)
        ? Brand.DisplayName
        : $"{User.RoleLabel} · {Brand.DisplayName}";
}
