@namespace TechXyz.GymXyz.WebApp.Components.Shared

<button class="drawer-scrim" type="button" aria-hidden="true" @onclick="OnClose"></button>
<aside class="@DrawerClass" role="dialog" aria-modal="true" aria-labelledby="@TitleId">
    <div class="drawer-header">
        <h2 id="@TitleId">@Title</h2>
        <FluentButton Appearance="Appearance.Stealth"
                      IconEnd="@(new Icons.Regular.Size20.Dismiss())"
                      Title="Fermer"
                      aria-label="Fermer"
                      @onclick="OnClose" />
    </div>
    @ChildContent
    @if (FooterContent is not null)
    {
        <div class="drawer-footer">
            @FooterContent
        </div>
    }
</aside>

@code {
    [Parameter]
    public string DrawerClass { get; set; } = "drawer";

    [Parameter]
    public string Title { get; set; } = string.Empty;

    [Parameter]
    public string TitleId { get; set; } = "drawer-title";

    [Parameter]
    public EventCallback OnClose { get; set; }

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? FooterContent { get; set; }
}
