@* Line icon on a 24 grid, stroke inherits currentColor. *@

<svg width="@Size" height="@Size" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="1.8" stroke-linecap="round"
     stroke-linejoin="round" style="flex:none" aria-hidden="true" focusable="false"
     class="@Class" slot="@Slot">
    @((MarkupString)GxIconPaths.Get(Name))
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = string.Empty;

    /// <summary>16 for meta, 20 for buttons and fields, 24 for navigation.</summary>
    [Parameter] public int Size { get; set; } = 18;

    [Parameter] public string? Class { get; set; }

    /// <summary>
    /// Shadow-DOM slot to land in. Inside a Fluent button that also carries a
    /// label, this must be <c>start</c>: left in the default slot, the button
    /// reads itself as icon-only and sizes itself to the icon, so the label
    /// spills out. Leave unset for an icon-only button — there the default slot
    /// is what makes the square shape correct.
    /// </summary>
    [Parameter] public string? Slot { get; set; }
}
