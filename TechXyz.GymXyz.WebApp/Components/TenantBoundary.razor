@* Fills the ambient tenant once per scope — HTTP request or Blazor circuit —
   and cascades the brand and the signed-in person to the whole app.

   The tenant comes from the signed-in user's claim, which is signed inside the
   authentication cookie; the host is only used before authentication, to dress
   the login screen in the right colours. *@

@using TechXyz.GymXyz.Application.Common
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject ITenantResolver TenantResolver
@inject TenantContext TenantContext
@inject CurrentUserService CurrentUserService

@if (_ready)
{
    <CascadingValue Value="_brand" IsFixed="true">
        <CascadingValue Value="_user" IsFixed="true">
            @ChildContent
        </CascadingValue>
    </CascadingValue>
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private TenantBrandDto? _brand;
    private GymUserInfo _user = GymUserInfo.Anonymous;
    private bool _ready;

    protected override async Task OnInitializedAsync()
    {
        var authenticationState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var principal = authenticationState.User;

        _brand = await TenantResolver.ResolveAsync(principal);

        // Signed in and belonging to no customer: the console, not a broken
        // address. The shell needs an identity to paint, and it gets the
        // platform's own — with tenant 0 behind it, so the global filter lets
        // no business row through while the admin is outside every customer.
        if (_brand is null && principal.Identity?.IsAuthenticated == true)
        {
            _brand = ConsoleBrand.Instance;
        }

        TenantContext.SetTenant(_brand?.Id ?? 0, _brand?.Slug);

        // No HttpContext inside a circuit: carry the user across explicitly so
        // audit stamping keeps naming a person instead of "system", and so a
        // handler reserving an action to a role still sees that role.
        CurrentUserService.SetCircuitUser(principal);

        _user = BuildUserInfo(principal);
        _ready = true;
    }

    private static GymUserInfo BuildUserInfo(ClaimsPrincipal principal)
    {
        if (principal.Identity?.IsAuthenticated != true)
        {
            return GymUserInfo.Anonymous;
        }

        var displayName = principal.FindFirstValue(ClaimTypes.GivenName)
                          ?? principal.Identity.Name
                          ?? GymUserInfo.Anonymous.DisplayName;

        var isPlatformAdmin = principal.IsInRole(GymRoleNames.PlatformAdmin);

        return new GymUserInfo(
            displayName,
            principal.FindFirstValue(GymClaimTypes.Nickname),
            principal.FindFirstValue(GymClaimTypes.RoleLabel))
        {
            // Read here rather than in each shell: the navigation, the topbar and
            // the mobile sheet all ask the same question, and asking it three
            // times is three chances to answer it differently.
            //
            // A platform admin is not a manager. They were, while they could
            // enter a customer; with the impersonation gone they inhabit no gym,
            // and saying they run one would show them a « Nouveau membre » button
            // on screens CustomerScope already refuses them.
            IsManager = principal.IsInRole(GymRoleNames.GymManager),
            IsPlatformAdmin = isPlatformAdmin
        };
    }
}
