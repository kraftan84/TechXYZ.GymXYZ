@page "/rooms"
@using FluentValidation
@using MediatR
@using TechXyz.GymXyz.Application.Commands
@using TechXyz.GymXyz.Application.Models
@using TechXyz.GymXyz.Application.Queries
@inject BreadcrumbService BreadcrumbService
@inject ISender Sender
@inject IUserFeedbackService UserFeedback

<PageTitle>Salles</PageTitle>

<div class="locations-page">
    <div class="locations-header">
        <div class="locations-title">
            <h1>Salles</h1>
            <p>Informations du gym, gestion des emplacements et des salles.</p>
        </div>
    </div>

    <FluentCard class="gym-card">
        <div class="gym-header">
            <div>
                <h2>@(locationsPage?.GymName ?? "Gym")</h2>
                <p>Gym principal</p>
            </div>
            <div class="gym-meta">
                <span>@sites.Count emplacement(s)</span>
                <span>@locations.Count salle(s)</span>
            </div>
        </div>
    </FluentCard>

    <div class="locations-layout">
        <FluentCard class="sites-card">
            <div class="sites-header">
                <h2>Emplacements</h2>
                <FluentButton Appearance="Appearance.Accent" @onclick="OpenSiteCreateDrawer">
                    Nouvel emplacement
                </FluentButton>
            </div>
            <div class="sites-list">
                @foreach (var site in sites)
                {
                    <button class="site-item"
                            type="button"
                            @onclick="() => OpenSiteDetailsDrawer(site)"
                            aria-label="@($"Voir {site.Name}")">
                        <div class="site-name">@site.Name</div>
                        <div class="site-meta">@FormatAddress(site.Address)</div>
                        <div class="site-meta">@($"{site.Locations.Count} salle(s)")</div>
                    </button>
                }
            </div>
        </FluentCard>

        <FluentCard class="locations-card">
            <div class="locations-card-header">
                <h2>Salles</h2>
                <FluentButton Appearance="Appearance.Accent" @onclick="OpenLocationCreateDrawer">
                    Nouvelle salle
                </FluentButton>
            </div>
            <div class="locations-table">
                <div class="locations-row locations-row-header">
                    <span class="locations-col">Salle</span>
                    <span class="locations-col">Emplacement</span>
                </div>
                @foreach (var location in locations)
                {
                    <button class="locations-row locations-row-item"
                            type="button"
                            @onclick="() => OpenLocationDetailsDrawer(location)"
                            aria-label="@($"Voir {location.Name}")">
                        <span class="locations-col">@location.Name</span>
                        <span class="locations-col">@location.SiteName</span>
                    </button>
                }
            </div>
        </FluentCard>
    </div>
</div>

@if (isDrawerOpen)
{
    <DrawerShell DrawerClass="location-drawer" Title="@drawerTitle" OnClose="CloseDrawer">
        <ChildContent>
            <div class="drawer-content">
                @if (drawerMode == DrawerMode.SiteDetails && selectedSite is not null)
                {
                    <div class="drawer-section">
                        <div class="drawer-field">
                            <span class="drawer-label">Nom</span>
                            <span class="drawer-value">@selectedSite.Name</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Adresse</span>
                            <span class="drawer-value">@FormatAddress(selectedSite.Address)</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Salles</span>
                            <span class="drawer-value">@($"{selectedSite.Locations.Count} salle(s)")</span>
                        </div>
                    </div>
                }
                else if (drawerMode == DrawerMode.SiteCreate || drawerMode == DrawerMode.SiteEdit)
                {
                    <div class="drawer-form">
                        <FluentTextField Label="Nom" @bind-Value="siteEditModel.Name" />
                        <FluentTextField Label="Adresse" @bind-Value="siteEditModel.Street" />
                        <FluentTextField Label="Code postal" @bind-Value="siteEditModel.ZipCode" />
                        <FluentTextField Label="Ville" @bind-Value="siteEditModel.City" />
                        <FluentTextField Label="Pays" @bind-Value="siteEditModel.Country" />
                    </div>
                }
                else if (drawerMode == DrawerMode.LocationDetails && selectedLocation is not null)
                {
                    <div class="drawer-section">
                        <div class="drawer-field">
                            <span class="drawer-label">Salle</span>
                            <span class="drawer-value">@selectedLocation.Name</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Emplacement</span>
                            <span class="drawer-value">@selectedLocation.SiteName</span>
                        </div>
                    </div>
                }
                else if (drawerMode == DrawerMode.LocationCreate || drawerMode == DrawerMode.LocationEdit)
                {
                    <div class="drawer-form">
                        <FluentTextField Label="Nom de la salle" @bind-Value="locationEditModel.Name" />
                        <div class="drawer-field">
                            <FluentSelect Label="Emplacement"
                                          TOption="string"
                                          Value="@locationEditModel.SiteId.ToString()"
                                          ValueChanged="OnLocationSiteChanged">
                                @foreach (var site in sites)
                                {
                                    <FluentOption TOption="string" Value="@site.Id.ToString()">@site.Name</FluentOption>
                                }
                            </FluentSelect>
                        </div>
                    </div>
                }
            </div>
        </ChildContent>
        <FooterContent>
            @if (drawerMode == DrawerMode.SiteDetails && selectedSite is not null)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="OpenSiteEditDrawer">
                        Editer
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="DeleteSiteAsync">
                        Supprimer
                    </FluentButton>
                </div>
            }
            else if (drawerMode == DrawerMode.SiteCreate || drawerMode == DrawerMode.SiteEdit)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="CancelEdit">Annuler</FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="SaveSiteAsync">
                        @(drawerMode == DrawerMode.SiteCreate ? "Creer l'emplacement" : "Enregistrer")
                    </FluentButton>
                </div>
            }
            else if (drawerMode == DrawerMode.LocationDetails && selectedLocation is not null)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="OpenLocationEditDrawer">
                        Editer
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="DeleteLocationAsync">
                        Supprimer
                    </FluentButton>
                </div>
            }
            else if (drawerMode == DrawerMode.LocationCreate || drawerMode == DrawerMode.LocationEdit)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="CancelEdit">Annuler</FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="SaveLocationAsync">
                        @(drawerMode == DrawerMode.LocationCreate ? "Creer la salle" : "Enregistrer")
                    </FluentButton>
                </div>
            }
        </FooterContent>
    </DrawerShell>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        BreadcrumbService.SetItems(
        [
            new BreadcrumbItem { IsHome = true, Href = "/" },
            new BreadcrumbItem { Text = "Salles" }
        ]);

        await RefreshLocationsPageAsync();
    }

    private SitesPageDto? locationsPage;

    private IReadOnlyList<SiteWithLocationsDto> sites => locationsPage?.Sites ?? new List<SiteWithLocationsDto>();
    private IReadOnlyList<LocationWithSiteDto> locations => locationsPage?.Locations ?? new List<LocationWithSiteDto>();

    private SiteWithLocationsDto? selectedSite;
    private LocationWithSiteDto? selectedLocation;
    private SiteEditModel siteEditModel = new();
    private LocationEditModel locationEditModel = new();
    private DrawerMode drawerMode = DrawerMode.None;
    private string drawerTitle = string.Empty;

    private bool isDrawerOpen => drawerMode != DrawerMode.None;

    private async Task RefreshLocationsPageAsync()
    {
        var loaded = false;
        await UserFeedback.ExecuteAsync(async () =>
        {
            locationsPage = await Sender.Send(new GetSitesPageQuery());
            loaded = true;
        }, "charger les salles");

        if (!loaded)
        {
            return;
        }

        if (selectedSite is not null)
        {
            selectedSite = sites.FirstOrDefault(site => site.Id == selectedSite.Id);
            if (selectedSite is null && drawerMode is DrawerMode.SiteDetails or DrawerMode.SiteEdit)
            {
                CloseDrawer();
                return;
            }
        }

        if (selectedLocation is not null)
        {
            selectedLocation = locations.FirstOrDefault(location => location.Id == selectedLocation.Id);
            if (selectedLocation is null && drawerMode is DrawerMode.LocationDetails or DrawerMode.LocationEdit)
            {
                CloseDrawer();
            }
        }
    }

    private void OpenSiteDetailsDrawer(SiteWithLocationsDto site)
    {
        selectedSite = site;
        selectedLocation = null;
        drawerMode = DrawerMode.SiteDetails;
        drawerTitle = "Details de l'emplacement";
    }

    private void OpenSiteCreateDrawer()
    {
        siteEditModel = new SiteEditModel();
        selectedSite = null;
        drawerMode = DrawerMode.SiteCreate;
        drawerTitle = "Nouvel emplacement";
    }

    private void OpenSiteEditDrawer()
    {
        if (selectedSite is null)
        {
            return;
        }

        siteEditModel = new SiteEditModel
        {
            Name = selectedSite.Name,
            Street = selectedSite.Address.Street,
            ZipCode = selectedSite.Address.ZipCode,
            City = selectedSite.Address.City,
            Country = selectedSite.Address.Country
        };

        drawerMode = DrawerMode.SiteEdit;
        drawerTitle = "Modifier l'emplacement";
    }

    private async Task SaveSiteAsync()
    {
        if (drawerMode == DrawerMode.SiteCreate)
        {
            var created = await UserFeedback.ExecuteAsync(async () =>
            {
                await Sender.Send(new CreateSiteCommand(
                    siteEditModel.Name,
                    siteEditModel.Street,
                    siteEditModel.ZipCode,
                    siteEditModel.City,
                    siteEditModel.Country));

                await RefreshLocationsPageAsync();
                CloseDrawer();
            }, "creer l'emplacement", "Emplacement cree.");

            if (!created)
            {
                return;
            }
        }

        if (drawerMode == DrawerMode.SiteEdit && selectedSite is not null)
        {
            await UserFeedback.ExecuteAsync(async () =>
            {
                var updated = await Sender.Send(new UpdateSiteCommand(
                    selectedSite.Id,
                    siteEditModel.Name,
                    siteEditModel.Street,
                    siteEditModel.ZipCode,
                    siteEditModel.City,
                    siteEditModel.Country));

                if (!updated)
                {
                    throw new ValidationException("Emplacement introuvable.");
                }

                await RefreshLocationsPageAsync();
                selectedSite = sites.FirstOrDefault(site => site.Id == selectedSite.Id);
                if (selectedSite is null)
                {
                    CloseDrawer();
                    return;
                }

                drawerMode = DrawerMode.SiteDetails;
                drawerTitle = "Details de l'emplacement";
            }, "mettre a jour l'emplacement", "Emplacement mis a jour.");
        }
    }

    private async Task DeleteSiteAsync()
    {
        if (selectedSite is null)
        {
            return;
        }

        await UserFeedback.ExecuteAsync(async () =>
        {
            var deleted = await Sender.Send(new DeleteSiteCommand(selectedSite.Id));
            if (!deleted)
            {
                throw new ValidationException("Emplacement introuvable.");
            }

            await RefreshLocationsPageAsync();
            CloseDrawer();
        }, "supprimer l'emplacement", "Emplacement supprime.");
    }

    private void OpenLocationDetailsDrawer(LocationWithSiteDto location)
    {
        selectedLocation = location;
        selectedSite = null;
        drawerMode = DrawerMode.LocationDetails;
        drawerTitle = "Details de la salle";
    }

    private void OpenLocationCreateDrawer()
    {
        if (sites.Count == 0)
        {
            return;
        }

        locationEditModel = new LocationEditModel
        {
            SiteId = sites[0].Id
        };
        selectedLocation = null;
        drawerMode = DrawerMode.LocationCreate;
        drawerTitle = "Nouvelle salle";
    }

    private void OpenLocationEditDrawer()
    {
        if (selectedLocation is null)
        {
            return;
        }

        locationEditModel = new LocationEditModel
        {
            Name = selectedLocation.Name,
            SiteId = selectedLocation.SiteId
        };

        drawerMode = DrawerMode.LocationEdit;
        drawerTitle = "Modifier la salle";
    }

    private async Task SaveLocationAsync()
    {
        if (drawerMode == DrawerMode.LocationCreate)
        {
            var created = await UserFeedback.ExecuteAsync(async () =>
            {
                await Sender.Send(new CreateLocationCommand(locationEditModel.Name, locationEditModel.SiteId));
                await RefreshLocationsPageAsync();
                CloseDrawer();
            }, "creer la salle", "Salle creee.");

            if (!created)
            {
                return;
            }
        }

        if (drawerMode == DrawerMode.LocationEdit && selectedLocation is not null)
        {
            await UserFeedback.ExecuteAsync(async () =>
            {
                var updated = await Sender.Send(new UpdateLocationCommand(selectedLocation.Id, locationEditModel.Name, locationEditModel.SiteId));
                if (!updated)
                {
                    throw new ValidationException("Salle ou emplacement introuvable.");
                }

                await RefreshLocationsPageAsync();
                selectedLocation = locations.FirstOrDefault(location => location.Id == selectedLocation.Id);
                if (selectedLocation is null)
                {
                    CloseDrawer();
                    return;
                }

                drawerMode = DrawerMode.LocationDetails;
                drawerTitle = "Details de la salle";
            }, "mettre a jour la salle", "Salle mise a jour.");
        }
    }

    private async Task DeleteLocationAsync()
    {
        if (selectedLocation is null)
        {
            return;
        }

        await UserFeedback.ExecuteAsync(async () =>
        {
            var deleted = await Sender.Send(new DeleteLocationCommand(selectedLocation.Id));
            if (!deleted)
            {
                throw new ValidationException("Salle introuvable.");
            }

            await RefreshLocationsPageAsync();
            CloseDrawer();
        }, "supprimer la salle", "Salle supprimee.");
    }

    private void CancelEdit()
    {
        if (drawerMode == DrawerMode.SiteEdit && selectedSite is not null)
        {
            drawerMode = DrawerMode.SiteDetails;
            drawerTitle = "Details de l'emplacement";
            return;
        }

        if (drawerMode == DrawerMode.LocationEdit && selectedLocation is not null)
        {
            drawerMode = DrawerMode.LocationDetails;
            drawerTitle = "Details de la salle";
            return;
        }

        CloseDrawer();
    }

    private void CloseDrawer()
    {
        drawerMode = DrawerMode.None;
        selectedSite = null;
        selectedLocation = null;
        drawerTitle = string.Empty;
    }

    private static string FormatAddress(AddressDto address)
    {
        var parts = new List<string> { address.Street, address.ZipCode, address.City, address.Country }
            .Where(value => !string.IsNullOrWhiteSpace(value));

        return string.Join(", ", parts);
    }

    private void OnLocationSiteChanged(string? value)
    {
        if (int.TryParse(value, out var id))
        {
            locationEditModel.SiteId = id;
        }
    }

    private enum DrawerMode
    {
        None,
        SiteDetails,
        SiteCreate,
        SiteEdit,
        LocationDetails,
        LocationCreate,
        LocationEdit
    }

    private sealed class SiteEditModel
    {
        public string Name { get; set; } = string.Empty;
        public string Street { get; set; } = string.Empty;
        public string ZipCode { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string Country { get; set; } = string.Empty;
    }

    private sealed class LocationEditModel
    {
        public string Name { get; set; } = string.Empty;
        public int SiteId { get; set; }
    }
}
