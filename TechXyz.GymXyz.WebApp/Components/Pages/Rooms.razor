@page "/rooms"
@using FluentValidation
@using MediatR
@using TechXyz.GymXyz.Application.Commands
@using TechXyz.GymXyz.Application.Models
@using TechXyz.GymXyz.Application.Queries
@inject BreadcrumbService BreadcrumbService
@inject ISender Sender
@inject IUserFeedbackService UserFeedback

<PageTitle>Salles</PageTitle>

<div class="rooms-page">
    <div class="rooms-header">
        <div class="rooms-title">
            <h1>Salles</h1>
            <p>Informations du gym, gestion des emplacements et des salles.</p>
        </div>
    </div>

    <FluentCard class="gym-card">
        <div class="gym-header">
            <div>
                <h2>@(roomsPage?.GymName ?? "Gym")</h2>
                <p>Gym principal</p>
            </div>
            <div class="gym-meta">
                <span>@sites.Count emplacement(s)</span>
                <span>@rooms.Count salle(s)</span>
            </div>
        </div>
    </FluentCard>

    <div class="rooms-layout">
        <FluentCard class="sites-card">
            <div class="sites-header">
                <h2>Emplacements</h2>
                <FluentButton Appearance="Appearance.Accent" @onclick="OpenSiteCreateDrawer">
                    Nouvel emplacement
                </FluentButton>
            </div>
            <div class="sites-list">
                @foreach (var site in sites)
                {
                    <button class="site-item"
                            type="button"
                            @onclick="() => OpenSiteDetailsDrawer(site)"
                            aria-label="@($"Voir {site.Name}")">
                        <div class="site-name">@site.Name</div>
                        <div class="site-meta">@FormatAddress(site.Address)</div>
                        <div class="site-meta">@($"{site.Rooms.Count} salle(s)")</div>
                    </button>
                }
            </div>
        </FluentCard>

        <FluentCard class="rooms-card">
            <div class="rooms-card-header">
                <h2>Salles</h2>
                <FluentButton Appearance="Appearance.Accent" @onclick="OpenRoomCreateDrawer">
                    Nouvelle salle
                </FluentButton>
            </div>
            <div class="rooms-table">
                <div class="rooms-row rooms-row-header">
                    <span class="rooms-col">Salle</span>
                    <span class="rooms-col">Emplacement</span>
                </div>
                @foreach (var room in rooms)
                {
                    <button class="rooms-row rooms-row-item"
                            type="button"
                            @onclick="() => OpenRoomDetailsDrawer(room)"
                            aria-label="@($"Voir {room.Name}")">
                        <span class="rooms-col">@room.Name</span>
                        <span class="rooms-col">@room.SiteName</span>
                    </button>
                }
            </div>
        </FluentCard>
    </div>
</div>

@if (isDrawerOpen)
{
    <DrawerShell DrawerClass="room-drawer" Title="@drawerTitle" OnClose="CloseDrawer">
        <ChildContent>
            <div class="drawer-content">
                @if (drawerMode == DrawerMode.SiteDetails && selectedSite is not null)
                {
                    <div class="drawer-section">
                        <div class="drawer-field">
                            <span class="drawer-label">Nom</span>
                            <span class="drawer-value">@selectedSite.Name</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Adresse</span>
                            <span class="drawer-value">@FormatAddress(selectedSite.Address)</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Salles</span>
                            <span class="drawer-value">@($"{selectedSite.Rooms.Count} salle(s)")</span>
                        </div>
                    </div>
                }
                else if (drawerMode == DrawerMode.SiteCreate || drawerMode == DrawerMode.SiteEdit)
                {
                    <div class="drawer-form">
                        <FluentTextField Label="Nom" @bind-Value="siteEditModel.Name" />
                        <FluentTextField Label="Adresse" @bind-Value="siteEditModel.Street" />
                        <FluentTextField Label="Code postal" @bind-Value="siteEditModel.ZipCode" />
                        <FluentTextField Label="Ville" @bind-Value="siteEditModel.City" />
                        <FluentTextField Label="Pays" @bind-Value="siteEditModel.Country" />
                    </div>
                }
                else if (drawerMode == DrawerMode.RoomDetails && selectedRoom is not null)
                {
                    <div class="drawer-section">
                        <div class="drawer-field">
                            <span class="drawer-label">Salle</span>
                            <span class="drawer-value">@selectedRoom.Name</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Emplacement</span>
                            <span class="drawer-value">@selectedRoom.SiteName</span>
                        </div>
                    </div>
                }
                else if (drawerMode == DrawerMode.RoomCreate || drawerMode == DrawerMode.RoomEdit)
                {
                    <div class="drawer-form">
                        <FluentTextField Label="Nom de la salle" @bind-Value="roomEditModel.Name" />
                        <div class="drawer-field">
                            <FluentSelect Label="Emplacement"
                                          TOption="string"
                                          Value="@roomEditModel.SiteId.ToString()"
                                          ValueChanged="OnRoomSiteChanged">
                                @foreach (var site in sites)
                                {
                                    <FluentOption TOption="string" Value="@site.Id.ToString()">@site.Name</FluentOption>
                                }
                            </FluentSelect>
                        </div>
                    </div>
                }
            </div>
        </ChildContent>
        <FooterContent>
            @if (drawerMode == DrawerMode.SiteDetails && selectedSite is not null)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="OpenSiteEditDrawer">
                        Editer
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="DeleteSiteAsync">
                        Supprimer
                    </FluentButton>
                </div>
            }
            else if (drawerMode == DrawerMode.SiteCreate || drawerMode == DrawerMode.SiteEdit)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="CancelEdit">Annuler</FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="SaveSiteAsync">
                        @(drawerMode == DrawerMode.SiteCreate ? "Creer l'emplacement" : "Enregistrer")
                    </FluentButton>
                </div>
            }
            else if (drawerMode == DrawerMode.RoomDetails && selectedRoom is not null)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="OpenRoomEditDrawer">
                        Editer
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="DeleteRoomAsync">
                        Supprimer
                    </FluentButton>
                </div>
            }
            else if (drawerMode == DrawerMode.RoomCreate || drawerMode == DrawerMode.RoomEdit)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="CancelEdit">Annuler</FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="SaveRoomAsync">
                        @(drawerMode == DrawerMode.RoomCreate ? "Creer la salle" : "Enregistrer")
                    </FluentButton>
                </div>
            }
        </FooterContent>
    </DrawerShell>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        BreadcrumbService.SetItems(
        [
            new BreadcrumbItem { IsHome = true, Href = "/" },
            new BreadcrumbItem { Text = "Salles" }
        ]);

        await RefreshRoomsPageAsync();
    }

    private RoomsPageDto? roomsPage;

    private IReadOnlyList<SiteWithRoomsDto> sites => roomsPage?.Sites ?? new List<SiteWithRoomsDto>();
    private IReadOnlyList<RoomWithSiteDto> rooms => roomsPage?.Rooms ?? new List<RoomWithSiteDto>();

    private SiteWithRoomsDto? selectedSite;
    private RoomWithSiteDto? selectedRoom;
    private SiteEditModel siteEditModel = new();
    private RoomEditModel roomEditModel = new();
    private DrawerMode drawerMode = DrawerMode.None;
    private string drawerTitle = string.Empty;

    private bool isDrawerOpen => drawerMode != DrawerMode.None;

    private async Task RefreshRoomsPageAsync()
    {
        var loaded = false;
        await UserFeedback.ExecuteAsync(async () =>
        {
            roomsPage = await Sender.Send(new GetRoomsPageQuery());
            loaded = true;
        }, "charger les salles");

        if (!loaded)
        {
            return;
        }

        if (selectedSite is not null)
        {
            selectedSite = sites.FirstOrDefault(site => site.Id == selectedSite.Id);
            if (selectedSite is null && drawerMode is DrawerMode.SiteDetails or DrawerMode.SiteEdit)
            {
                CloseDrawer();
                return;
            }
        }

        if (selectedRoom is not null)
        {
            selectedRoom = rooms.FirstOrDefault(room => room.Id == selectedRoom.Id);
            if (selectedRoom is null && drawerMode is DrawerMode.RoomDetails or DrawerMode.RoomEdit)
            {
                CloseDrawer();
            }
        }
    }

    private void OpenSiteDetailsDrawer(SiteWithRoomsDto site)
    {
        selectedSite = site;
        selectedRoom = null;
        drawerMode = DrawerMode.SiteDetails;
        drawerTitle = "Details de l'emplacement";
    }

    private void OpenSiteCreateDrawer()
    {
        siteEditModel = new SiteEditModel();
        selectedSite = null;
        drawerMode = DrawerMode.SiteCreate;
        drawerTitle = "Nouvel emplacement";
    }

    private void OpenSiteEditDrawer()
    {
        if (selectedSite is null)
        {
            return;
        }

        siteEditModel = new SiteEditModel
        {
            Name = selectedSite.Name,
            Street = selectedSite.Address.Street,
            ZipCode = selectedSite.Address.ZipCode,
            City = selectedSite.Address.City,
            Country = selectedSite.Address.Country
        };

        drawerMode = DrawerMode.SiteEdit;
        drawerTitle = "Modifier l'emplacement";
    }

    private async Task SaveSiteAsync()
    {
        if (drawerMode == DrawerMode.SiteCreate)
        {
            var created = await UserFeedback.ExecuteAsync(async () =>
            {
                await Sender.Send(new CreateSiteCommand(
                    siteEditModel.Name,
                    siteEditModel.Street,
                    siteEditModel.ZipCode,
                    siteEditModel.City,
                    siteEditModel.Country));

                await RefreshRoomsPageAsync();
                CloseDrawer();
            }, "creer l'emplacement", "Emplacement cree.");

            if (!created)
            {
                return;
            }
        }

        if (drawerMode == DrawerMode.SiteEdit && selectedSite is not null)
        {
            await UserFeedback.ExecuteAsync(async () =>
            {
                var updated = await Sender.Send(new UpdateSiteCommand(
                    selectedSite.Id,
                    siteEditModel.Name,
                    siteEditModel.Street,
                    siteEditModel.ZipCode,
                    siteEditModel.City,
                    siteEditModel.Country));

                if (!updated)
                {
                    throw new ValidationException("Emplacement introuvable.");
                }

                await RefreshRoomsPageAsync();
                selectedSite = sites.FirstOrDefault(site => site.Id == selectedSite.Id);
                if (selectedSite is null)
                {
                    CloseDrawer();
                    return;
                }

                drawerMode = DrawerMode.SiteDetails;
                drawerTitle = "Details de l'emplacement";
            }, "mettre a jour l'emplacement", "Emplacement mis a jour.");
        }
    }

    private async Task DeleteSiteAsync()
    {
        if (selectedSite is null)
        {
            return;
        }

        await UserFeedback.ExecuteAsync(async () =>
        {
            var deleted = await Sender.Send(new DeleteSiteCommand(selectedSite.Id));
            if (!deleted)
            {
                throw new ValidationException("Emplacement introuvable.");
            }

            await RefreshRoomsPageAsync();
            CloseDrawer();
        }, "supprimer l'emplacement", "Emplacement supprime.");
    }

    private void OpenRoomDetailsDrawer(RoomWithSiteDto room)
    {
        selectedRoom = room;
        selectedSite = null;
        drawerMode = DrawerMode.RoomDetails;
        drawerTitle = "Details de la salle";
    }

    private void OpenRoomCreateDrawer()
    {
        if (sites.Count == 0)
        {
            return;
        }

        roomEditModel = new RoomEditModel
        {
            SiteId = sites[0].Id
        };
        selectedRoom = null;
        drawerMode = DrawerMode.RoomCreate;
        drawerTitle = "Nouvelle salle";
    }

    private void OpenRoomEditDrawer()
    {
        if (selectedRoom is null)
        {
            return;
        }

        roomEditModel = new RoomEditModel
        {
            Name = selectedRoom.Name,
            SiteId = selectedRoom.SiteId
        };

        drawerMode = DrawerMode.RoomEdit;
        drawerTitle = "Modifier la salle";
    }

    private async Task SaveRoomAsync()
    {
        if (drawerMode == DrawerMode.RoomCreate)
        {
            var created = await UserFeedback.ExecuteAsync(async () =>
            {
                await Sender.Send(new CreateRoomCommand(roomEditModel.Name, roomEditModel.SiteId));
                await RefreshRoomsPageAsync();
                CloseDrawer();
            }, "creer la salle", "Salle creee.");

            if (!created)
            {
                return;
            }
        }

        if (drawerMode == DrawerMode.RoomEdit && selectedRoom is not null)
        {
            await UserFeedback.ExecuteAsync(async () =>
            {
                var updated = await Sender.Send(new UpdateRoomCommand(selectedRoom.Id, roomEditModel.Name, roomEditModel.SiteId));
                if (!updated)
                {
                    throw new ValidationException("Salle ou emplacement introuvable.");
                }

                await RefreshRoomsPageAsync();
                selectedRoom = rooms.FirstOrDefault(room => room.Id == selectedRoom.Id);
                if (selectedRoom is null)
                {
                    CloseDrawer();
                    return;
                }

                drawerMode = DrawerMode.RoomDetails;
                drawerTitle = "Details de la salle";
            }, "mettre a jour la salle", "Salle mise a jour.");
        }
    }

    private async Task DeleteRoomAsync()
    {
        if (selectedRoom is null)
        {
            return;
        }

        await UserFeedback.ExecuteAsync(async () =>
        {
            var deleted = await Sender.Send(new DeleteRoomCommand(selectedRoom.Id));
            if (!deleted)
            {
                throw new ValidationException("Salle introuvable.");
            }

            await RefreshRoomsPageAsync();
            CloseDrawer();
        }, "supprimer la salle", "Salle supprimee.");
    }

    private void CancelEdit()
    {
        if (drawerMode == DrawerMode.SiteEdit && selectedSite is not null)
        {
            drawerMode = DrawerMode.SiteDetails;
            drawerTitle = "Details de l'emplacement";
            return;
        }

        if (drawerMode == DrawerMode.RoomEdit && selectedRoom is not null)
        {
            drawerMode = DrawerMode.RoomDetails;
            drawerTitle = "Details de la salle";
            return;
        }

        CloseDrawer();
    }

    private void CloseDrawer()
    {
        drawerMode = DrawerMode.None;
        selectedSite = null;
        selectedRoom = null;
        drawerTitle = string.Empty;
    }

    private static string FormatAddress(AddressDto address)
    {
        var parts = new List<string> { address.Street, address.ZipCode, address.City, address.Country }
            .Where(value => !string.IsNullOrWhiteSpace(value));

        return string.Join(", ", parts);
    }

    private void OnRoomSiteChanged(string? value)
    {
        if (int.TryParse(value, out var id))
        {
            roomEditModel.SiteId = id;
        }
    }

    private enum DrawerMode
    {
        None,
        SiteDetails,
        SiteCreate,
        SiteEdit,
        RoomDetails,
        RoomCreate,
        RoomEdit
    }

    private sealed class SiteEditModel
    {
        public string Name { get; set; } = string.Empty;
        public string Street { get; set; } = string.Empty;
        public string ZipCode { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string Country { get; set; } = string.Empty;
    }

    private sealed class RoomEditModel
    {
        public string Name { get; set; } = string.Empty;
        public int SiteId { get; set; }
    }
}
