@page "/rooms"
@using FluentValidation
@using MediatR
@using TechXyz.GymXyz.Application.Commands
@using TechXyz.GymXyz.Application.Models
@using TechXyz.GymXyz.Application.Queries
@inject BreadcrumbService BreadcrumbService
@inject ISender Sender
@inject IUserFeedbackService UserFeedback

<PageTitle>Salles</PageTitle>

<div class="rooms-page">
    <div class="rooms-header">
        <div class="rooms-title">
            <h1>Salles</h1>
            <p>Informations du gym, gestion des emplacements et des salles.</p>
        </div>
    </div>

    <FluentCard class="gym-card">
        <div class="gym-header">
            <div>
                <h2>@(roomsPage?.GymName ?? "Gym")</h2>
                <p>Gym principal</p>
            </div>
            <div class="gym-meta">
                <span>@locations.Count emplacement(s)</span>
                <span>@rooms.Count salle(s)</span>
            </div>
        </div>
    </FluentCard>

    <div class="rooms-layout">
        <FluentCard class="locations-card">
            <div class="locations-header">
                <h2>Emplacements</h2>
                <FluentButton Appearance="Appearance.Accent" @onclick="OpenLocationCreateDrawer">
                    Nouvel emplacement
                </FluentButton>
            </div>
            <div class="locations-list">
                @foreach (var location in locations)
                {
                    <button class="location-item"
                            type="button"
                            @onclick="() => OpenLocationDetailsDrawer(location)"
                            aria-label="@($"Voir {location.Name}")">
                        <div class="location-name">@location.Name</div>
                        <div class="location-meta">@FormatAddress(location.Address)</div>
                        <div class="location-meta">@($"{location.Rooms.Count} salle(s)")</div>
                    </button>
                }
            </div>
        </FluentCard>

        <FluentCard class="rooms-card">
            <div class="rooms-card-header">
                <h2>Salles</h2>
                <FluentButton Appearance="Appearance.Accent" @onclick="OpenRoomCreateDrawer">
                    Nouvelle salle
                </FluentButton>
            </div>
            <div class="rooms-table">
                <div class="rooms-row rooms-row-header">
                    <span class="rooms-col">Salle</span>
                    <span class="rooms-col">Emplacement</span>
                </div>
                @foreach (var room in rooms)
                {
                    <button class="rooms-row rooms-row-item"
                            type="button"
                            @onclick="() => OpenRoomDetailsDrawer(room)"
                            aria-label="@($"Voir {room.Name}")">
                        <span class="rooms-col">@room.Name</span>
                        <span class="rooms-col">@room.LocationName</span>
                    </button>
                }
            </div>
        </FluentCard>
    </div>
</div>

@if (isDrawerOpen)
{
    <DrawerShell DrawerClass="room-drawer" Title="@drawerTitle" OnClose="CloseDrawer">
        <ChildContent>
            <div class="drawer-content">
                @if (drawerMode == DrawerMode.LocationDetails && selectedLocation is not null)
                {
                    <div class="drawer-section">
                        <div class="drawer-field">
                            <span class="drawer-label">Nom</span>
                            <span class="drawer-value">@selectedLocation.Name</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Adresse</span>
                            <span class="drawer-value">@FormatAddress(selectedLocation.Address)</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Salles</span>
                            <span class="drawer-value">@($"{selectedLocation.Rooms.Count} salle(s)")</span>
                        </div>
                    </div>
                }
                else if (drawerMode == DrawerMode.LocationCreate || drawerMode == DrawerMode.LocationEdit)
                {
                    <div class="drawer-form">
                        <FluentTextField Label="Nom" @bind-Value="locationEditModel.Name" />
                        <FluentTextField Label="Adresse" @bind-Value="locationEditModel.Street" />
                        <FluentTextField Label="Code postal" @bind-Value="locationEditModel.ZipCode" />
                        <FluentTextField Label="Ville" @bind-Value="locationEditModel.City" />
                        <FluentTextField Label="Pays" @bind-Value="locationEditModel.Country" />
                    </div>
                }
                else if (drawerMode == DrawerMode.RoomDetails && selectedRoom is not null)
                {
                    <div class="drawer-section">
                        <div class="drawer-field">
                            <span class="drawer-label">Salle</span>
                            <span class="drawer-value">@selectedRoom.Name</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Emplacement</span>
                            <span class="drawer-value">@selectedRoom.LocationName</span>
                        </div>
                    </div>
                }
                else if (drawerMode == DrawerMode.RoomCreate || drawerMode == DrawerMode.RoomEdit)
                {
                    <div class="drawer-form">
                        <FluentTextField Label="Nom de la salle" @bind-Value="roomEditModel.Name" />
                        <div class="drawer-field">
                            <span class="drawer-label">Emplacement</span>
                            <select class="drawer-select" @bind="roomEditModel.LocationId">
                                @foreach (var location in locations)
                                {
                                    <option value="@location.Id">@location.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                }
            </div>
        </ChildContent>
        <FooterContent>
            @if (drawerMode == DrawerMode.LocationDetails && selectedLocation is not null)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="OpenLocationEditDrawer">
                        Editer
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="DeleteLocationAsync">
                        Supprimer
                    </FluentButton>
                </div>
            }
            else if (drawerMode == DrawerMode.LocationCreate || drawerMode == DrawerMode.LocationEdit)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="CancelEdit">Annuler</FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="SaveLocationAsync">
                        @(drawerMode == DrawerMode.LocationCreate ? "Creer l'emplacement" : "Enregistrer")
                    </FluentButton>
                </div>
            }
            else if (drawerMode == DrawerMode.RoomDetails && selectedRoom is not null)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="OpenRoomEditDrawer">
                        Editer
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="DeleteRoomAsync">
                        Supprimer
                    </FluentButton>
                </div>
            }
            else if (drawerMode == DrawerMode.RoomCreate || drawerMode == DrawerMode.RoomEdit)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="CancelEdit">Annuler</FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="SaveRoomAsync">
                        @(drawerMode == DrawerMode.RoomCreate ? "Creer la salle" : "Enregistrer")
                    </FluentButton>
                </div>
            }
        </FooterContent>
    </DrawerShell>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        BreadcrumbService.SetItems(
        [
            new BreadcrumbItem { IsHome = true, Href = "/" },
            new BreadcrumbItem { Text = "Salles" }
        ]);

        await RefreshRoomsPageAsync();
    }

    private RoomsPageDto? roomsPage;

    private IReadOnlyList<LocationWithRoomsDto> locations => roomsPage?.Locations ?? new List<LocationWithRoomsDto>();
    private IReadOnlyList<RoomWithLocationDto> rooms => roomsPage?.Rooms ?? new List<RoomWithLocationDto>();

    private LocationWithRoomsDto? selectedLocation;
    private RoomWithLocationDto? selectedRoom;
    private LocationEditModel locationEditModel = new();
    private RoomEditModel roomEditModel = new();
    private DrawerMode drawerMode = DrawerMode.None;
    private string drawerTitle = string.Empty;

    private bool isDrawerOpen => drawerMode != DrawerMode.None;

    private async Task RefreshRoomsPageAsync()
    {
        var loaded = false;
        await UserFeedback.ExecuteAsync(async () =>
        {
            roomsPage = await Sender.Send(new GetRoomsPageQuery());
            loaded = true;
        }, "charger les salles");

        if (!loaded)
        {
            return;
        }

        if (selectedLocation is not null)
        {
            selectedLocation = locations.FirstOrDefault(location => location.Id == selectedLocation.Id);
            if (selectedLocation is null && drawerMode is DrawerMode.LocationDetails or DrawerMode.LocationEdit)
            {
                CloseDrawer();
                return;
            }
        }

        if (selectedRoom is not null)
        {
            selectedRoom = rooms.FirstOrDefault(room => room.Id == selectedRoom.Id);
            if (selectedRoom is null && drawerMode is DrawerMode.RoomDetails or DrawerMode.RoomEdit)
            {
                CloseDrawer();
            }
        }
    }

    private void OpenLocationDetailsDrawer(LocationWithRoomsDto location)
    {
        selectedLocation = location;
        selectedRoom = null;
        drawerMode = DrawerMode.LocationDetails;
        drawerTitle = "Details de l'emplacement";
    }

    private void OpenLocationCreateDrawer()
    {
        locationEditModel = new LocationEditModel();
        selectedLocation = null;
        drawerMode = DrawerMode.LocationCreate;
        drawerTitle = "Nouvel emplacement";
    }

    private void OpenLocationEditDrawer()
    {
        if (selectedLocation is null)
        {
            return;
        }

        locationEditModel = new LocationEditModel
        {
            Name = selectedLocation.Name,
            Street = selectedLocation.Address.Street,
            ZipCode = selectedLocation.Address.ZipCode,
            City = selectedLocation.Address.City,
            Country = selectedLocation.Address.Country
        };

        drawerMode = DrawerMode.LocationEdit;
        drawerTitle = "Modifier l'emplacement";
    }

    private async Task SaveLocationAsync()
    {
        if (drawerMode == DrawerMode.LocationCreate)
        {
            var created = await UserFeedback.ExecuteAsync(async () =>
            {
                await Sender.Send(new CreateLocationCommand(
                    locationEditModel.Name,
                    locationEditModel.Street,
                    locationEditModel.ZipCode,
                    locationEditModel.City,
                    locationEditModel.Country));

                await RefreshRoomsPageAsync();
                CloseDrawer();
            }, "creer l'emplacement", "Emplacement cree.");

            if (!created)
            {
                return;
            }
        }

        if (drawerMode == DrawerMode.LocationEdit && selectedLocation is not null)
        {
            await UserFeedback.ExecuteAsync(async () =>
            {
                var updated = await Sender.Send(new UpdateLocationCommand(
                    selectedLocation.Id,
                    locationEditModel.Name,
                    locationEditModel.Street,
                    locationEditModel.ZipCode,
                    locationEditModel.City,
                    locationEditModel.Country));

                if (!updated)
                {
                    throw new ValidationException("Emplacement introuvable.");
                }

                await RefreshRoomsPageAsync();
                selectedLocation = locations.FirstOrDefault(location => location.Id == selectedLocation.Id);
                if (selectedLocation is null)
                {
                    CloseDrawer();
                    return;
                }

                drawerMode = DrawerMode.LocationDetails;
                drawerTitle = "Details de l'emplacement";
            }, "mettre a jour l'emplacement", "Emplacement mis a jour.");
        }
    }

    private async Task DeleteLocationAsync()
    {
        if (selectedLocation is null)
        {
            return;
        }

        await UserFeedback.ExecuteAsync(async () =>
        {
            var deleted = await Sender.Send(new DeleteLocationCommand(selectedLocation.Id));
            if (!deleted)
            {
                throw new ValidationException("Emplacement introuvable.");
            }

            await RefreshRoomsPageAsync();
            CloseDrawer();
        }, "supprimer l'emplacement", "Emplacement supprime.");
    }

    private void OpenRoomDetailsDrawer(RoomWithLocationDto room)
    {
        selectedRoom = room;
        selectedLocation = null;
        drawerMode = DrawerMode.RoomDetails;
        drawerTitle = "Details de la salle";
    }

    private void OpenRoomCreateDrawer()
    {
        if (locations.Count == 0)
        {
            return;
        }

        roomEditModel = new RoomEditModel
        {
            LocationId = locations[0].Id
        };
        selectedRoom = null;
        drawerMode = DrawerMode.RoomCreate;
        drawerTitle = "Nouvelle salle";
    }

    private void OpenRoomEditDrawer()
    {
        if (selectedRoom is null)
        {
            return;
        }

        roomEditModel = new RoomEditModel
        {
            Name = selectedRoom.Name,
            LocationId = selectedRoom.LocationId
        };

        drawerMode = DrawerMode.RoomEdit;
        drawerTitle = "Modifier la salle";
    }

    private async Task SaveRoomAsync()
    {
        if (drawerMode == DrawerMode.RoomCreate)
        {
            var created = await UserFeedback.ExecuteAsync(async () =>
            {
                await Sender.Send(new CreateRoomCommand(roomEditModel.Name, roomEditModel.LocationId));
                await RefreshRoomsPageAsync();
                CloseDrawer();
            }, "creer la salle", "Salle creee.");

            if (!created)
            {
                return;
            }
        }

        if (drawerMode == DrawerMode.RoomEdit && selectedRoom is not null)
        {
            await UserFeedback.ExecuteAsync(async () =>
            {
                var updated = await Sender.Send(new UpdateRoomCommand(selectedRoom.Id, roomEditModel.Name, roomEditModel.LocationId));
                if (!updated)
                {
                    throw new ValidationException("Salle ou emplacement introuvable.");
                }

                await RefreshRoomsPageAsync();
                selectedRoom = rooms.FirstOrDefault(room => room.Id == selectedRoom.Id);
                if (selectedRoom is null)
                {
                    CloseDrawer();
                    return;
                }

                drawerMode = DrawerMode.RoomDetails;
                drawerTitle = "Details de la salle";
            }, "mettre a jour la salle", "Salle mise a jour.");
        }
    }

    private async Task DeleteRoomAsync()
    {
        if (selectedRoom is null)
        {
            return;
        }

        await UserFeedback.ExecuteAsync(async () =>
        {
            var deleted = await Sender.Send(new DeleteRoomCommand(selectedRoom.Id));
            if (!deleted)
            {
                throw new ValidationException("Salle introuvable.");
            }

            await RefreshRoomsPageAsync();
            CloseDrawer();
        }, "supprimer la salle", "Salle supprimee.");
    }

    private void CancelEdit()
    {
        if (drawerMode == DrawerMode.LocationEdit && selectedLocation is not null)
        {
            drawerMode = DrawerMode.LocationDetails;
            drawerTitle = "Details de l'emplacement";
            return;
        }

        if (drawerMode == DrawerMode.RoomEdit && selectedRoom is not null)
        {
            drawerMode = DrawerMode.RoomDetails;
            drawerTitle = "Details de la salle";
            return;
        }

        CloseDrawer();
    }

    private void CloseDrawer()
    {
        drawerMode = DrawerMode.None;
        selectedLocation = null;
        selectedRoom = null;
        drawerTitle = string.Empty;
    }

    private static string FormatAddress(AddressDto address)
    {
        var parts = new List<string> { address.Street, address.ZipCode, address.City, address.Country }
            .Where(value => !string.IsNullOrWhiteSpace(value));

        return string.Join(", ", parts);
    }

    private enum DrawerMode
    {
        None,
        LocationDetails,
        LocationCreate,
        LocationEdit,
        RoomDetails,
        RoomCreate,
        RoomEdit
    }

    private sealed class LocationEditModel
    {
        public string Name { get; set; } = string.Empty;
        public string Street { get; set; } = string.Empty;
        public string ZipCode { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string Country { get; set; } = string.Empty;
    }

    private sealed class RoomEditModel
    {
        public string Name { get; set; } = string.Empty;
        public int LocationId { get; set; }
    }
}
