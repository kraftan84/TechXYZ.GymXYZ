@page "/members"
@using MediatR
@using TechXyz.GymXyz.Application.Commands
@using TechXyz.GymXyz.Application.Queries
@using TechXyz.GymXyz.WebApp.Components.Features.Members
@implements IDisposable

@inject NavigationManager NavManager
@inject ISender Sender
@inject IUserFeedbackService UserFeedback
@inject ResponsiveModeService Responsive

<PageTitle>Membres</PageTitle>

@* One page, one set of state, two presentations. The queries and the actions
   below are shared; only the markup differs. *@
@if (Responsive.IsMobile)
{
    <MembersMobile Page="_page"
                   Search="@_search"
                   Status="_status"
                   CurrentPage="_currentPage"
                   PageCount="_pageCount"
                   Today="_today"
                   City="@Brand?.City"
                   OnSearchChanged="ApplySearchAsync"
                   OnStatusChanged="ApplyStatusAsync"
                   OnPageChanged="GoToPageAsync"
                   OnOpen="OpenMember"
                   OnCreate="OpenCreateDrawer"
                   CanManage="User.IsManager"/>
}
else
{
    <div class="gx-screen">
        <MembersDesktop Page="_page"
                        Search="@_search"
                        Status="_status"
                        CurrentPage="_currentPage"
                        PageCount="_pageCount"
                        Today="_today"
                        OnSearchChanged="ApplySearchAsync"
                        OnStatusChanged="ApplyStatusAsync"
                        OnPageChanged="GoToPageAsync"
                        OnOpen="OpenMember"
                        OnCreate="OpenCreateDrawer"
                        CanManage="User.IsManager"/>
    </div>
}

@if (_isDrawerOpen)
{
    <MemberDrawer Model="_editModel"
                  IsNew="true"
                  IsSaving="_isSaving"
                  OnSave="CreateMemberAsync"
                  OnCancel="CloseDrawer"/>
}

@code {
    [CascadingParameter] public GymUserInfo User { get; set; } = GymUserInfo.Anonymous;

    [CascadingParameter] private TenantBrandDto? Brand { get; set; }

    private MembersPageDto _page = MembersPageDto.Empty;
    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);

    private string? _search;
    private MemberStatus? _status;
    private int _currentPage = 1;

    private bool _isDrawerOpen;
    private bool _isSaving;
    private MemberEditModel _editModel = new();

    private int _pageCount = 1;

    protected override async Task OnInitializedAsync()
    {
        Responsive.Changed += OnResponsiveChanged;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        await UserFeedback.ExecuteAsync(async () =>
        {
            _page = await Sender.Send(new GetMembersQuery
            {
                Search = _search,
                Status = _status,
                Page = _currentPage,
                PageSize = GetMembersQuery.DefaultPageSize
            });

            _pageCount = Math.Max(
                1,
                (int)Math.Ceiling(_page.FilteredCount / (double)GetMembersQuery.DefaultPageSize));

            // A deletion or a narrower filter can leave us past the last page.
            if (_currentPage > _pageCount)
            {
                _currentPage = _pageCount;
                _page = await Sender.Send(new GetMembersQuery
                {
                    Search = _search,
                    Status = _status,
                    Page = _currentPage,
                    PageSize = GetMembersQuery.DefaultPageSize
                });
            }
        }, "charger la liste des membres");
    }

    private async Task ApplySearchAsync(string? search)
    {
        _search = string.IsNullOrWhiteSpace(search) ? null : search;
        _currentPage = 1;
        await RefreshAsync();
    }

    private async Task ApplyStatusAsync(MemberStatus? status)
    {
        _status = status;
        _currentPage = 1;
        await RefreshAsync();
    }

    private async Task GoToPageAsync(int page)
    {
        _currentPage = Math.Clamp(page, 1, _pageCount);
        await RefreshAsync();
    }

    private void OpenMember(MemberListItemDto member)
        => NavManager.NavigateTo($"/members/{member.Id}");

    private void OpenCreateDrawer()
    {
        _editModel = new MemberEditModel
        {
            JoinedOn = DateTime.Today,
            Country = "France"
        };
        _isDrawerOpen = true;
    }

    private void CloseDrawer()
    {
        _isDrawerOpen = false;
        _isSaving = false;
    }

    private async Task CreateMemberAsync()
    {
        if (_isSaving)
        {
            return;
        }

        _isSaving = true;

        await UserFeedback.ExecuteAsync(async () =>
        {
            var createdId = await Sender.Send(new CreateMemberCommand(
                _editModel.FirstName,
                _editModel.LastName,
                _editModel.Email,
                _editModel.Phone,
                _editModel.Street,
                _editModel.ZipCode,
                _editModel.City,
                _editModel.Country,
                _editModel.JoinedOnOnly,
                _editModel.BirthDateOnly,
                _editModel.Notes));

            CloseDrawer();
            NavManager.NavigateTo($"/members/{createdId}");
        }, "créer le membre", "Membre créé.");

        _isSaving = false;
    }

    private void OnResponsiveChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Responsive.Changed -= OnResponsiveChanged;
}
