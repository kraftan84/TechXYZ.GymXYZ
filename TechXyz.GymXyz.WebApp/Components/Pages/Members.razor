@page "/members"
@using FluentValidation
@using MediatR
@using TechXyz.GymXyz.Application.Commands
@using TechXyz.GymXyz.Application.Models
@using TechXyz.GymXyz.Application.Queries
@inject NavigationManager NavManager
@inject BreadcrumbService BreadcrumbService
@inject ISender Sender
@inject IUserFeedbackService UserFeedback

<PageTitle>Membres</PageTitle>

<div class="members-page">
    <div class="members-header">
        <div class="members-title">
            <h1>Membres</h1>
            <p>Gerez les inscriptions, les coordonnees et les informations de contact.</p>
        </div>
        <div class="members-actions">
            <FluentTextField class="members-search"
                             Label="Rechercher"
                             Placeholder="Nom, email, telephone..."
                             @bind-Value="SearchText"
                             @bind-Value:event="oninput" />
            <FluentButton Appearance="Appearance.Accent" @onclick="OpenCreateDrawer">
                Nouveau membre
            </FluentButton>
        </div>
    </div>

    <FluentCard class="members-card">
        <div class="members-table">
            <div class="members-row members-row-header">
                <span class="members-col members-col-photo">Photo</span>
                <span class="members-col">Prenom</span>
                <span class="members-col">Nom</span>
                <span class="members-col members-col-email">Email</span>
                <span class="members-col members-col-plan">Abonnement</span>
                <span class="members-col members-col-actions">Actions</span>
            </div>
            @foreach (var member in pagedMembers)
            {
                <div class="members-row members-row-item"
                     role="button"
                     tabindex="0"
                     @onclick="() => OpenDetailsDrawer(member)"
                     @onkeydown="(args) => OnMemberRowKeyDown(args, member)"
                     aria-label="@($"Voir {member.FirstName} {member.LastName}")">
                    <span class="members-col members-col-photo">
                        <img class="member-avatar"
                             src="images/avatar-placeholder.svg"
                             alt="@($"Photo de {member.FirstName} {member.LastName}")" />
                    </span>
                    <span class="members-col">@member.FirstName</span>
                    <span class="members-col">@member.LastName</span>
                    <span class="members-col members-col-email">@member.Email</span>
                    <span class="members-col members-col-plan">
                        @if (member.HasActiveSubscription)
                        {
                            <span class="members-badge members-badge-active">Actif</span>
                        }
                        else
                        {
                            <span class="members-badge members-badge-inactive">Inactif</span>
                        }
                    </span>
                    <span class="members-col members-col-actions">
                        <div class="members-inline-actions" @onclick:stopPropagation="true">
                            <FluentButton Appearance="Appearance.Stealth"
                                          Size="ButtonSize.Small"
                                          IconEnd="@(new Icons.Regular.Size20.ChevronRight())"
                                          aria-label="@($"Voir {member.FirstName} {member.LastName}")"
                                          @onclick="() => GoToMember(member)" />
                            <FluentButton Appearance="Appearance.Stealth"
                                          Size="ButtonSize.Small"
                                          IconEnd="@(new Icons.Regular.Size20.Edit())"
                                          aria-label="@($"Editer {member.FirstName} {member.LastName}")"
                                          @onclick="() => OpenEditDrawer(member)" />
                        </div>
                    </span>
                </div>
            }
        </div>
        <div class="members-pagination">
            <span>Page @currentPage sur @totalPages</span>
            <div class="pagination-actions">
                <FluentButton Appearance="Appearance.Outline"
                              Disabled="@(!CanGoPrevious)"
                              @onclick="GoPrevious">
                    Precedent
                </FluentButton>
                <FluentButton Appearance="Appearance.Outline"
                              Disabled="@(!CanGoNext)"
                              @onclick="GoNext">
                    Suivant
                </FluentButton>
            </div>
        </div>
    </FluentCard>
</div>

@if (isDrawerOpen)
{
    <DrawerShell DrawerClass="member-drawer" Title="@drawerTitle" OnClose="CloseDrawer">
        <ChildContent>
            <div class="drawer-content">
                @if (drawerMode == DrawerMode.Details && selectedMember is not null)
                {
                    <div class="drawer-profile">
                        <img class="drawer-avatar"
                             src="images/avatar-placeholder.svg"
                             alt="@($"Photo de {selectedMember.FirstName} {selectedMember.LastName}")" />
                        <div>
                            <div class="drawer-name">@selectedMember.FirstName @selectedMember.LastName</div>
                            <div class="drawer-subtitle">@selectedMember.FirstName @selectedMember.LastName</div>
                        </div>
                    </div>
                    <div class="drawer-section">
                        <div class="drawer-field">
                            <span class="drawer-label">Email</span>
                            <span class="drawer-value">@selectedMember.Email</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Telephone</span>
                            <span class="drawer-value">@selectedMember.Phone</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Adresse</span>
                            <span class="drawer-value">@FormatAddress(selectedMember.Address)</span>
                        </div>
                    </div>
                }
                else if (drawerMode == DrawerMode.Create || drawerMode == DrawerMode.Edit)
                {
                    <PersonEditForm Model="editModel" />
                }
            </div>
        </ChildContent>
        <FooterContent>
            @if (drawerMode == DrawerMode.Details && selectedMember is not null)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="OpenMemberPage">
                        Voir la fiche
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Outline" @onclick="OpenEditDrawer">
                        Editer
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="DeleteMemberAsync">
                        Supprimer
                    </FluentButton>
                </div>
            }
            else if (drawerMode == DrawerMode.Create || drawerMode == DrawerMode.Edit)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="CancelEdit">Annuler</FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="SaveMemberAsync">
                        @(drawerMode == DrawerMode.Create ? "Creer le membre" : "Enregistrer")
                    </FluentButton>
                </div>
            }
        </FooterContent>
    </DrawerShell>
}

@code {
    protected override async Task OnInitializedAsync()
    {
        BreadcrumbService.SetItems(
        [
            new BreadcrumbItem { IsHome = true, Href = "/" },
            new BreadcrumbItem { Text = "Membres" }
        ]);

        await RefreshMembersAsync();
    }

    private List<MemberDto> allMembers = [];
    private MemberDto? selectedMember;
    private MemberEditModel editModel = new();
    private DrawerMode drawerMode = DrawerMode.None;
    private string drawerTitle = string.Empty;
    private int currentPage = 1;
    private readonly int pageSize = 10;
    private string searchText = string.Empty;

    private bool isDrawerOpen => drawerMode != DrawerMode.None;

    private IEnumerable<MemberDto> filteredMembers => string.IsNullOrWhiteSpace(searchText)
        ? allMembers
        : allMembers.Where(member =>
            member.FirstName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            member.LastName.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
            (member.Email?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (member.Phone?.Contains(searchText, StringComparison.OrdinalIgnoreCase) ?? false));

    private int totalPages => Math.Max(1, (int)Math.Ceiling(filteredMembers.Count() / (double)pageSize));

    private IEnumerable<MemberDto> pagedMembers => filteredMembers
        .Skip((currentPage - 1) * pageSize)
        .Take(pageSize);

    private bool CanGoPrevious => currentPage > 1;
    private bool CanGoNext => currentPage < totalPages;

    private string SearchText
    {
        get => searchText;
        set
        {
            if (searchText == value)
            {
                return;
            }

            searchText = value;
            currentPage = 1;
        }
    }

    private async Task RefreshMembersAsync()
    {
        var loaded = false;
        await UserFeedback.ExecuteAsync(async () =>
        {
            allMembers = await Sender.Send(new GetMembersQuery());
            loaded = true;
        }, "charger la liste des membres");

        if (!loaded)
        {
            return;
        }

        ClampCurrentPage();

        if (selectedMember is null)
        {
            return;
        }

        selectedMember = allMembers.FirstOrDefault(member => member.Id == selectedMember.Id);
        if (selectedMember is null)
        {
            CloseDrawer();
        }
    }

    private void OpenDetailsDrawer(MemberDto member)
    {
        selectedMember = member;
        drawerMode = DrawerMode.Details;
        drawerTitle = "Details du membre";
    }

    private void OpenEditDrawer(MemberDto member)
    {
        selectedMember = member;
        OpenEditDrawer();
    }

    private void OpenCreateDrawer()
    {
        editModel = new MemberEditModel();
        drawerMode = DrawerMode.Create;
        drawerTitle = "Nouveau membre";
    }

    private void CloseDrawer()
    {
        drawerMode = DrawerMode.None;
        selectedMember = null;
        drawerTitle = string.Empty;
    }

    private void OpenEditDrawer()
    {
        if (selectedMember is null)
        {
            return;
        }

        editModel = new MemberEditModel
        {
            FirstName = selectedMember.FirstName,
            LastName = selectedMember.LastName,
            Email = selectedMember.Email ?? string.Empty,
            Phone = selectedMember.Phone ?? string.Empty,
            Street = selectedMember.Address?.Street ?? string.Empty,
            ZipCode = selectedMember.Address?.ZipCode ?? string.Empty,
            City = selectedMember.Address?.City ?? string.Empty,
            Country = selectedMember.Address?.Country ?? string.Empty
        };

        drawerMode = DrawerMode.Edit;
        drawerTitle = "Modifier le membre";
    }

    private void OnMemberRowKeyDown(KeyboardEventArgs args, MemberDto member)
    {
        if (args.Key == "Enter" || args.Key == " ")
        {
            OpenDetailsDrawer(member);
        }
    }

    private void CancelEdit()
    {
        if (drawerMode == DrawerMode.Edit && selectedMember is not null)
        {
            drawerMode = DrawerMode.Details;
            drawerTitle = "Details du membre";
            return;
        }

        CloseDrawer();
    }

    private async Task SaveMemberAsync()
    {
        if (drawerMode == DrawerMode.Create)
        {
            var createdMemberId = 0;
            var created = await UserFeedback.ExecuteAsync(async () =>
            {
                createdMemberId = await Sender.Send(new CreateMemberCommand(
                    editModel.FirstName,
                    editModel.LastName,
                    editModel.Email,
                    editModel.Phone,
                    editModel.Street,
                    editModel.ZipCode,
                    editModel.City,
                    editModel.Country));

                await RefreshMembersAsync();
                selectedMember = allMembers.FirstOrDefault(member => member.Id == createdMemberId);
                CloseDrawer();
            }, "creer le membre", "Membre cree.");

            if (!created)
            {
                return;
            }
        }

        if (drawerMode == DrawerMode.Edit && selectedMember is not null)
        {
            await UserFeedback.ExecuteAsync(async () =>
            {
                var updated = await Sender.Send(new UpdateMemberCommand(
                    selectedMember.Id,
                    editModel.FirstName,
                    editModel.LastName,
                    editModel.Email,
                    editModel.Phone,
                    editModel.Street,
                    editModel.ZipCode,
                    editModel.City,
                    editModel.Country));

                if (!updated)
                {
                    throw new ValidationException("Membre introuvable.");
                }

                await RefreshMembersAsync();
                selectedMember = allMembers.FirstOrDefault(member => member.Id == selectedMember.Id);
                if (selectedMember is null)
                {
                    CloseDrawer();
                    return;
                }

                drawerMode = DrawerMode.Details;
                drawerTitle = "Details du membre";
            }, "mettre a jour le membre", "Membre mis a jour.");
        }
    }

    private async Task DeleteMemberAsync()
    {
        if (selectedMember is null)
        {
            return;
        }

        await UserFeedback.ExecuteAsync(async () =>
        {
            var deleted = await Sender.Send(new DeleteMemberCommand(selectedMember.Id));
            if (!deleted)
            {
                throw new ValidationException("Membre introuvable.");
            }

            await RefreshMembersAsync();
        }, "supprimer le membre", "Membre supprime.");
    }

    private void OpenMemberPage()
    {
        if (selectedMember is null)
        {
            return;
        }

        NavManager.NavigateTo($"/members/{selectedMember.Id}");
    }

    private void GoToMember(MemberDto member)
    {
        NavManager.NavigateTo($"/members/{member.Id}");
    }

    private void GoPrevious()
    {
        if (CanGoPrevious)
        {
            currentPage--;
        }
    }

    private void GoNext()
    {
        if (CanGoNext)
        {
            currentPage++;
        }
    }

    private void ClampCurrentPage()
    {
        if (currentPage > totalPages)
        {
            currentPage = totalPages;
        }
    }

    private static string FormatAddress(AddressDto? address)
    {
        if (address is null)
        {
            return "-";
        }

        var parts = new List<string> { address.Street, address.ZipCode, address.City, address.Country }
            .Where(value => !string.IsNullOrWhiteSpace(value));

        return string.Join(", ", parts);
    }

    private enum DrawerMode
    {
        None,
        Details,
        Create,
        Edit
    }

    private sealed class MemberEditModel : IPersonEditModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string? Email { get; set; } = string.Empty;
        public string? Phone { get; set; } = string.Empty;
        public string Street { get; set; } = string.Empty;
        public string ZipCode { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string Country { get; set; } = string.Empty;
    }
}
