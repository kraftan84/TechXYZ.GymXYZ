@page "/"

<PageTitle>Accueil</PageTitle>

<div class="dashboard">
    <FluentCard class="dashboard-hero">
        <div class="hero-content">
            <div class="hero-avatar">
                <FluentPersona Image="images/avatar-placeholder.svg"/>
            </div>
            <div class="hero-text">
                <h1>Bon retour, Alex</h1>
                <p>Prêt pour les séances d'aujourd'hui ?</p>
            </div>
        </div>
    </FluentCard>

    <div class="dashboard-grid">
        <FluentCard class="today-card">
            <div class="card-header">
                <h2>Cours aujourd'hui</h2>
                <FluentBadge Appearance="Appearance.Accent">@LessonsToday.Count()</FluentBadge>
            </div>
            <FluentDataGrid Items="@LessonsToday">
                <PropertyColumn Property="@(lesson => lesson.Time)" Title="Heure"/>
                <PropertyColumn Property="@(lesson => lesson.Title)" Title="Cours"/>
                <PropertyColumn Property="@(lesson => lesson.Location)" Title="Lieu"/>
                <PropertyColumn Property="@(lesson => lesson.Trainer)" Title="Coach"/>
            </FluentDataGrid>
        </FluentCard>

        <FluentCard class="week-card">
            <div class="card-header">
                <h3>Cours cette semaine</h3>
                <FluentBadge Appearance="Appearance.Neutral">@LessonsWeek.Count</FluentBadge>
            </div>
            <ul class="lesson-list">
                @foreach (var lesson in LessonsWeek)
                {
                    <li class="lesson-row">
                        <div class="lesson-day">@lesson.Day</div>
                        <div class="lesson-info">
                            <div class="lesson-title">@lesson.Title</div>
                            <div class="lesson-time">@lesson.Time</div>
                        </div>
                    </li>
                }
            </ul>
        </FluentCard>
    </div>
</div>

@code {
    private readonly IQueryable<LessonItem> LessonsToday = new[]
    {
        new LessonItem("06:30", "HIIT Blast", "Studio A", "Coach Maya"),
        new LessonItem("12:00", "Mobility Flow", "Studio B", "Coach Lee"),
        new LessonItem("18:30", "Power Cycle", "Studio C", "Coach Nora")
    }.AsQueryable();

    private readonly List<WeeklyLesson> LessonsWeek = new()
    {
        new WeeklyLesson("Mon", "Strength Foundations", "07:15"),
        new WeeklyLesson("Tue", "Pilates Core", "18:00"),
        new WeeklyLesson("Wed", "Boxing Fundamentals", "19:30"),
        new WeeklyLesson("Thu", "Yoga Restore", "17:15"),
        new WeeklyLesson("Fri", "Sprint Intervals", "06:45")
    };

    private sealed record LessonItem(string Time, string Title, string Location, string Trainer);
    private sealed record WeeklyLesson(string Day, string Title, string Time);
}
