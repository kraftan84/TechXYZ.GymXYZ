@page "/"
@inject NavigationManager NavManager
@inject BreadcrumbService BreadcrumbService

<PageTitle>Accueil</PageTitle>

<div class="dashboard">
    <FluentCard class="dashboard-hero">
        <div class="hero-content">
            <div class="hero-avatar">
                <FluentPersona Image="images/avatar-placeholder.svg"/>
            </div>
            <div class="hero-text">
                <h1>Bon retour, Alex</h1>
                <p>Pret pour les seances d'aujourd'hui ?</p>
            </div>
            <div class="hero-metrics">
                <div class="hero-metric">
                    <span class="hero-metric-label">Aujourd'hui</span>
                    <span class="hero-metric-value">@LessonsToday.Count</span>
                </div>
                <div class="hero-metric">
                    <span class="hero-metric-label">Cette semaine</span>
                    <span class="hero-metric-value">@LessonsWeek.Count</span>
                </div>
            </div>
        </div>
    </FluentCard>

    <div class="dashboard-grid">
        <FluentCard class="today-card">
            <div class="card-header">
                <h2>Cours aujourd'hui</h2>
            </div>
            <div class="daily-planning" style="@($"--total:{DayTotalMinutes};")">
                <div class="planning-time-column">
                    @foreach (var hour in DayHours)
                    {
                        <div class="planning-time-marker"
                             style="@($"--offset:{(hour * 60) - DayStartMinutes};")">
                            @($"{hour:00}:00")
                        </div>
                    }
                </div>
                <div class="planning-grid">
                    @foreach (var hour in DayHours)
                    {
                        <div class="planning-grid-line"
                             style="@($"--offset:{(hour * 60) - DayStartMinutes};")"></div>
                    }
                    @foreach (var lesson in LessonsToday)
                    {
                        <button class="planning-event"
                                type="button"
                                @onclick="() => GoToLesson(lesson.Id)"
                                style="@($"--start:{GetLessonStart(lesson)}; --duration:{lesson.DurationMinutes};")"
                                aria-label="@($"Voir {lesson.Title}")">
                            <div class="planning-event-info">
                                <span class="planning-event-time">@lesson.Time</span>
                                <span class="planning-event-title">@lesson.Title</span>
                                <span class="planning-event-meta">@lesson.Location · @lesson.Trainer</span>
                            </div>
                            <div class="planning-event-progress">
                                <div class="planning-circle"
                                     style="@($"--progress:{GetProgressPercent(lesson.Participants, lesson.MaxParticipants)}%;")"
                                     aria-label="@($"{lesson.Participants}/{lesson.MaxParticipants} participants")">
                                    <span class="planning-circle-value">
                                        @lesson.Participants/@lesson.MaxParticipants
                                    </span>
                                </div>
                            </div>
                        </button>
                    }
                </div>
            </div>
        </FluentCard>

        <FluentCard class="week-card">
            <div class="card-header">
                <h3>Cours cette semaine</h3>
            </div>
            <ul class="lesson-list">
                @foreach (var dayGroup in LessonsWeek.GroupBy(lesson => lesson.Day))
                {
                    <li class="week-day">
                        <div class="week-day-label">@dayGroup.Key</div>
                        <div class="week-day-lessons">
                            @foreach (var lesson in dayGroup)
                            {
                                <button class="lesson-row week-lesson-row"
                                        type="button"
                                        @onclick="() => GoToLesson(lesson.Id)"
                                        aria-label="@($"Voir {lesson.Title}")">
                                    <div class="lesson-info">
                                        <div class="lesson-main">
                                            <span class="lesson-time">@lesson.Time</span>
                                            <span class="lesson-title">@lesson.Title</span>
                                        </div>
                                    </div>
                                    <div class="lesson-progress">
                                        <div class="lesson-participants">
                                            @($"{lesson.Participants}/{lesson.MaxParticipants} participants")
                                        </div>
                                        <div class="lesson-progress-bar"
                                             style="@($"--progress:{GetProgressPercent(lesson.Participants, lesson.MaxParticipants)}%;")">
                                        </div>
                                    </div>
                                </button>
                            }
                        </div>
                    </li>
                }
            </ul>
        </FluentCard>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        BreadcrumbService.SetItems(
        [
            new BreadcrumbItem { IsHome = true, Href = "/" }
        ]);
    }

    private readonly List<LessonItem> LessonsToday = new()
    {
        new LessonItem(1, "06:30", "HIIT Blast", "Studio A", "Coach Maya", 60, 18, 24),
        new LessonItem(2, "12:00", "Mobility Flow", "Studio B", "Coach Lee", 60, 10, 20),
        new LessonItem(3, "18:30", "Power Cycle", "Studio C", "Coach Nora", 60, 22, 24)
    };

    private readonly List<WeeklyLesson> LessonsWeek = new()
    {
        new WeeklyLesson(4, "Lun", "Strength Foundations", "07:15", 14, 20),
        new WeeklyLesson(9, "Lun", "Core Express", "12:30", 16, 18),
        new WeeklyLesson(5, "Mar", "Pilates Core", "18:00", 12, 16),
        new WeeklyLesson(10, "Mar", "Mobility Reset", "20:00", 8, 14),
        new WeeklyLesson(6, "Mer", "Boxing Fundamentals", "19:30", 10, 16),
        new WeeklyLesson(7, "Jeu", "Yoga Restore", "17:15", 14, 20),
        new WeeklyLesson(11, "Jeu", "Strength Lab", "19:00", 18, 22),
        new WeeklyLesson(8, "Ven", "Sprint Intervals", "06:45", 9, 12)
    };

    private void GoToLesson(int lessonId)
    {
        NavManager.NavigateTo($"/lessons/{lessonId}");
    }

    private int DayStartMinutes => GetDayStartMinutes();
    private int DayEndMinutes => GetDayEndMinutes();
    private int DayTotalMinutes => DayEndMinutes - DayStartMinutes;
    private IEnumerable<int> DayHours => Enumerable.Range(GetStartHour(), GetEndHour() - GetStartHour() + 1);

    private int GetLessonStart(LessonItem lesson) => GetMinutes(lesson.Time) - DayStartMinutes;

    private int GetDayStartMinutes()
    {
        if (LessonsToday.Count == 0)
        {
            return 8 * 60;
        }

        var min = LessonsToday.Min(lesson => GetMinutes(lesson.Time));
        return Math.Max(6 * 60, min - 60);
    }

    private int GetDayEndMinutes()
    {
        if (LessonsToday.Count == 0)
        {
            return 20 * 60;
        }

        var max = LessonsToday.Max(lesson => GetMinutes(lesson.Time) + lesson.DurationMinutes);
        return Math.Min(22 * 60, max + 60);
    }

    private int GetStartHour() => DayStartMinutes / 60;
    private int GetEndHour() => (int)Math.Ceiling(DayEndMinutes / 60.0);

    private static int GetMinutes(string time)
    {
        var parsed = TimeSpan.Parse(time);
        return (int)parsed.TotalMinutes;
    }

    private static int GetProgressPercent(int participants, int maxParticipants)
    {
        if (maxParticipants <= 0)
        {
            return 0;
        }

        return Math.Clamp((int)Math.Round((double)participants / maxParticipants * 100), 0, 100);
    }

    private sealed record LessonItem(
        int Id,
        string Time,
        string Title,
        string Location,
        string Trainer,
        int DurationMinutes,
        int Participants,
        int MaxParticipants);

    private sealed record WeeklyLesson(
        int Id,
        string Day,
        string Title,
        string Time,
        int Participants,
        int MaxParticipants);
}
