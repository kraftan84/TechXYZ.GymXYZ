@page "/lessons"
@using FluentValidation
@using MediatR
@using TechXyz.GymXyz.Application.Commands
@using TechXyz.GymXyz.Application.Models
@using TechXyz.GymXyz.Application.Queries
@inject BreadcrumbService BreadcrumbService
@inject NavigationManager NavManager
@inject ISender Sender
@inject IUserFeedbackService UserFeedback

<PageTitle>Cours</PageTitle>

<div class="lessons-page">
    <div class="lessons-header">
        <div class="lessons-title">
            <h1>Cours</h1>
            <p>Gerez les cours, leurs themes et les informations de planning.</p>
        </div>
    </div>

    <div class="lessons-layout">
        <FluentCard class="lessons-card">
            <div class="lessons-card-header">
                <h2>Liste des cours</h2>
                <FluentButton Appearance="Appearance.Accent" @onclick="OpenLessonCreateDrawer">
                    Nouveau cours
                </FluentButton>
            </div>
            <div class="lessons-table">
                <div class="lessons-row lessons-row-header">
                    <span class="lessons-col">Nom</span>
                    <span class="lessons-col">Type</span>
                    <span class="lessons-col">Theme</span>
                    <span class="lessons-col">Coach</span>
                    <span class="lessons-col">Debut</span>
                    <span class="lessons-col">Fin</span>
                </div>
                @foreach (var lesson in lessons)
                {
                    <button class="lessons-row lessons-row-item"
                            type="button"
                            @onclick="() => OpenLessonDetailsDrawer(lesson)"
                            aria-label="@($"Voir {lesson.Name}")">
                        <span class="lessons-col">@lesson.Name</span>
                        <span class="lessons-col">@FormatLessonType(lesson.Type)</span>
                        <span class="lessons-col">@lesson.ThemeName</span>
                        <span class="lessons-col">@FormatCoachName(lesson)</span>
                        <span class="lessons-col">@lesson.StartDate.ToString("dd/MM/yyyy HH:mm")</span>
                        <span class="lessons-col">@lesson.EndDate.ToString("dd/MM/yyyy HH:mm")</span>
                    </button>
                }
            </div>
        </FluentCard>

        <FluentCard class="themes-card">
            <div class="themes-header">
                <h2>Themes de cours</h2>
                <FluentButton Appearance="Appearance.Accent"
                              class="theme-add-button"
                              aria-label="Nouveau theme"
                              @onclick="OpenThemeCreateDrawer">
                    +
                </FluentButton>
            </div>
            <div class="themes-list">
                @foreach (var theme in themes)
                {
                    <button class="theme-item"
                            type="button"
                            @onclick="() => OpenThemeDetailsDrawer(theme)"
                            aria-label="@($"Voir {theme.Name}")">
                        <div class="theme-name">@theme.Name</div>
                        <div class="theme-description">@theme.Description</div>
                    </button>
                }
            </div>
        </FluentCard>
    </div>
</div>

@if (isDrawerOpen)
{
    <DrawerShell DrawerClass="lesson-drawer" Title="@drawerTitle" OnClose="CloseDrawer">
        <ChildContent>
            <div class="drawer-content">
                @if (drawerMode == DrawerMode.LessonDetails && selectedLesson is not null)
                {
                    <div class="drawer-section">
                        <div class="drawer-field">
                            <span class="drawer-label">Nom</span>
                            <span class="drawer-value">@selectedLesson.Name</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Type</span>
                            <span class="drawer-value">@FormatLessonType(selectedLesson.Type)</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Theme</span>
                            <span class="drawer-value">@selectedLesson.ThemeName</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Coach</span>
                            <span class="drawer-value">@FormatCoachName(selectedLesson)</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Debut</span>
                            <span class="drawer-value">@selectedLesson.StartDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Fin</span>
                            <span class="drawer-value">@selectedLesson.EndDate.ToString("dd/MM/yyyy HH:mm")</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Salle</span>
                            <span class="drawer-value">@FormatLessonRooms(selectedLesson)</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Description</span>
                            <span class="drawer-value">@selectedLesson.Description</span>
                        </div>
                    </div>
                }
                else if (drawerMode == DrawerMode.LessonCreate || drawerMode == DrawerMode.LessonEdit)
                {
                    <div class="drawer-form">
                        <FluentTextField Label="Nom" @bind-Value="lessonEditModel.Name" />
                        <FluentTextArea Label="Description" @bind-Value="lessonEditModel.Description" />
                        <div class="drawer-field">
                            <FluentSelect Label="Type"
                                          TOption="string"
                                          Value="@lessonEditModel.Type.ToString()"
                                          ValueChanged="OnLessonTypeChanged"
                                          Disabled="@(drawerMode == DrawerMode.LessonEdit)">
                                <FluentOption TOption="string" Value="@LessonType.Collective.ToString()">Collectif</FluentOption>
                                <FluentOption TOption="string" Value="@LessonType.Private.ToString()">Prive</FluentOption>
                            </FluentSelect>
                        </div>
                        <div class="drawer-field">
                            <FluentSelect Label="Theme"
                                          TOption="string"
                                          Value="@(lessonEditModel.ThemeId?.ToString() ?? string.Empty)"
                                          ValueChanged="OnLessonThemeChanged">
                                <FluentOption TOption="string" Value="">-</FluentOption>
                                @foreach (var theme in themes)
                                {
                                    <FluentOption TOption="string" Value="@theme.Id.ToString()">@theme.Name</FluentOption>
                                }
                            </FluentSelect>
                        </div>
                        <div class="drawer-field">
                            <FluentSelect Label="Coach"
                                          TOption="string"
                                          Value="@lessonEditModel.CoachId.ToString()"
                                          ValueChanged="OnLessonCoachChanged">
                                @foreach (var coach in coaches)
                                {
                                    <FluentOption TOption="string" Value="@coach.Id.ToString()">@($"{coach.FirstName} {coach.LastName}")</FluentOption>
                                }
                            </FluentSelect>
                        </div>
                        <div class="drawer-field">
                            <FluentDatePicker Label="Date de debut" @bind-Value="lessonEditModel.StartDatePart" />
                            <FluentTimePicker Label="Heure de debut" @bind-Value="lessonEditModel.StartTimePart" />
                        </div>
                        <div class="drawer-field">
                            <FluentDatePicker Label="Date de fin" @bind-Value="lessonEditModel.EndDatePart" />
                            <FluentTimePicker Label="Heure de fin" @bind-Value="lessonEditModel.EndTimePart" />
                        </div>
                        <div class="drawer-field">
                            <FluentSelect Label="Salle"
                                          TOption="string"
                                          Value="@lessonEditModel.RoomId.ToString()"
                                          ValueChanged="OnLessonRoomChanged">
                                @foreach (var room in rooms)
                                {
                                    <FluentOption TOption="string" Value="@room.Id.ToString()">@room.Name</FluentOption>
                                }
                            </FluentSelect>
                        </div>
                        @if (lessonEditModel.Type == LessonType.Collective)
                        {
                            <FluentNumberField Label="Capacite max" @bind-Value="lessonEditModel.MaxParticipants" />
                        }
                    </div>
                }
                else if (drawerMode == DrawerMode.ThemeDetails && selectedTheme is not null)
                {
                    <div class="drawer-section">
                        <div class="drawer-field">
                            <span class="drawer-label">Nom</span>
                            <span class="drawer-value">@selectedTheme.Name</span>
                        </div>
                        <div class="drawer-field">
                            <span class="drawer-label">Description</span>
                            <span class="drawer-value">@selectedTheme.Description</span>
                        </div>
                    </div>
                }
                else if (drawerMode == DrawerMode.ThemeCreate || drawerMode == DrawerMode.ThemeEdit)
                {
                    <div class="drawer-form">
                        <FluentTextField Label="Nom" @bind-Value="themeEditModel.Name" />
                        <FluentTextArea Label="Description" @bind-Value="themeEditModel.Description" />
                    </div>
                }
            </div>
        </ChildContent>
        <FooterContent>
            @if (drawerMode == DrawerMode.LessonDetails && selectedLesson is not null)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="OpenLessonPage">
                        Voir la fiche
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Outline" @onclick="OpenLessonEditDrawer">
                        Editer
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="DeleteLessonAsync">
                        Supprimer
                    </FluentButton>
                </div>
            }
            else if (drawerMode == DrawerMode.LessonCreate || drawerMode == DrawerMode.LessonEdit)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="CancelEdit">Annuler</FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="SaveLessonAsync">
                        @(drawerMode == DrawerMode.LessonCreate ? "Creer le cours" : "Enregistrer")
                    </FluentButton>
                </div>
            }
            else if (drawerMode == DrawerMode.ThemeDetails && selectedTheme is not null)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="OpenThemeEditDrawer">
                        Editer
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="DeleteThemeAsync">
                        Supprimer
                    </FluentButton>
                </div>
            }
            else if (drawerMode == DrawerMode.ThemeCreate || drawerMode == DrawerMode.ThemeEdit)
            {
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="CancelEdit">Annuler</FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="SaveThemeAsync">
                        @(drawerMode == DrawerMode.ThemeCreate ? "Creer le theme" : "Enregistrer")
                    </FluentButton>
                </div>
            }
        </FooterContent>
    </DrawerShell>
}

@code {
    private LessonsPageDto? lessonsPage;

    private IReadOnlyList<LessonListItemDto> lessons => lessonsPage?.Lessons ?? new List<LessonListItemDto>();
    private IReadOnlyList<LessonThemeDto> themes => lessonsPage?.Themes ?? new List<LessonThemeDto>();
    private IReadOnlyList<LessonCoachDto> coaches => lessonsPage?.Coaches ?? new List<LessonCoachDto>();
    private IReadOnlyList<RoomDto> rooms => lessonsPage?.Rooms ?? new List<RoomDto>();

    private LessonListItemDto? selectedLesson;
    private LessonThemeDto? selectedTheme;
    private LessonEditModel lessonEditModel = new();
    private ThemeEditModel themeEditModel = new();
    private DrawerMode drawerMode = DrawerMode.None;
    private string drawerTitle = string.Empty;

    private bool isDrawerOpen => drawerMode != DrawerMode.None;

    protected override async Task OnInitializedAsync()
    {
        BreadcrumbService.SetItems(
        [
            new BreadcrumbItem { IsHome = true, Href = "/" },
            new BreadcrumbItem { Text = "Cours" }
        ]);

        await RefreshLessonsPageAsync();
    }

    private async Task RefreshLessonsPageAsync()
    {
        var loaded = false;
        await UserFeedback.ExecuteAsync(async () =>
        {
            lessonsPage = await Sender.Send(new GetLessonsPageQuery());
            loaded = true;
        }, "charger les cours");

        if (!loaded)
        {
            return;
        }

        if (selectedLesson is not null)
        {
            selectedLesson = lessons.FirstOrDefault(lesson => lesson.Id == selectedLesson.Id);
            if (selectedLesson is null && drawerMode is DrawerMode.LessonDetails or DrawerMode.LessonEdit)
            {
                CloseDrawer();
                return;
            }
        }

        if (selectedTheme is not null)
        {
            selectedTheme = themes.FirstOrDefault(theme => theme.Id == selectedTheme.Id);
            if (selectedTheme is null && drawerMode is DrawerMode.ThemeDetails or DrawerMode.ThemeEdit)
            {
                CloseDrawer();
            }
        }
    }

    private void OpenLessonDetailsDrawer(LessonListItemDto lesson)
    {
        selectedLesson = lesson;
        selectedTheme = null;
        drawerMode = DrawerMode.LessonDetails;
        drawerTitle = "Details du cours";
    }

    private void OpenLessonCreateDrawer()
    {
        if (coaches.Count == 0 || rooms.Count == 0)
        {
            return;
        }

        lessonEditModel = new LessonEditModel
        {
            Type = LessonType.Collective,
            CoachId = coaches[0].Id,
            RoomId = rooms[0].Id,
            StartDatePart = DateTime.Now.Date,
            EndDatePart = DateTime.Now.Date,
            StartTimePart = DateTime.Now.Date.AddHours(9),
            EndTimePart = DateTime.Now.Date.AddHours(10),
            MaxParticipants = 12
        };
        selectedLesson = null;
        drawerMode = DrawerMode.LessonCreate;
        drawerTitle = "Nouveau cours";
    }

    private void OpenLessonEditDrawer()
    {
        if (selectedLesson is null)
        {
            return;
        }

        lessonEditModel = new LessonEditModel
        {
            Name = selectedLesson.Name,
            Description = selectedLesson.Description ?? string.Empty,
            Type = selectedLesson.Type,
            ThemeId = selectedLesson.ThemeId,
            CoachId = selectedLesson.CoachId,
            StartDatePart = selectedLesson.StartDate.Date,
            EndDatePart = selectedLesson.EndDate.Date,
            StartTimePart = DateTime.Now.Date.Add(selectedLesson.StartDate.TimeOfDay),
            EndTimePart = DateTime.Now.Date.Add(selectedLesson.EndDate.TimeOfDay),
            RoomId = selectedLesson.Rooms.FirstOrDefault()?.Id ?? rooms.FirstOrDefault()?.Id ?? 0,
            MaxParticipants = selectedLesson.MaxParticipants
        };

        drawerMode = DrawerMode.LessonEdit;
        drawerTitle = "Modifier le cours";
    }

    private async Task SaveLessonAsync()
    {
        if (drawerMode == DrawerMode.LessonCreate)
        {
            await UserFeedback.ExecuteAsync(async () =>
            {
                await Sender.Send(new CreateLessonCommand(
                    lessonEditModel.Name,
                    lessonEditModel.Description,
                    lessonEditModel.Type,
                    lessonEditModel.ThemeId,
                    lessonEditModel.CoachId,
                    BuildDateTime(lessonEditModel.StartDatePart, lessonEditModel.StartTimePart),
                    BuildDateTime(lessonEditModel.EndDatePart, lessonEditModel.EndTimePart),
                    lessonEditModel.RoomId,
                    lessonEditModel.Type == LessonType.Collective ? lessonEditModel.MaxParticipants : null));

                await RefreshLessonsPageAsync();
                CloseDrawer();
            }, "creer le cours", "Cours cree.");
            return;
        }

        if (drawerMode == DrawerMode.LessonEdit && selectedLesson is not null)
        {
            await UserFeedback.ExecuteAsync(async () =>
            {
                var updated = await Sender.Send(new UpdateLessonCommand(
                    selectedLesson.Id,
                    lessonEditModel.Name,
                    lessonEditModel.Description,
                    lessonEditModel.Type,
                    lessonEditModel.ThemeId,
                    lessonEditModel.CoachId,
                    BuildDateTime(lessonEditModel.StartDatePart, lessonEditModel.StartTimePart),
                    BuildDateTime(lessonEditModel.EndDatePart, lessonEditModel.EndTimePart),
                    lessonEditModel.RoomId,
                    lessonEditModel.Type == LessonType.Collective ? lessonEditModel.MaxParticipants : null));
                if (!updated)
                {
                    throw new ValidationException("Cours introuvable.");
                }

                await RefreshLessonsPageAsync();
                selectedLesson = lessons.FirstOrDefault(lesson => lesson.Id == selectedLesson.Id);
                if (selectedLesson is null)
                {
                    CloseDrawer();
                    return;
                }

                drawerMode = DrawerMode.LessonDetails;
                drawerTitle = "Details du cours";
            }, "mettre a jour le cours", "Cours mis a jour.");
        }
    }

    private async Task DeleteLessonAsync()
    {
        if (selectedLesson is null)
        {
            return;
        }

        await UserFeedback.ExecuteAsync(async () =>
        {
            var deleted = await Sender.Send(new DeleteLessonCommand(selectedLesson.Id));
            if (!deleted)
            {
                throw new ValidationException("Cours introuvable.");
            }

            await RefreshLessonsPageAsync();
            CloseDrawer();
        }, "supprimer le cours", "Cours supprime.");
    }

    private void OpenLessonPage()
    {
        if (selectedLesson is null)
        {
            return;
        }

        NavManager.NavigateTo($"/lessons/{selectedLesson.Id}");
    }

    private void OpenThemeDetailsDrawer(LessonThemeDto theme)
    {
        selectedTheme = theme;
        selectedLesson = null;
        drawerMode = DrawerMode.ThemeDetails;
        drawerTitle = "Details du theme";
    }

    private void OpenThemeCreateDrawer()
    {
        themeEditModel = new ThemeEditModel();
        selectedTheme = null;
        drawerMode = DrawerMode.ThemeCreate;
        drawerTitle = "Nouveau theme";
    }

    private void OpenThemeEditDrawer()
    {
        if (selectedTheme is null)
        {
            return;
        }

        themeEditModel = new ThemeEditModel
        {
            Name = selectedTheme.Name,
            Description = selectedTheme.Description ?? string.Empty
        };

        drawerMode = DrawerMode.ThemeEdit;
        drawerTitle = "Modifier le theme";
    }

    private async Task SaveThemeAsync()
    {
        if (drawerMode == DrawerMode.ThemeCreate)
        {
            await UserFeedback.ExecuteAsync(async () =>
            {
                await Sender.Send(new CreateLessonThemeCommand(themeEditModel.Name, themeEditModel.Description));
                await RefreshLessonsPageAsync();
                CloseDrawer();
            }, "creer le theme", "Theme cree.");
            return;
        }

        if (drawerMode == DrawerMode.ThemeEdit && selectedTheme is not null)
        {
            await UserFeedback.ExecuteAsync(async () =>
            {
                var updated = await Sender.Send(new UpdateLessonThemeCommand(
                    selectedTheme.Id,
                    themeEditModel.Name,
                    themeEditModel.Description));
                if (!updated)
                {
                    throw new ValidationException("Theme introuvable.");
                }

                await RefreshLessonsPageAsync();
                selectedTheme = themes.FirstOrDefault(theme => theme.Id == selectedTheme.Id);
                if (selectedTheme is null)
                {
                    CloseDrawer();
                    return;
                }

                drawerMode = DrawerMode.ThemeDetails;
                drawerTitle = "Details du theme";
            }, "mettre a jour le theme", "Theme mis a jour.");
        }
    }

    private async Task DeleteThemeAsync()
    {
        if (selectedTheme is null)
        {
            return;
        }

        await UserFeedback.ExecuteAsync(async () =>
        {
            var deleted = await Sender.Send(new DeleteLessonThemeCommand(selectedTheme.Id));
            if (!deleted)
            {
                throw new ValidationException("Theme introuvable.");
            }

            await RefreshLessonsPageAsync();
            CloseDrawer();
        }, "supprimer le theme", "Theme supprime.");
    }

    private void CancelEdit()
    {
        if (drawerMode == DrawerMode.LessonEdit && selectedLesson is not null)
        {
            drawerMode = DrawerMode.LessonDetails;
            drawerTitle = "Details du cours";
            return;
        }

        if (drawerMode == DrawerMode.ThemeEdit && selectedTheme is not null)
        {
            drawerMode = DrawerMode.ThemeDetails;
            drawerTitle = "Details du theme";
            return;
        }

        CloseDrawer();
    }

    private void CloseDrawer()
    {
        drawerMode = DrawerMode.None;
        selectedLesson = null;
        selectedTheme = null;
        drawerTitle = string.Empty;
    }

    private static string FormatLessonType(LessonType type)
    {
        return type == LessonType.Collective ? "Collectif" : "Prive";
    }

    private static string FormatCoachName(LessonListItemDto lesson)
    {
        return $"{lesson.CoachFirstName} {lesson.CoachLastName}".Trim();
    }

    private static string FormatLessonRooms(LessonListItemDto lesson)
    {
        return lesson.Rooms.Count == 0
            ? "-"
            : string.Join(", ", lesson.Rooms.Select(room => room.Name));
    }

    private static DateTime BuildDateTime(DateTime? datePart, DateTime? timePart)
    {
        var date = (datePart ?? DateTime.Now).Date;
        var time = (timePart ?? DateTime.Now).TimeOfDay;
        return date.Add(time);
    }

    private void OnLessonTypeChanged(string? value)
    {
        if (Enum.TryParse<LessonType>(value, out var type))
        {
            lessonEditModel.Type = type;
        }
    }

    private void OnLessonThemeChanged(string? value)
    {
        lessonEditModel.ThemeId = int.TryParse(value, out var id) ? id : null;
    }

    private void OnLessonCoachChanged(string? value)
    {
        if (int.TryParse(value, out var id))
        {
            lessonEditModel.CoachId = id;
        }
    }

    private void OnLessonRoomChanged(string? value)
    {
        if (int.TryParse(value, out var id))
        {
            lessonEditModel.RoomId = id;
        }
    }

    private enum DrawerMode
    {
        None,
        LessonDetails,
        LessonCreate,
        LessonEdit,
        ThemeDetails,
        ThemeCreate,
        ThemeEdit
    }

    private sealed class LessonEditModel
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public LessonType Type { get; set; } = LessonType.Collective;
        public int? ThemeId { get; set; }
        public int CoachId { get; set; }
        public DateTime? StartDatePart { get; set; }
        public DateTime? EndDatePart { get; set; }
        public DateTime? StartTimePart { get; set; }
        public DateTime? EndTimePart { get; set; }
        public int RoomId { get; set; }
        public int? MaxParticipants { get; set; } = 12;
    }

    private sealed class ThemeEditModel
    {
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
    }
}
