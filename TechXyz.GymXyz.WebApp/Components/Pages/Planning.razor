@page "/planning"
@using MediatR
@using TechXyz.GymXyz.Application.Commands
@using TechXyz.GymXyz.Application.Common
@using TechXyz.GymXyz.Application.Interfaces
@using TechXyz.GymXyz.Application.Queries
@using TechXyz.GymXyz.WebApp.Components.Features.Planning
@implements IDisposable

@inject ISender Sender
@inject IUserFeedbackService UserFeedback
@inject ResponsiveModeService Responsive
@inject ISchoolCalendarService SchoolCalendar

@* Owns the week being shown, the filters, the drawer and every query. The two
   presentations below take parameters only.

   The school calendar is fetched apart from the planning, on purpose: it comes
   from two government APIs, and the grid has to render whether or not they
   answer. The service swallows its own failures, so there is nothing to catch
   here. *@

<PageTitle>Planning</PageTitle>

@if (Responsive.IsMobile)
{
    <PlanningMobile Page="_page"
                    WeekStart="_weekStart"
                    SelectedDay="_selectedDay"
                    Calendar="_calendar"
                    OnPreviousWeek="() => ShiftWeekAsync(-7)"
                    OnNextWeek="() => ShiftWeekAsync(7)"
                    OnCreate="() => OpenCreateDrawer(_selectedDay)"
                    OnSelectDay="SelectDay"
                    OnOpenSession="OpenSessionDrawer"/>
}
else
{
    <div class="gx-screen">
        @if (_dayView is { } day)
        {
            <PlanningDayDesktop Day="day"
                                Sessions="_page.On(day)"
                                Now="DateTime.Now"
                                OnBack="() => _dayView = null"
                                OnCreate="() => OpenCreateDrawer(day)"
                                OnOpenSession="OpenSessionDrawer"/>
        }
        else
        {
            <PlanningDesktop Page="_page"
                             WeekStart="_weekStart"
                             Calendar="_calendar"
                             Filters="_filters"
                             Coaches="_coaches"
                             Locations="_locations"
                             IsSolo="@(Brand?.IsSolo ?? false)"
                             CanBroadcast="User.IsManager"
                             IsBroadcasting="@(_poster?.IsBusy ?? false)"
                             OnBroadcast="BroadcastAsync"
                             OnPreviousWeek="() => ShiftWeekAsync(-7)"
                             OnNextWeek="() => ShiftWeekAsync(7)"
                             OnToday="GoToTodayAsync"
                             OnCreate="() => OpenCreateDrawer(_weekStart)"
                             OnOpenDay="day => _dayView = day"
                             OnOpenSession="OpenSessionDrawer"
                             OnCoachChanged="ApplyCoachAsync"
                             OnLocationChanged="ApplyLocationAsync"
                             OnFormatChanged="ApplyFormatAsync"/>
        }
    </div>
}

<PlanningPosterStage @ref="_poster" OnBusyChanged="() => InvokeAsync(StateHasChanged)"/>

@if (_isDrawerOpen)
{
    <SessionDrawer Model="_editModel"
                   Courses="_courses"
                   Locations="_locations"
                   Coaches="_coaches"
                   IsNew="@(_editModel.Id is null)"
                   IsSaving="_isSaving"
                   OnSave="SaveAsync"
                   OnCancel="CloseDrawer"
                   OnCancelSession="@(_editModel.Id is null ? default : EventCallback.Factory.Create(this, CancelSessionAsync))"/>
}

@code {
    /// <summary>
    /// The day to open on, as the Accueil's week strip passes it —
    /// <c>/planning?jour=2026-08-07</c>. Absent everywhere else, and then the
    /// planning opens on today as it always has.
    /// <para>
    /// A string rather than a <c>DateOnly</c>: the binder would throw on a
    /// hand-typed URL, and a malformed day is not worth an error screen when
    /// "this week" is a perfectly good answer.
    /// </para>
    /// </summary>
    [SupplyParameterFromQuery(Name = "jour")] public string? Day { get; set; }

    private PlanningPosterStage? _poster;

    private WeekPlanningDto _page = WeekPlanningDto.Empty;
    private SchoolCalendarDto _calendar = SchoolCalendarDto.Unavailable("—");
    private readonly PlanningFilterState _filters = new();

    private DateOnly _weekStart = PlanningRules.MondayOf(DateOnly.FromDateTime(DateTime.Today));
    private DateOnly _selectedDay = DateOnly.FromDateTime(DateTime.Today);
    private DateOnly? _dayView;

    private IReadOnlyList<CoachListItemDto> _coaches = [];
    private IReadOnlyList<LocationListItemDto> _locations = [];
    private IReadOnlyList<CourseTemplateListItemDto> _courses = [];

    /// <summary>
    /// Cascaded by TenantBoundary, like every other page. It carries whether the
    /// gym is a solo coach, and the postcode the school zone comes from.
    /// </summary>
    [CascadingParameter] private TenantBrandDto? Brand { get; set; }

    /// <summary>
    /// Cascaded beside it. Read here only to decide whether the « Diffuser »
    /// button belongs on this screen at all.
    /// </summary>
    [CascadingParameter] private GymUserInfo User { get; set; } = GymUserInfo.Anonymous;

    private bool _isDrawerOpen;
    private bool _isSaving;
    private SessionEditModel _editModel = new();

    protected override async Task OnInitializedAsync()
    {
        Responsive.Changed += OnResponsiveChanged;

        ApplyRequestedDay();

        await LoadReferencesAsync();
        await RefreshAsync();
    }

    /// <summary>
    /// Opens on the day the Accueil asked for, week and selection together —
    /// arriving on the right week with the wrong day selected would be the same
    /// bug wearing a hat. Anything unparseable is ignored: today stands.
    /// </summary>
    private void ApplyRequestedDay()
    {
        if (!DateOnly.TryParse(Day, GxFormats.Culture, out var day))
        {
            return;
        }

        _weekStart = PlanningRules.MondayOf(day);
        _selectedDay = day;
    }

    /// <summary>
    /// The pickers and the filter chips. Loaded once — a week of navigation does
    /// not change the catalogue.
    /// </summary>
    private async Task LoadReferencesAsync()
        => await UserFeedback.ExecuteAsync(async () =>
        {
            _coaches = (await Sender.Send(new GetCoachesQuery())).Items;
            _locations = (await Sender.Send(new GetLocationsQuery())).Items;
            _courses = (await Sender.Send(new GetCourseTemplatesQuery())).Items;
        }, "charger le catalogue");

    private async Task RefreshAsync()
    {
        await UserFeedback.ExecuteAsync(async () =>
        {
            _page = await Sender.Send(new GetWeekPlanningQuery(_weekStart)
            {
                CoachId = _filters.CoachId,
                LocationId = _filters.LocationId,
                Format = _filters.Format
            });
        }, "charger le planning");

        await RefreshCalendarAsync();
    }

    /// <summary>
    /// The calendar for the week on screen, minus the school holidays when the
    /// customer has turned them off. Filtered here rather than in the service:
    /// what a gym wants to look at is a matter for the screen, and Réglages
    /// still shows the whole calendar so the setting can preview what it hides.
    /// </summary>
    private async Task RefreshCalendarAsync()
    {
        var calendar = await SchoolCalendar.GetAsync(Brand?.ZipCode, _weekStart, _weekStart.AddDays(6));

        _calendar = Brand?.MarksSchoolVacations == false ? calendar.WithoutVacations() : calendar;
    }

    /// <summary>
    /// The week the arrows have left this screen on — what you see is what you
    /// publish. The filter chips above deliberately do not travel with it: the
    /// image always carries the whole week, and the button says so.
    /// </summary>
    private Task BroadcastAsync() =>
        _poster is null ? Task.CompletedTask : _poster.GenerateAsync(_weekStart);

    private async Task ShiftWeekAsync(int days)
    {
        _weekStart = _weekStart.AddDays(days);
        _dayView = null;

        // Keep the same weekday selected on mobile, which is what the date bar
        // looks like it does.
        _selectedDay = _weekStart.AddDays((_selectedDay.DayNumber - PlanningRules.MondayOf(_selectedDay).DayNumber));

        await RefreshAsync();
    }

    private async Task GoToTodayAsync()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        _weekStart = PlanningRules.MondayOf(today);
        _selectedDay = today;
        _dayView = null;

        await RefreshAsync();
    }

    private void SelectDay(DateOnly day) => _selectedDay = day;

    private async Task ApplyCoachAsync(int? coachId)
    {
        _filters.CoachId = coachId;
        await RefreshAsync();
    }

    private async Task ApplyLocationAsync(int? locationId)
    {
        _filters.LocationId = locationId;
        await RefreshAsync();
    }

    private async Task ApplyFormatAsync(CourseFormat? format)
    {
        _filters.Format = format;
        await RefreshAsync();
    }

    private void OpenCreateDrawer(DateOnly day)
    {
        var course = _courses.FirstOrDefault();

        _editModel = SessionEditModel.ForCreate(
            day,
            course?.Id,
            _filters.LocationId ?? _locations.FirstOrDefault()?.Id);
        _editModel.Capacity = course?.Capacity;

        _isDrawerOpen = true;
    }

    private void OpenSessionDrawer(PlanningSessionDto session)
    {
        _editModel = SessionEditModel.From(session);
        _isDrawerOpen = true;
    }

    private void CloseDrawer()
    {
        _isDrawerOpen = false;
        _isSaving = false;
    }

    private async Task SaveAsync()
    {
        _isSaving = true;

        var saved = await UserFeedback.ExecuteAsync(async () =>
        {
            if (_editModel.Id is { } id)
            {
                await Sender.Send(new UpdateSessionCommand(
                    id,
                    _editModel.LocationId,
                    _editModel.StartsAt,
                    _editModel.CoachId,
                    _editModel.Capacity,
                    _editModel.Scope));
            }
            else
            {
                await Sender.Send(new CreateSessionCommand(
                    _editModel.CourseTemplateId,
                    _editModel.LocationId,
                    _editModel.StartsAt,
                    _editModel.CoachId,
                    _editModel.Capacity,
                    _editModel.RecurrenceWeeks));
            }
        }, _editModel.Id is null ? "programmer le cours" : "modifier la séance",
           _editModel.Id is null ? "Cours programmé." : "Séance modifiée.");

        _isSaving = false;

        if (saved)
        {
            CloseDrawer();
            await RefreshAsync();
        }
    }

    private async Task CancelSessionAsync()
    {
        if (_editModel.Id is not { } id)
        {
            return;
        }

        NotificationOutcomeDto outcome = NotificationOutcomeDto.NotFound;

        var cancelled = await UserFeedback.ExecuteAsync(
            async () => outcome = await Sender.Send(
                new CancelSessionCommand(id, _editModel.CancellationReason, _editModel.Scope)),
            "annuler la séance");

        if (!cancelled)
        {
            return;
        }

        // The cancellation stands whatever the warnings did — say both rather
        // than let a mail failure read as a cancellation that did not happen.
        const string done = "Séance annulée.";

        if (NotificationOutcomeLabels.Warning(outcome, done) is { } warning)
        {
            UserFeedback.ShowPartial(warning);
        }
        else
        {
            UserFeedback.ShowSuccess(NotificationOutcomeLabels.Success(outcome, done));
        }

        CloseDrawer();
        await RefreshAsync();
    }

    private void OnResponsiveChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Responsive.Changed -= OnResponsiveChanged;
}
