@page "/coachs/{CoachId:int}"
@attribute [Authorize(Policy = GymPolicies.GymManager)]
@using FluentValidation
@using MediatR
@using TechXyz.GymXyz.Application.Commands
@using TechXyz.GymXyz.Application.Queries
@using TechXyz.GymXyz.WebApp.Components.Features.Coachs
@implements IDisposable

@inject NavigationManager NavManager
@inject ISender Sender
@inject IUserFeedbackService UserFeedback
@inject ResponsiveModeService Responsive
@inject MobileHeaderService MobileHeader

<PageTitle>@(_coach?.FullName ?? "Coach")</PageTitle>

@if (_isLoading)
{
    <EmptyState Icon="@GxIconPaths.User" Title="Chargement de la fiche…"/>
}
else if (_coach is null)
{
    <EmptyState Icon="@GxIconPaths.User"
                Title="Coach introuvable"
                Text="Cette fiche n'existe plus ou a été désactivée.">
        <FluentButton Appearance="Appearance.Outline" @onclick="GoBackToList">
            Retour aux coachs
        </FluentButton>
    </EmptyState>
}
else if (Responsive.IsMobile)
{
    <CoachDetailsMobile Coach="_coach"
                        OnEdit="OpenEditDrawer"/>
}
else
{
    <div class="gx-screen">
        <CoachDetailsDesktop Coach="_coach"
                             OnEdit="OpenEditDrawer"
                             OnAvailability="OpenEditDrawer"/>
    </div>
}

@if (_coach is not null && _isDrawerOpen)
{
    <CoachDrawer Model="_editModel"
                 Disciplines="_disciplines"
                 IsNew="false"
                 IsSaving="_isSaving"
                 EditingSubtitle="@($"{_coach.FullName} · coach depuis {GxFormats.Month(_coach.JoinedOn)}")"
                 OnSave="SaveCoachAsync"
                 OnCancel="CloseDrawer"
                 OnDelete="DeleteCoachAsync"/>
}

@code {
    // Same rule as the list: a solo tenant has no Coachs section at all.
    [CascadingParameter] private TenantBrandDto? Brand { get; set; }

    [Parameter] public int CoachId { get; set; }


    private CoachDetailsPageDto? _coach;
    private IReadOnlyList<DisciplineDto> _disciplines = [];
    private bool _isLoading = true;
    private bool _isSaving;
    private bool _isDrawerOpen;
    private CoachEditModel _editModel = new();

    protected override void OnInitialized()
    {
        Responsive.Changed += OnShellChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Brand?.IsSolo == true)
        {
            NavManager.NavigateTo("/");

            return;
        }

        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _isLoading = true;

        await UserFeedback.ExecuteAsync(async () =>
        {
            _coach = await Sender.Send(new GetCoachDetailsPageQuery(CoachId));
        }, "charger la fiche du coach");

        _isLoading = false;

        // The mobile shell shows the first name and a back arrow on a record.
        if (_coach is not null)
        {
            MobileHeader.UseSubHeader(_coach.FirstName, GoBackToList);
        }
        else
        {
            MobileHeader.UseRootHeader();
        }
    }

    private void GoBackToList() => NavManager.NavigateTo("/coachs");

    private async Task OpenEditDrawer()
    {
        if (_coach is null)
        {
            return;
        }

        _editModel = CoachEditModel.From(_coach);
        _isDrawerOpen = true;

        if (_disciplines.Count == 0)
        {
            await UserFeedback.ExecuteAsync(async () =>
            {
                _disciplines = await Sender.Send(new GetDisciplinesQuery());
            }, "charger les disciplines");
        }
    }

    private void CloseDrawer()
    {
        _isDrawerOpen = false;
        _isSaving = false;
    }

    private async Task SaveCoachAsync()
    {
        if (_coach is null || _isSaving)
        {
            return;
        }

        _isSaving = true;

        await UserFeedback.ExecuteAsync(async () =>
        {
            var updated = await Sender.Send(new UpdateCoachCommand(
                _coach.Id,
                _editModel.FirstName,
                _editModel.LastName,
                _editModel.Email,
                _editModel.Phone,
                _editModel.Street,
                _editModel.ZipCode,
                _editModel.City,
                _editModel.Country,
                _editModel.RoleLabel,
                _editModel.Bio,
                _editModel.JoinedOnOnly,
                _editModel.AwayUntilOnly,
                _editModel.Availability,
                _editModel.DisciplineIds,
                _editModel.Certifications));

            if (!updated)
            {
                throw new ValidationException("Coach introuvable.");
            }

            CloseDrawer();
            await RefreshAsync();
        }, "mettre à jour le coach", "Coach mis à jour.");

        _isSaving = false;
    }

    private async Task DeleteCoachAsync()
    {
        if (_coach is null)
        {
            return;
        }

        await UserFeedback.ExecuteAsync(async () =>
        {
            var deleted = await Sender.Send(new DeleteCoachCommand(_coach.Id));
            if (!deleted)
            {
                throw new ValidationException("Coach introuvable.");
            }

            CloseDrawer();
            GoBackToList();
        }, "supprimer le coach", "Coach supprimé.");
    }

    private void OnShellChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Responsive.Changed -= OnShellChanged;
        MobileHeader.UseRootHeader();
    }
}
