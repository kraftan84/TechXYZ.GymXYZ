@page "/Error"
@using System.Diagnostics
@inject BreadcrumbService BreadcrumbService

<PageTitle>Erreur</PageTitle>

<FluentCard class="page-card">
    <h1>Erreur.</h1>
    <h2>Une erreur s'est produite lors du traitement de votre demande.</h2>

    @if (ShowRequestId)
    {
        <p>
            <strong>ID de requête :</strong> <code>@RequestId</code>
        </p>
    }

    <h3>Mode développement</h3>
    <p>
        Passer à l'environnement Development affichera des informations plus détaillées sur l'erreur survenue.
    </p>
    <p>
        <strong>L'environnement Development ne doit pas être activé pour les applications déployées.</strong>
        Cela peut entraîner l'affichage d'informations sensibles provenant des exceptions aux utilisateurs finaux.
        Pour le débogage local, activez la variable d'environnement <strong>ASPNETCORE_ENVIRONMENT</strong>
        en <strong>Development</strong> et redémarrez l'application.
    </p>
</FluentCard>

@code{
    [CascadingParameter] private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized()
    {
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
        BreadcrumbService.SetItems(
        [
            new BreadcrumbItem { IsHome = true, Href = "/" },
            new BreadcrumbItem { Text = "Erreur" }
        ]);
    }

}
