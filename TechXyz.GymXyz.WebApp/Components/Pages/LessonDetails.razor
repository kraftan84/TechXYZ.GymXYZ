@page "/lessons/{LessonId:int}"
@inject BreadcrumbService BreadcrumbService

<PageTitle>Cours</PageTitle>

<div class="lesson-details-page">
    <div class="lesson-header">
        <div>
            <h1>@selectedLesson.Name</h1>
            <p>@selectedLesson.Description</p>
        </div>
        <div class="lesson-type-indicator" title="@FormatLessonType(selectedLesson.Type)">
            @if (selectedLesson.Type == LessonType.Collective)
            {
                <FluentIcon Value="@(new Icons.Regular.Size48.PeopleQueue())" />
            }
            else
            {
                <FluentIcon Value="@(new Icons.Regular.Size48.Person())" />
            }
        </div>
    </div>

    <div class="lesson-layout">
        <FluentCard class="lesson-card">
            <h2>Details du cours</h2>
            <div class="detail-list">
                <div class="detail-row">
                    <span class="detail-label">Theme</span>
                    <span class="detail-value">@selectedLesson.Theme?.Name</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Type</span>
                    <span class="detail-value">@FormatLessonType(selectedLesson.Type)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Salles</span>
                    <span class="detail-value">@FormatLessonRooms(selectedLesson)</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Coach principal</span>
                    <span class="detail-value">@FormatCoachName(selectedLesson.Coach)</span>
                </div>
            </div>
        </FluentCard>

        <FluentCard class="lesson-card">
            <h2>Coachs</h2>
            <div class="coach-grid">
                @foreach (var coach in coaches)
                {
                    <a class="coach-card coach-card-link" href="@($"/coachs/{coach.Id}")">
                        <img class="coach-avatar"
                             src="images/avatar-placeholder.svg"
                             alt="@($"Photo de {coach.FirstName} {coach.LastName}")" />
                        <div class="coach-name">@coach.FirstName @coach.LastName</div>
                        @if (coach.Id == selectedLesson.Coach.Id)
                        {
                            <span class="coach-role">Coach principal</span>
                        }
                    </a>
                }
            </div>
        </FluentCard>

        <FluentCard class="lesson-card">
            <div class="members-header">
                <h2>Membres invites</h2>
                <div class="members-summary">@($"{invitedMembers.Count} invites")</div>
            </div>
            <div class="member-add">
                <input class="member-add-input"
                       list="member-suggestions"
                       placeholder="Ajouter un membre..."
                       @bind="addMemberQuery" />
                <datalist id="member-suggestions">
                    @foreach (var member in availableMembers)
                    {
                        <option value="@($"{member.FirstName} {member.LastName}")">@member.Email</option>
                    }
                </datalist>
                <FluentButton Appearance="Appearance.Accent" @onclick="AddMemberToLesson">
                    Ajouter
                </FluentButton>
            </div>
            <div class="members-list">
                @foreach (var invite in invitedMembers)
                {
                    <a class="member-row member-row-link" href="@($"/members/{invite.Member.Id}")">
                        <div class="member-info">
                            <img class="member-avatar"
                                 src="images/avatar-placeholder.svg"
                                 alt="@($"Photo de {invite.Member.FirstName} {invite.Member.LastName}")" />
                            <div>
                                <div class="member-name">@invite.Member.FirstName @invite.Member.LastName</div>
                                <div class="member-meta">@invite.Member.Email</div>
                            </div>
                        </div>
                        <span class="member-status @GetStatusClass(invite.Status)">@GetStatusLabel(invite.Status)</span>
                    </a>
                }
            </div>
        </FluentCard>

        <FluentCard class="lesson-card">
            <h2>Notes coach</h2>
            <p class="notes-hint">Visible par les coachs du cours.</p>
            <textarea class="notes-textarea"
                      rows="6"
                      placeholder="Ajouter des notes pour le cours..."
                      @bind="coachNotes"></textarea>
            <div class="notes-actions">
                <FluentButton Appearance="Appearance.Accent" @onclick="SaveNotes">
                    Enregistrer
                </FluentButton>
            </div>
        </FluentCard>
    </div>
</div>

@code {
    [Parameter]
    public int LessonId { get; set; }

    private readonly List<Coach> coaches =
    [
        new Coach("Nora", "Lemoine")
        {
            Id = 1,
            Email = "nora.lemoine@gymxyz.fr"
        },
        new Coach("Samir", "El Amrani")
        {
            Id = 2,
            Email = "samir.elamrani@gymxyz.fr"
        }
    ];

    private readonly List<InviteStatusItem> invitedMembers =
    [
        new InviteStatusItem(new Member("Camille", "Durand")
        {
            Id = 1,
            Email = "camille.durand@gymxyz.fr"
        }, InviteStatus.Confirmed),
        new InviteStatusItem(new Member("Lucas", "Martin")
        {
            Id = 2,
            Email = "lucas.martin@gymxyz.fr"
        }, InviteStatus.Pending),
        new InviteStatusItem(new Member("Amina", "Benali")
        {
            Id = 3,
            Email = "amina.benali@gymxyz.fr"
        }, InviteStatus.Canceled)
    ];

    private readonly List<Member> availableMembers =
    [
        new Member("Camille", "Durand")
        {
            Id = 1,
            Email = "camille.durand@gymxyz.fr"
        },
        new Member("Lucas", "Martin")
        {
            Id = 2,
            Email = "lucas.martin@gymxyz.fr"
        },
        new Member("Amina", "Benali")
        {
            Id = 3,
            Email = "amina.benali@gymxyz.fr"
        },
        new Member("Julien", "Petit")
        {
            Id = 4,
            Email = "julien.petit@gymxyz.fr"
        }
    ];

    private readonly List<Lesson> lessons;
    private Lesson selectedLesson = default!;
    private string coachNotes = "Objectif: accent sur la technique et la respiration.";
    private string addMemberQuery = string.Empty;

    public LessonDetails()
    {
        lessons =
        [
            new CollectiveLesson
            {
                Id = 1,
                Name = "HIIT Blast",
                Description = "Session intense pour booster le cardio.",
                Type = LessonType.Collective,
                Theme = new LessonTheme("Cardio") { Id = 1 },
                Coach = coaches[0],
                StartDate = DateTime.Today.AddHours(9),
                EndDate = DateTime.Today.AddHours(10),
                MaxParticipants = 16,
                Rooms = new List<Room> { new("Studio A") { Id = 1 } }
            },
            new PrivateLesson
            {
                Id = 2,
                Name = "Coaching Perso",
                Description = "Programme personnalise.",
                Type = LessonType.Private,
                Theme = new LessonTheme("Force") { Id = 2 },
                Coach = coaches[1],
                StartDate = DateTime.Today.AddHours(11),
                EndDate = DateTime.Today.AddHours(12),
                Room = new Room("Studio B") { Id = 2 }
            }
        ];

        selectedLesson = lessons[0];
    }

    protected override void OnParametersSet()
    {
        selectedLesson = lessons.FirstOrDefault(lesson => lesson.Id == LessonId) ?? lessons[0];
        BreadcrumbService.SetItems(
        [
            new BreadcrumbItem { IsHome = true, Href = "/" },
            new BreadcrumbItem { Text = "Cours", Href = "/lessons" },
            new BreadcrumbItem { Text = selectedLesson.Name }
        ]);
    }

    private static string FormatLessonType(LessonType type)
    {
        return type == LessonType.Collective ? "Collectif" : "Prive";
    }

    private static string FormatCoachName(Coach coach)
    {
        return $"{coach.FirstName} {coach.LastName}".Trim();
    }

    private static string FormatLessonRooms(Lesson lesson)
    {
        if (lesson is CollectiveLesson collective)
        {
            return collective.Rooms.Count == 0
                ? "-"
                : string.Join(", ", collective.Rooms.Select(room => room.Name));
        }

        if (lesson is PrivateLesson privateLesson)
        {
            return privateLesson.Room?.Name ?? "-";
        }

        return "-";
    }

    private static string GetStatusLabel(InviteStatus status)
    {
        return status switch
        {
            InviteStatus.Confirmed => "Confirme",
            InviteStatus.Canceled => "Annule",
            _ => "En attente"
        };
    }

    private static string GetStatusClass(InviteStatus status)
    {
        return status switch
        {
            InviteStatus.Confirmed => "status-confirmed",
            InviteStatus.Canceled => "status-canceled",
            _ => "status-pending"
        };
    }

    private void AddMemberToLesson()
    {
        if (string.IsNullOrWhiteSpace(addMemberQuery))
        {
            return;
        }

        var match = availableMembers.FirstOrDefault(member =>
            string.Equals($"{member.FirstName} {member.LastName}", addMemberQuery, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(member.Email, addMemberQuery, StringComparison.OrdinalIgnoreCase));

        if (match is null)
        {
            return;
        }

        if (invitedMembers.Any(invite => invite.Member.Id == match.Id))
        {
            addMemberQuery = string.Empty;
            return;
        }

        invitedMembers.Add(new InviteStatusItem(match, InviteStatus.Pending));
        addMemberQuery = string.Empty;
    }

    private enum InviteStatus
    {
        Pending,
        Confirmed,
        Canceled
    }

    private sealed class InviteStatusItem
    {
        public InviteStatusItem(Member member, InviteStatus status)
        {
            Member = member;
            Status = status;
        }

        public Member Member { get; }
        public InviteStatus Status { get; set; }
    }

    private void SaveNotes()
    {
    }
}
