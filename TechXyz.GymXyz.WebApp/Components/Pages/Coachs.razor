@page "/coachs"
@inject NavigationManager NavManager

<PageTitle>Coachs</PageTitle>

<div class="coachs-page">
    <div class="coachs-header">
        <div class="coachs-title">
            <h1>Coachs</h1>
            <p>Consultez les profils et disponibilites de vos coachs.</p>
        </div>
        <FluentButton Appearance="Appearance.Accent" @onclick="OpenCreateDrawer">
            Nouveau coach
        </FluentButton>
    </div>

    <div class="coach-grid">
        @foreach (var coach in coaches)
        {
            <button class="coach-card" type="button" @onclick="() => OpenDetailsDrawer(coach)">
                <img class="coach-avatar" src="images/avatar-placeholder.svg" alt="@($"Photo de {coach.FirstName} {coach.LastName}")" />
                <div class="coach-name">@coach.FirstName @coach.LastName</div>
                <div class="coach-meta">@coach.Email</div>
                <div class="coach-actions">
                    <span @onclick:stopPropagation="true">
                        <FluentButton Appearance="Appearance.Outline"
                                      Size="ButtonSize.Small"
                                      @onclick="() => GoToCoach(coach)">
                            Details
                        </FluentButton>
                    </span>
                    <span @onclick:stopPropagation="true">
                        <FluentButton Appearance="Appearance.Outline"
                                      Size="ButtonSize.Small"
                                      @onclick="() => OpenEditDrawer(coach)">
                            Editer
                        </FluentButton>
                    </span>
                </div>
            </button>
        }
    </div>
</div>

@if (isDrawerOpen)
{
    <button class="drawer-scrim" type="button" aria-hidden="true" @onclick="CloseDrawer"></button>
    <aside class="coach-drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
        <div class="drawer-header">
            <h2 id="drawer-title">@drawerTitle</h2>
            <FluentButton Appearance="Appearance.Stealth" @onclick="CloseDrawer">Fermer</FluentButton>
        </div>
        <div class="drawer-content">
            @if (drawerMode == DrawerMode.Details && selectedCoach is not null)
            {
                <div class="drawer-profile">
                    <img class="drawer-avatar"
                         src="images/avatar-placeholder.svg"
                         alt="@($"Photo de {selectedCoach.FirstName} {selectedCoach.LastName}")" />
                    <div>
                        <div class="drawer-name">@selectedCoach.FirstName @selectedCoach.LastName</div>
                        <div class="drawer-subtitle">Coach #@selectedCoach.Id</div>
                    </div>
                </div>
                <div class="drawer-section">
                    <div class="drawer-field">
                        <span class="drawer-label">Email</span>
                        <span class="drawer-value">@selectedCoach.Email</span>
                    </div>
                    <div class="drawer-field">
                        <span class="drawer-label">Telephone</span>
                        <span class="drawer-value">@selectedCoach.Phone</span>
                    </div>
                    <div class="drawer-field">
                        <span class="drawer-label">Adresse</span>
                        <span class="drawer-value">@FormatAddress(selectedCoach.Address)</span>
                    </div>
                </div>
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="OpenCoachPage">
                        Voir la fiche
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Outline" @onclick="OpenEditDrawer">
                        Editer
                    </FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="DeleteCoach">
                        Supprimer
                    </FluentButton>
                </div>
            }
            else if (drawerMode == DrawerMode.Create || drawerMode == DrawerMode.Edit)
            {
                <div class="drawer-form">
                    <FluentTextField Label="Prenom" @bind-Value="editModel.FirstName" />
                    <FluentTextField Label="Nom" @bind-Value="editModel.LastName" />
                    <FluentTextField Label="Email" @bind-Value="editModel.Email" />
                    <FluentTextField Label="Telephone" @bind-Value="editModel.Phone" />
                    <FluentTextField Label="Adresse" @bind-Value="editModel.Street" />
                    <FluentTextField Label="Code postal" @bind-Value="editModel.ZipCode" />
                    <FluentTextField Label="Ville" @bind-Value="editModel.City" />
                    <FluentTextField Label="Pays" @bind-Value="editModel.Country" />
                </div>
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="CancelEdit">Annuler</FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="SaveCoach">
                        @(drawerMode == DrawerMode.Create ? "Creer le coach" : "Enregistrer")
                    </FluentButton>
                </div>
            }
        </div>
    </aside>
}

@code {
    private readonly List<Coach> coaches =
    [
        new Coach("Nora", "Lemoine")
        {
            Id = 1,
            Email = "nora.lemoine@gymxyz.fr",
            Phone = "06 11 22 33 44",
            Address = new Address
            {
                Street = "5 rue des Fleurs",
                ZipCode = "69006",
                City = "Lyon",
                Country = "France"
            }
        },
        new Coach("Samir", "El Amrani")
        {
            Id = 2,
            Email = "samir.elamrani@gymxyz.fr",
            Phone = "06 98 76 54 32",
            Address = new Address
            {
                Street = "18 boulevard Lafayette",
                ZipCode = "59000",
                City = "Lille",
                Country = "France"
            }
        },
        new Coach("Juliette", "Moreau")
        {
            Id = 3,
            Email = "juliette.moreau@gymxyz.fr",
            Phone = "07 21 34 55 66",
            Address = new Address
            {
                Street = "2 place Gambetta",
                ZipCode = "33000",
                City = "Bordeaux",
                Country = "France"
            }
        },
        new Coach("Hugo", "Riviere")
        {
            Id = 4,
            Email = "hugo.riviere@gymxyz.fr",
            Phone = "06 45 67 89 01",
            Address = new Address
            {
                Street = "9 avenue Jean Jaures",
                ZipCode = "31000",
                City = "Toulouse",
                Country = "France"
            }
        }
    ];

    private Coach? selectedCoach;
    private CoachEditModel editModel = new();
    private DrawerMode drawerMode = DrawerMode.None;
    private string drawerTitle = string.Empty;

    private bool isDrawerOpen => drawerMode != DrawerMode.None;

    private void OpenDetailsDrawer(Coach coach)
    {
        selectedCoach = coach;
        drawerMode = DrawerMode.Details;
        drawerTitle = "Details du coach";
    }

    private void OpenCreateDrawer()
    {
        editModel = new CoachEditModel();
        drawerMode = DrawerMode.Create;
        drawerTitle = "Nouveau coach";
    }

    private void OpenEditDrawer(Coach coach)
    {
        selectedCoach = coach;
        OpenEditDrawer();
    }

    private void OpenEditDrawer()
    {
        if (selectedCoach is null)
        {
            return;
        }

        editModel = new CoachEditModel
        {
            FirstName = selectedCoach.FirstName,
            LastName = selectedCoach.LastName,
            Email = selectedCoach.Email ?? string.Empty,
            Phone = selectedCoach.Phone ?? string.Empty,
            Street = selectedCoach.Address?.Street ?? string.Empty,
            ZipCode = selectedCoach.Address?.ZipCode ?? string.Empty,
            City = selectedCoach.Address?.City ?? string.Empty,
            Country = selectedCoach.Address?.Country ?? string.Empty
        };

        drawerMode = DrawerMode.Edit;
        drawerTitle = "Modifier le coach";
    }

    private void CloseDrawer()
    {
        drawerMode = DrawerMode.None;
        selectedCoach = null;
        drawerTitle = string.Empty;
    }

    private void CancelEdit()
    {
        if (drawerMode == DrawerMode.Edit && selectedCoach is not null)
        {
            drawerMode = DrawerMode.Details;
            drawerTitle = "Details du coach";
            return;
        }

        CloseDrawer();
    }

    private void SaveCoach()
    {
        if (drawerMode == DrawerMode.Create)
        {
            var newCoach = new Coach(editModel.FirstName, editModel.LastName)
            {
                Id = NextCoachId(),
                Email = string.IsNullOrWhiteSpace(editModel.Email) ? null : editModel.Email,
                Phone = string.IsNullOrWhiteSpace(editModel.Phone) ? null : editModel.Phone,
                Address = BuildAddress(editModel)
            };

            coaches.Add(newCoach);
            CloseDrawer();
            return;
        }

        if (drawerMode == DrawerMode.Edit && selectedCoach is not null)
        {
            selectedCoach.FirstName = editModel.FirstName;
            selectedCoach.LastName = editModel.LastName;
            selectedCoach.Email = string.IsNullOrWhiteSpace(editModel.Email) ? null : editModel.Email;
            selectedCoach.Phone = string.IsNullOrWhiteSpace(editModel.Phone) ? null : editModel.Phone;
            selectedCoach.Address = BuildAddress(editModel);
            drawerMode = DrawerMode.Details;
            drawerTitle = "Details du coach";
        }
    }

    private void DeleteCoach()
    {
        if (selectedCoach is null)
        {
            return;
        }

        coaches.Remove(selectedCoach);
        CloseDrawer();
    }

    private void OpenCoachPage()
    {
        if (selectedCoach is null)
        {
            return;
        }

        NavManager.NavigateTo($"/coachs/{selectedCoach.Id}");
    }

    private void GoToCoach(Coach coach)
    {
        NavManager.NavigateTo($"/coachs/{coach.Id}");
    }

    private static Address? BuildAddress(CoachEditModel model)
    {
        if (string.IsNullOrWhiteSpace(model.Street) &&
            string.IsNullOrWhiteSpace(model.ZipCode) &&
            string.IsNullOrWhiteSpace(model.City) &&
            string.IsNullOrWhiteSpace(model.Country))
        {
            return null;
        }

        return new Address
        {
            Street = model.Street,
            ZipCode = model.ZipCode,
            City = model.City,
            Country = model.Country
        };
    }

    private static string FormatAddress(Address? address)
    {
        if (address is null)
        {
            return "-";
        }

        var parts = new List<string> { address.Street, address.ZipCode, address.City, address.Country }
            .Where(value => !string.IsNullOrWhiteSpace(value));
        return string.Join(", ", parts);
    }

    private int NextCoachId()
    {
        return coaches.Count == 0 ? 1 : coaches.Max(coach => coach.Id) + 1;
    }

    private enum DrawerMode
    {
        None,
        Details,
        Create,
        Edit
    }

    private sealed class CoachEditModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Street { get; set; } = string.Empty;
        public string ZipCode { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string Country { get; set; } = string.Empty;
    }
}
