@page "/coachs"
@attribute [Authorize(Policy = GymPolicies.GymManager)]
@using MediatR
@using TechXyz.GymXyz.Application.Commands
@using TechXyz.GymXyz.Application.Queries
@using TechXyz.GymXyz.WebApp.Components.Features.Coachs
@implements IDisposable

@inject NavigationManager NavManager
@inject ISender Sender
@inject IUserFeedbackService UserFeedback
@inject ResponsiveModeService Responsive

<PageTitle>Coachs</PageTitle>

@* One page, one set of state, two presentations. The queries and the actions
   below are shared; only the markup differs. *@
@if (Responsive.IsMobile)
{
    <CoachsMobile Page="_page"
                  OnOpen="OpenCoach"
                  OnCreate="OpenCreateDrawer"/>
}
else
{
    <div class="gx-screen">
        <CoachsDesktop Page="_page"
                       Search="@_search"
                       Status="_status"
                       SortByFillRate="_sortByFillRate"
                       OnSearchChanged="ApplySearchAsync"
                       OnStatusChanged="ApplyStatusAsync"
                       OnSortByFillRateChanged="ApplySortAsync"
                       OnOpen="OpenCoach"
                       OnCreate="OpenCreateDrawer"/>
    </div>
}

@if (_isDrawerOpen)
{
    <CoachDrawer Model="_editModel"
                 Disciplines="_disciplines"
                 IsNew="true"
                 IsSaving="_isSaving"
                 OnSave="CreateCoachAsync"
                 OnCancel="CloseDrawer"/>
}

@code {
    // A solo coach has no Coachs section: hiding the link is not enough, the
    // route has to refuse too.
    [CascadingParameter] private TenantBrandDto? Brand { get; set; }

    private CoachesPageDto _page = CoachesPageDto.Empty;
    private IReadOnlyList<DisciplineDto> _disciplines = [];

    private string? _search;
    private CoachStatus? _status;
    private bool _sortByFillRate;

    private bool _isDrawerOpen;
    private bool _isSaving;
    private CoachEditModel _editModel = new();

    protected override async Task OnInitializedAsync()
    {
        if (Brand?.IsSolo == true)
        {
            NavManager.NavigateTo("/");

            return;
        }

        Responsive.Changed += OnResponsiveChanged;
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        await UserFeedback.ExecuteAsync(async () =>
        {
            _page = await Sender.Send(new GetCoachesQuery
            {
                Search = _search,
                Status = _status,
                SortByFillRate = _sortByFillRate
            });
        }, "charger la liste des coachs");
    }

    private async Task ApplySearchAsync(string? search)
    {
        _search = string.IsNullOrWhiteSpace(search) ? null : search;
        await RefreshAsync();
    }

    private async Task ApplyStatusAsync(CoachStatus? status)
    {
        _status = status;
        await RefreshAsync();
    }

    private async Task ApplySortAsync(bool sortByFillRate)
    {
        _sortByFillRate = sortByFillRate;
        await RefreshAsync();
    }

    private void OpenCoach(CoachListItemDto coach)
        => NavManager.NavigateTo($"/coachs/{coach.Id}");

    private async Task OpenCreateDrawer()
    {
        _editModel = CoachEditModel.ForCreate();
        _isDrawerOpen = true;

        // Loaded on demand: the picker is the only thing that needs them.
        if (_disciplines.Count == 0)
        {
            await UserFeedback.ExecuteAsync(async () =>
            {
                _disciplines = await Sender.Send(new GetDisciplinesQuery());
            }, "charger les disciplines");
        }
    }

    private void CloseDrawer()
    {
        _isDrawerOpen = false;
        _isSaving = false;
    }

    private async Task CreateCoachAsync()
    {
        if (_isSaving)
        {
            return;
        }

        _isSaving = true;

        await UserFeedback.ExecuteAsync(async () =>
        {
            var createdId = await Sender.Send(new CreateCoachCommand(
                _editModel.FirstName,
                _editModel.LastName,
                _editModel.Email,
                _editModel.Phone,
                _editModel.Street,
                _editModel.ZipCode,
                _editModel.City,
                _editModel.Country,
                _editModel.RoleLabel,
                _editModel.Bio,
                _editModel.JoinedOnOnly,
                _editModel.AwayUntilOnly,
                _editModel.Availability,
                _editModel.DisciplineIds,
                _editModel.Certifications));

            CloseDrawer();
            NavManager.NavigateTo($"/coachs/{createdId}");
        }, "créer le coach", "Coach créé.");

        _isSaving = false;
    }

    private void OnResponsiveChanged() => InvokeAsync(StateHasChanged);

    public void Dispose() => Responsive.Changed -= OnResponsiveChanged;
}
