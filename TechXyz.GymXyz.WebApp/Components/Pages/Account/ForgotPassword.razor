@* Mot de passe oublié. Static server rendering like the rest of /account: this
   posts and redirects, which a circuit cannot do. *@

@page "/account/mot-de-passe-oublie"
@attribute [AllowAnonymous]
@layout EmptyLayout

@using System.ComponentModel.DataAnnotations
@using MediatR
@using TechXyz.GymXyz.Application.Commands
@using TechXyz.GymXyz.WebApp.Components.Features.Account

@inject ISender Sender
@inject NavigationManager Navigation
@inject PasswordResetThrottle Throttle

<PageTitle>Mot de passe oublié</PageTitle>

<AuthShell Compact="true">
    <EditForm Model="Input" method="post" OnValidSubmit="SendLinkAsync" FormName="mot-de-passe-oublie" class="gx-a-form">
        <DataAnnotationsValidator/>

        <a class="gx-link muted" href="/account/connexion">← Revenir à la connexion</a>

        <div>
            <h1 class="gx-a-h">Mot de passe oublié</h1>
            <p class="gx-a-sub">
                Indiquez l'e-mail de votre compte : nous vous envoyons un lien pour en choisir un nouveau.
            </p>
        </div>

        <div class="gx-a-field">
            <label for="email">E-mail</label>
            <FluentTextField id="email" @bind-Value="Input.Email" name="Input.Email"
                             TextFieldType="TextFieldType.Email" AutoComplete="username"
                             Placeholder="prenom@votre-salle.fr"
                             Style="width:100%" Required="true"/>
            <ValidationMessage For="() => Input.Email"/>
        </div>

        <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Style="width:100%">
            Envoyer le lien
        </FluentButton>

        <p class="gx-a-fieldnote">Le lien est valable 30 minutes et ne peut servir qu'une fois.</p>
    </EditForm>
</AuthShell>

@code {
    private ForgotInput? _input;

    [SupplyParameterFromForm]
    private ForgotInput Input
    {
        get => _input ??= new ForgotInput();
        set => _input = value;
    }

    private async Task SendLinkAsync()
    {
        // The whole point of this screen: one answer, always. Whether the address
        // has an account, belongs to another customer, or has had its access
        // withdrawn, the person sees the same next screen. Anything that branched
        // here would be an account-enumeration oracle with a friendly face.
        if (Throttle.TryBegin(Input.Email))
        {
            var resetPageUrl = Navigation.ToAbsoluteUri("/account/reinitialisation").ToString();

            await Sender.Send(new RequestPasswordResetCommand(Input.Email, resetPageUrl));
        }

        Navigation.NavigateTo(
            $"/account/lien-envoye?email={Uri.EscapeDataString(Input.Email)}",
            forceLoad: true);
    }

    private sealed class ForgotInput
    {
        [Required(ErrorMessage = "Saisissez votre e-mail.")]
        [EmailAddress(ErrorMessage = "Cette adresse e-mail n'est pas valide.")]
        public string Email { get; set; } = string.Empty;
    }
}
