@* Entering a customer, as the TechXYZ super-admin.

   Static server rendering, under /account, for the same reason as Connexion:
   this re-signs the authentication cookie, and only a real HTTP response can.
   It also means the antiforgery token is handled by the framework — an EditForm
   with a FormName gets it automatically, so nothing here disables anything.

   The confirmation step is not ceremony. Past this button the admin is looking
   at another company's members, and the trail row is written at that moment:
   worth one deliberate click. *@

@page "/account/client"
@attribute [Authorize(Policy = GymPolicies.PlatformAdmin)]
@layout EmptyLayout

@using MediatR
@using Microsoft.AspNetCore.Identity
@using TechXyz.GymXyz.Application.Commands
@using TechXyz.GymXyz.Application.Queries
@using TechXyz.GymXyz.Persistence.Identity

@inject ISender Sender
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Entrer chez un client</PageTitle>

<div class="gx-account-gate">
    <div class="gx-account-card">
        @if (_target is null)
        {
            <h1>Client introuvable</h1>
            <p class="lead">Ce client n'existe pas ou n'est plus actif.</p>
            <a class="gx-account-back" href="/administration">Revenir à la console</a>
        }
        else
        {
            <span class="gx-account-eyebrow">Console TechXYZ</span>
            <h1>Entrer chez @_target.DisplayName</h1>
            <p class="lead">
                Vous allez voir l'application comme ce client : ses membres, son planning
                et ses encaissements. Votre passage est enregistré.
            </p>

            <EditForm Model="_form" method="post" OnValidSubmit="EnterAsync" FormName="entrer-client">
                <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent">
                    Entrer chez @_target.DisplayName
                </FluentButton>
            </EditForm>

            <a class="gx-account-back" href="/administration">Annuler</a>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "client")] private int TenantId { get; set; }

    /// <summary>
    /// EditForm needs a model even when the form has no field. Deliberately not
    /// [SupplyParameterFromForm]: with nothing to bind, the post would overwrite
    /// this with null and EditForm would throw — the same trap BL0008 warns
    /// about on the Connexion form.
    /// </summary>
    private readonly object _form = new();

    private TenantBrandDto? _target;

    protected override async Task OnInitializedAsync()
    {
        // Read for the confirmation copy only. Nothing is granted here — the
        // command re-checks the customer before it opens anything.
        _target = await Sender.Send(new GetTenantBrandByIdQuery(TenantId));
    }

    private async Task EnterAsync()
    {
        var state = await AuthenticationStateProvider.GetAuthenticationStateAsync();

        if (await UserManager.GetUserAsync(state.User) is not { } admin)
        {
            Navigation.NavigateTo("/account/connexion", forceLoad: true);

            return;
        }

        var visit = await Sender.Send(new BeginTenantImpersonationCommand(
            admin.Id,
            admin.Email ?? admin.UserName ?? admin.Id,
            TenantId));

        if (visit is null)
        {
            Navigation.NavigateTo("/administration", forceLoad: true);

            return;
        }

        // Added on top of what the claims factory generates. The factory writes
        // no tenant for a platform admin, so these are the only tenant claims on
        // the principal and nothing has to be stripped first.
        await SignInManager.SignInWithClaimsAsync(admin, isPersistent: false,
        [
            new Claim(GymClaimTypes.TenantId, visit.TenantId.ToString()),
            new Claim(GymClaimTypes.TenantSlug, visit.Slug),
            new Claim(GymClaimTypes.Impersonation, visit.VisitId.ToString())
        ]);

        // A full load, not a navigation: the theme is painted server-side from
        // the cookie, and the circuit has to be rebuilt as somebody else.
        Navigation.NavigateTo("/", forceLoad: true);
    }
}
