@* Mot de passe modifié. *@

@page "/account/mot-de-passe-modifie"
@attribute [AllowAnonymous]
@layout EmptyLayout

@using TechXyz.GymXyz.WebApp.Components.Features.Account

<PageTitle>Mot de passe modifié</PageTitle>

<AuthShell Compact="true">
    <div class="gx-a-form gx-a-center">
        <div class="gx-a-big ok"><GxIcon Name="check" Size="34"/></div>

        <div>
            <h1 class="gx-a-h">Mot de passe modifié</h1>
            @* The second sentence is a promise the server keeps: resetting rolls
               the security stamp, and the cookie validation interval is a minute,
               so the other sessions really do fall. *@
            <p class="gx-a-sub">
                Vous pouvez vous connecter avec votre nouveau mot de passe.
                <b>Les autres appareils ont été déconnectés.</b>
            </p>
        </div>

        <FluentAnchor Href="/account/connexion" Appearance="Appearance.Accent" Style="width:100%">
            Se connecter
        </FluentAnchor>
    </div>
</AuthShell>
