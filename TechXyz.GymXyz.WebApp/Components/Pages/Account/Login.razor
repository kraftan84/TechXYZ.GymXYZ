@* Connexion. Static server rendering: SignInManager needs a real HTTP response
   to write the authentication cookie — a circuit cannot. *@

@page "/account/connexion"
@attribute [AllowAnonymous]
@layout EmptyLayout

@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Identity
@using TechXyz.GymXyz.Persistence.Identity
@using TechXyz.GymXyz.WebApp.Components.Features.Account

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager Navigation

<PageTitle>Connexion</PageTitle>

<AuthShell>
    <EditForm Model="Input" method="post" OnValidSubmit="SignInAsync" FormName="connexion" class="gx-a-form">
        <DataAnnotationsValidator/>

        <div>
            <h1 class="gx-a-h">Connexion</h1>
            <p class="gx-a-sub">Accédez à votre tableau de bord.</p>
        </div>

        @if (IsSuspended)
        {
            <div class="gx-a-err" role="alert">
                <GxIcon Name="alert" Size="18" Class="ic"/>
                <span>
                    L'accès à cet espace est suspendu. Contactez GymXYZ au 04 50 00 00 00
                    ou à support@gymxyz.fr pour le rouvrir.
                </span>
            </div>
        }
        else if (!string.IsNullOrEmpty(_errorMessage))
        {
            <div class="gx-a-err" role="alert">
                <GxIcon Name="alert" Size="18" Class="ic"/>
                <span>@_errorMessage</span>
            </div>
        }

        <div class="gx-a-field">
            <label for="email">E-mail</label>
            <FluentTextField id="email" @bind-Value="Input.Email" name="Input.Email"
                             TextFieldType="TextFieldType.Email" AutoComplete="username"
                             Placeholder="prenom@votre-salle.fr"
                             Style="width:100%" Required="true"/>
            <ValidationMessage For="() => Input.Email"/>
        </div>

        <div class="gx-a-pw">
            <div class="gx-a-field">
                <label for="password">Mot de passe</label>
                <FluentTextField id="password" @bind-Value="Input.Password" name="Input.Password"
                                 TextFieldType="TextFieldType.Password" AutoComplete="current-password"
                                 Placeholder="••••••••••"
                                 Style="width:100%" Required="true"/>
                <ValidationMessage For="() => Input.Password"/>
            </div>
            @* Wired by gx-auth.js: this page renders statically, so there is no
               circuit to handle a click. *@
            <button type="button" class="gx-a-eye" aria-label="Afficher" aria-pressed="false">
                <GxIcon Name="eye" Size="18"/>
            </button>
        </div>

        <div class="gx-a-row">
            <FluentCheckbox @bind-Value="Input.RememberMe" name="Input.RememberMe" Label="Rester connecté"/>
            <a class="gx-link" href="/account/mot-de-passe-oublie">Mot de passe oublié ?</a>
        </div>

        <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Style="width:100%" Disabled="IsSuspended">
            Se connecter
        </FluentButton>

        <div class="gx-a-hr">ou</div>

        @if (IsGymXyz)
        {
            <p class="gx-a-tail">
                Vous découvrez GymXYZ ?<br/>
                <a class="gx-link" href="/demande-ouverture">Demander l'ouverture d'un espace</a>
            </p>
        }
        else
        {
            @* No sign-up link on a customer's screen: a member does not open a
               space, and the people who run this one already have accounts. *@
            <p class="gx-a-tail">
                Vous êtes membre de @(Brand?.DisplayName ?? "cette salle") ?
                Connectez-vous depuis l'application mobile, avec le lien reçu par e-mail.
            </p>
        }

        <p class="gx-a-help">
            Besoin d'aide ? <a href="mailto:support@gymxyz.fr">support@gymxyz.fr</a> · 04 50 00 00 00
        </p>
    </EditForm>
</AuthShell>

@code {
    [CascadingParameter] private TenantBrandDto? Brand { get; set; }

    // No initialiser: a post that binds nothing writes null straight over it
    // (BL0008). The backing field is what carries the default instead, so the
    // form always has a model whether or not the post carried one.
    private LoginInput? _input;

    [SupplyParameterFromForm]
    private LoginInput Input
    {
        get => _input ??= new LoginInput();
        set => _input = value;
    }

    [SupplyParameterFromQuery] private string? ReturnUrl { get; set; }

    private string? _errorMessage;

    private bool IsGymXyz => (Brand?.ThemeKey ?? "techxyz") == "techxyz";

    private bool IsSuspended => Brand?.IsSuspended == true;

    private async Task SignInAsync()
    {
        // Refused before the password is even checked: the space is closed, and
        // letting a correct password through to a dead space would be worse than
        // saying so. It closes the door on everybody, TechXYZ included — a
        // platform admin signs in on the platform's own host, never through a
        // customer's, so this is not the way they reach a suspended customer.
        if (IsSuspended)
        {
            return;
        }

        var result = await SignInManager.PasswordSignInAsync(
            Input.Email, Input.Password, Input.RememberMe, lockoutOnFailure: true);

        if (result.Succeeded)
        {
            Navigation.NavigateTo(ReturnUrl ?? "/", forceLoad: true);

            return;
        }

        _errorMessage = result.IsLockedOut
            ? await LockoutMessageAsync()
            : "E-mail ou mot de passe incorrect.";
    }

    /// <summary>
    /// Locked out and revoked are the same column in Identity — <c>RevokeAsync</c>
    /// writes the far end of time where five bad tries write a quarter of an hour.
    /// Told apart here, because "réessayez dans 12 minutes" to somebody whose
    /// access was withdrawn sends them back every quarter of an hour forever.
    /// </summary>
    private async Task<string> LockoutMessageAsync()
    {
        var user = await UserManager.FindByEmailAsync(Input.Email);

        if (user is not null && UserDirectory.IsRevoked(user))
        {
            return "Cet accès a été retiré. Contactez la personne qui gère votre espace.";
        }

        var remaining = user?.LockoutEnd is { } end
            ? (int)Math.Ceiling((end - DateTimeOffset.UtcNow).TotalMinutes)
            : 15;

        var minutes = Math.Clamp(remaining, 1, 15);

        return $"Trop de tentatives. Réessayez dans {minutes} minute{(minutes > 1 ? "s" : string.Empty)}.";
    }

    private sealed class LoginInput
    {
        [Required(ErrorMessage = "Saisissez votre e-mail.")]
        [EmailAddress(ErrorMessage = "Cette adresse e-mail n'est pas valide.")]
        public string Email { get; set; } = string.Empty;

        [Required(ErrorMessage = "Saisissez votre mot de passe.")]
        public string Password { get; set; } = string.Empty;

        public bool RememberMe { get; set; } = true;
    }
}
