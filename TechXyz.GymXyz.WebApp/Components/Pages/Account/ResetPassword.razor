@* Nouveau mot de passe. The link in the e-mail is the authentication: the token
   in the query is what says this person may set a password, so a missing or
   spent one is the only thing this screen refuses. *@

@page "/account/reinitialisation"
@attribute [AllowAnonymous]
@layout EmptyLayout

@using System.ComponentModel.DataAnnotations
@using MediatR
@using TechXyz.GymXyz.Application.Commands
@using TechXyz.GymXyz.WebApp.Components.Features.Account

@inject ISender Sender
@inject NavigationManager Navigation

<PageTitle>Nouveau mot de passe</PageTitle>

<AuthShell Compact="true">
    @if (_linkIsDead)
    {
        <div class="gx-a-form gx-a-center">
            <div class="gx-a-big"><GxIcon Name="alert" Size="32"/></div>

            <div>
                <h1 class="gx-a-h">Ce lien n'est plus valable.</h1>
                <p class="gx-a-sub">
                    Un lien de réinitialisation dure 30 minutes et ne sert qu'une fois.
                    Demandez-en un nouveau pour continuer.
                </p>
            </div>

            <a class="gx-link" href="/account/mot-de-passe-oublie">Demander un nouveau lien</a>
            <a class="gx-link muted" href="/account/connexion">← Revenir à la connexion</a>
        </div>
    }
    else
    {
        <EditForm Model="Input" method="post" OnValidSubmit="SaveAsync" FormName="reinitialisation" class="gx-a-form">
            <DataAnnotationsValidator/>

            <div>
                <h1 class="gx-a-h">Nouveau mot de passe</h1>
                <p class="gx-a-sub">Choisissez-en un que vous n'utilisez pas ailleurs.</p>
            </div>

            @if (_errors.Count > 0)
            {
                <div class="gx-a-err" role="alert">
                    <GxIcon Name="alert" Size="18" Class="ic"/>
                    <span>
                        @foreach (var error in _errors)
                        {
                            <span>@error</span>
                            <br/>
                        }
                    </span>
                </div>
            }

            <div class="gx-a-pw">
                <div class="gx-a-field">
                    <label for="password">Mot de passe</label>
                    <FluentTextField id="password" @bind-Value="Input.Password" name="Input.Password"
                                     TextFieldType="TextFieldType.Password" AutoComplete="new-password"
                                     Placeholder="••••••••••"
                                     Style="width:100%" Required="true"/>
                </div>
                <button type="button" class="gx-a-eye" aria-label="Afficher" aria-pressed="false">
                    <GxIcon Name="eye" Size="18"/>
                </button>
            </div>

            @* Painted by gx-auth.js from the field just above it. Its first
               segment rewards 12 characters, the same number the note and the
               server's PasswordOptions use — the hand-off's gauge counted from 8
               while its own note said 12, and a gauge that disagrees with the
               rule teaches the wrong rule. *@
            <div class="gx-a-strength" aria-hidden="true"><i></i><i></i><i></i></div>

            <p class="gx-a-fieldnote">
                12 caractères minimum, avec majuscules, minuscules et un chiffre.
            </p>

            <div class="gx-a-pw">
                <div class="gx-a-field">
                    <label for="confirm">Confirmation</label>
                    <FluentTextField id="confirm" @bind-Value="Input.Confirmation" name="Input.Confirmation"
                                     TextFieldType="TextFieldType.Password" AutoComplete="new-password"
                                     Placeholder="••••••••••"
                                     Style="width:100%" Required="true"/>
                    <ValidationMessage For="() => Input.Confirmation"/>
                </div>
                <button type="button" class="gx-a-eye" aria-label="Afficher" aria-pressed="false">
                    <GxIcon Name="eye" Size="18"/>
                </button>
            </div>

            <FluentButton Type="ButtonType.Submit" Appearance="Appearance.Accent" Style="width:100%">
                Enregistrer le mot de passe
            </FluentButton>

            <a class="gx-link muted" href="/account/connexion">Annuler</a>
        </EditForm>
    }
</AuthShell>

@code {
    [SupplyParameterFromQuery] private string? Email { get; set; }

    [SupplyParameterFromQuery] private string? Token { get; set; }

    private ResetInput? _input;

    [SupplyParameterFromForm]
    private ResetInput Input
    {
        get => _input ??= new ResetInput();
        set => _input = value;
    }

    private IReadOnlyList<string> _errors = [];
    private bool _linkIsDead;

    protected override void OnParametersSet()
    {
        // A hand-typed URL, a truncated link in a mail client, an old bookmark:
        // all the same screen as an expired token, and it costs nothing to say so
        // before the person has typed a password twice for nothing.
        _linkIsDead = string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token);
    }

    private async Task SaveAsync()
    {
        // The query survives the post through the form's action, but a missing
        // token here would otherwise reach the handler as an empty string and
        // come back as a puzzling refusal.
        if (string.IsNullOrWhiteSpace(Email) || string.IsNullOrWhiteSpace(Token))
        {
            _linkIsDead = true;

            return;
        }

        var outcome = await Sender.Send(new ResetPasswordCommand(Email, Token, Input.Password));

        if (outcome.Succeeded)
        {
            Navigation.NavigateTo("/account/mot-de-passe-modifie", forceLoad: true);

            return;
        }

        if (outcome.LinkNoLongerValid)
        {
            _linkIsDead = true;

            return;
        }

        // Identity's own words: it is the thing that actually applied the rule,
        // and re-wording it here is how a screen ends up promising one rule while
        // the server enforces another.
        _errors = outcome.PasswordErrors;
    }

    private sealed class ResetInput
    {
        [Required(ErrorMessage = "Choisissez un mot de passe.")]
        public string Password { get; set; } = string.Empty;

        [Required(ErrorMessage = "Confirmez le mot de passe.")]
        [Compare(nameof(Password), ErrorMessage = "Les deux mots de passe ne sont pas identiques.")]
        public string Confirmation { get; set; } = string.Empty;
    }
}
