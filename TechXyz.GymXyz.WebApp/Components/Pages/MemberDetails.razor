@page "/members/{MemberId:int}"
@using FluentValidation
@using MediatR
@using TechXyz.GymXyz.Application.Commands
@using TechXyz.GymXyz.Application.Queries
@using TechXyz.GymXyz.WebApp.Components.Features.Members
@implements IDisposable

@inject NavigationManager NavManager
@inject ISender Sender
@inject IUserFeedbackService UserFeedback
@inject ResponsiveModeService Responsive
@inject MobileHeaderService MobileHeader

<PageTitle>@(_member?.FullName ?? "Membre")</PageTitle>

@if (_isLoading)
{
    <EmptyState Icon="@GxIconPaths.Users" Title="Chargement de la fiche…"/>
}
else if (_member is null)
{
    <EmptyState Icon="@GxIconPaths.Users"
                Title="Membre introuvable"
                Text="Cette fiche n'existe plus ou a été désactivée.">
        <FluentButton Appearance="Appearance.Outline" @onclick="GoBackToList">
            Retour aux membres
        </FluentButton>
    </EmptyState>
}
else if (Responsive.IsMobile)
{
    <MemberDetailsMobile Member="_member"
                         Today="_today"
                         OnEdit="OpenEditDrawer"
                         OnHistory="OpenSubscriptionsDrawer"/>
}
else
{
    <div class="gx-screen">
        <MemberDetailsDesktop Member="_member"
                              Today="_today"
                              OnEdit="OpenEditDrawer"
                              OnMessage="SendMessage"
                              OnRenew="OpenRenewDrawer"
                              OnHistory="OpenSubscriptionsDrawer"/>
    </div>
}

@if (_member is not null && _drawer == DrawerMode.Edit)
{
    <MemberDrawer Model="_editModel"
                  IsNew="false"
                  IsSaving="_isSaving"
                  EditingSubtitle="@($"{_member.FullName} · membre depuis {GxFormats.Month(_member.JoinedOn)}")"
                  OnSave="SaveMemberAsync"
                  OnCancel="CloseDrawer"
                  OnDelete="DeleteMemberAsync"/>
}

@if (_member is not null && _drawer is DrawerMode.Subscriptions or DrawerMode.Renew)
{
    <MemberSubscriptionsDrawer Subscriptions="_member.Subscriptions"
                               Plans="_plans"
                               CurrentSubscription="_member.CurrentSubscription"
                               Subtitle="@_member.FullName"
                               StartOnNew="@(_drawer == DrawerMode.Renew)"
                               OnClose="CloseDrawer"
                               OnCreate="AssignSubscriptionAsync"
                               OnRenew="RenewSubscriptionAsync"
                               OnDelete="DeleteSubscriptionAsync"/>
}

@code {
    private enum DrawerMode
    {
        None,
        Edit,
        Subscriptions,
        Renew
    }

    [Parameter] public int MemberId { get; set; }

    private readonly DateOnly _today = DateOnly.FromDateTime(DateTime.Today);

    private MemberDetailsPageDto? _member;
    private IReadOnlyList<PlanDto> _plans = [];
    private bool _isLoading = true;
    private bool _isSaving;
    private DrawerMode _drawer = DrawerMode.None;
    private MemberEditModel _editModel = new();

    protected override void OnInitialized()
    {
        Responsive.Changed += OnShellChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        await RefreshAsync();
    }

    private async Task RefreshAsync()
    {
        _isLoading = true;

        await UserFeedback.ExecuteAsync(async () =>
        {
            _member = await Sender.Send(new GetMemberDetailsPageQuery(MemberId));

            // The formules the drawer sells from. Loaded with the record rather
            // than when the drawer opens, so pressing "Renouveler" does not wait
            // on a second round trip before it can show anything.
            _plans = await Sender.Send(new GetPlansQuery());
        }, "charger la fiche du membre");

        _isLoading = false;

        // The mobile shell shows the first name and a back arrow on a record.
        if (_member is not null)
        {
            MobileHeader.UseSubHeader(_member.FirstName, GoBackToList);
        }
        else
        {
            MobileHeader.UseRootHeader();
        }
    }

    private void GoBackToList() => NavManager.NavigateTo("/members");

    private void SendMessage()
    {
        if (_member?.Email is { } email)
        {
            NavManager.NavigateTo($"mailto:{email}", forceLoad: true);
        }
    }

    private void OpenEditDrawer()
    {
        if (_member is null)
        {
            return;
        }

        _editModel = new MemberEditModel
        {
            FirstName = _member.FirstName,
            LastName = _member.LastName,
            Email = _member.Email,
            Phone = _member.Phone,
            BirthDate = _member.BirthDate?.ToDateTime(TimeOnly.MinValue),
            JoinedOn = _member.JoinedOn.ToDateTime(TimeOnly.MinValue),
            Notes = _member.Notes,
            Street = _member.Address?.Street,
            ZipCode = _member.Address?.ZipCode,
            City = _member.Address?.City,
            Country = _member.Address?.Country
        };

        _drawer = DrawerMode.Edit;
    }

    private void OpenSubscriptionsDrawer() => _drawer = DrawerMode.Subscriptions;

    private void OpenRenewDrawer() => _drawer = DrawerMode.Renew;

    private void CloseDrawer()
    {
        _drawer = DrawerMode.None;
        _isSaving = false;
    }

    private async Task SaveMemberAsync()
    {
        if (_member is null || _isSaving)
        {
            return;
        }

        _isSaving = true;

        await UserFeedback.ExecuteAsync(async () =>
        {
            var updated = await Sender.Send(new UpdateMemberCommand(
                _member.Id,
                _editModel.FirstName,
                _editModel.LastName,
                _editModel.Email,
                _editModel.Phone,
                _editModel.Street,
                _editModel.ZipCode,
                _editModel.City,
                _editModel.Country,
                _editModel.JoinedOnOnly,
                _editModel.BirthDateOnly,
                _editModel.Notes));

            if (!updated)
            {
                throw new ValidationException("Membre introuvable.");
            }

            CloseDrawer();
            await RefreshAsync();
        }, "mettre à jour le membre", "Membre mis à jour.");

        _isSaving = false;
    }

    private async Task DeleteMemberAsync()
    {
        if (_member is null)
        {
            return;
        }

        await UserFeedback.ExecuteAsync(async () =>
        {
            var deleted = await Sender.Send(new DeleteMemberCommand(_member.Id));
            if (!deleted)
            {
                throw new ValidationException("Membre introuvable.");
            }

            CloseDrawer();
            GoBackToList();
        }, "supprimer le membre", "Membre supprimé.");
    }

    private async Task AssignSubscriptionAsync(MemberSubscriptionsDrawer.SubscriptionInput input)
    {
        if (_member is null)
        {
            return;
        }

        await UserFeedback.ExecuteAsync(async () =>
        {
            await Sender.Send(new AssignSubscriptionCommand(
                _member.Id,
                input.PlanId,
                input.StartedOn,
                input.AutoRenew));

            await RefreshAsync();
        }, "créer l'abonnement", "Abonnement créé.");
    }

    private async Task RenewSubscriptionAsync(int subscriptionId)
    {
        await UserFeedback.ExecuteAsync(async () =>
        {
            var renewed = await Sender.Send(new RenewSubscriptionCommand(subscriptionId));
            if (renewed is null)
            {
                throw new ValidationException("Abonnement introuvable.");
            }

            await RefreshAsync();
        }, "renouveler l'abonnement", "Abonnement renouvelé.");
    }

    private async Task DeleteSubscriptionAsync(int subscriptionId)
    {
        await UserFeedback.ExecuteAsync(async () =>
        {
            var deleted = await Sender.Send(new DeleteSubscriptionCommand(subscriptionId));
            if (!deleted)
            {
                throw new ValidationException("Abonnement introuvable.");
            }

            await RefreshAsync();
        }, "supprimer l'abonnement", "Abonnement supprimé.");
    }

    private void OnShellChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        Responsive.Changed -= OnShellChanged;
        MobileHeader.UseRootHeader();
    }
}
