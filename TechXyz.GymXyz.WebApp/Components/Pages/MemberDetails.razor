@page "/members/{MemberId:int}"
@inject BreadcrumbService BreadcrumbService

<PageTitle>Membre</PageTitle>

<div class="member-details-page">
    <div class="member-header">
        <div class="member-identity">
            <img class="member-avatar"
                 src="images/avatar-placeholder.svg"
                 alt="@($"Photo de {selectedMember.FirstName} {selectedMember.LastName}")" />
            <div>
                <h1>@selectedMember.FirstName @selectedMember.LastName</h1>
                <p>@selectedMember.Email · @selectedMember.Phone</p>
            </div>
        </div>
    </div>

    <div class="member-layout">
        <FluentCard class="member-card">
            <div class="card-header">
                <h2>Informations</h2>
                <FluentButton Appearance="Appearance.Outline" @onclick="OpenEditDrawer">
                    Editer
                </FluentButton>
            </div>
            <div class="detail-list">
                <div class="detail-row">
                    <span class="detail-label">Email</span>
                    <span class="detail-value">@selectedMember.Email</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Telephone</span>
                    <span class="detail-value">@selectedMember.Phone</span>
                </div>
                <div class="detail-row">
                    <span class="detail-label">Adresse</span>
                    <span class="detail-value">@FormatAddress(selectedMember.Address)</span>
                </div>
            </div>
        </FluentCard>

        <FluentCard class="member-card">
            <h2>Statistiques</h2>
            <div class="kpi-grid">
                <div class="kpi-card">
                    <div class="kpi-label">Seances totales</div>
                    <div class="kpi-content">
                        <div class="kpi-value">@memberStats.TotalLessons</div>
                    </div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">Taux de presence</div>
                    <div class="kpi-content">
                        <div class="progress-ring" style="--progress:@memberStats.AttendanceRate;">
                            <span>@($"{memberStats.AttendanceRate}%")</span>
                        </div>
                    </div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">Derniere visite</div>
                    <div class="kpi-content">
                        <div class="kpi-value">@memberStats.LastVisit.ToString("dd/MM/yyyy")</div>
                    </div>
                </div>
                <div class="kpi-card">
                    <div class="kpi-label">Abonnement restant</div>
                    <div class="kpi-content">
                        <div class="progress-ring" style="--progress:@memberStats.SubscriptionRemainingPercent;">
                            <span>@($"{memberStats.SubscriptionRemainingPercent}%")</span>
                        </div>
                    </div>
                </div>
            </div>
        </FluentCard>

        <FluentCard class="member-card">
            <div class="card-header">
                <h2>Abonnements</h2>
                <FluentButton Appearance="Appearance.Accent" @onclick="OpenSubscriptionCreateDrawer">
                    + Ajouter
                </FluentButton>
            </div>
            <div class="subscription-list">
                @foreach (var subscription in subscriptions)
                {
                    <button class="subscription-item" type="button" @onclick="() => OpenSubscriptionDetailsDrawer(subscription)">
                        <div class="subscription-main">
                            <div class="subscription-name">@GetSubscriptionTitle(subscription)</div>
                            <div class="subscription-dates">
                                @FormatDate(subscription.StartDate) - @FormatDate(subscription.EndDate)
                            </div>
                            <div class="subscription-lessons">
                                @subscription.LessonsRemaining / @subscription.LessonsTotal seances restantes
                            </div>
                            <div class="progress-bar" role="progressbar"
                                 aria-valuemin="0"
                                 aria-valuemax="100"
                                 aria-valuenow="@GetLessonsRemainingPercent(subscription)"
                                 style="--progress:@GetLessonsRemainingPercent(subscription);">
                                <span></span>
                            </div>
                        </div>
                        <span class="subscription-status @GetSubscriptionStatusClass(subscription.Status)">
                            @GetSubscriptionStatusLabel(subscription.Status)
                        </span>
                    </button>
                }
            </div>
        </FluentCard>

        <FluentCard class="member-card">
            <h2>Cours et invitations</h2>
            <div class="lesson-list">
                @foreach (var item in memberLessons)
                {
                    <a class="lesson-item lesson-item-link" href="@($"/lessons/{item.Lesson.Id}")">
                        <div>
                            <div class="lesson-title">@item.Lesson.Name</div>
                            <div class="lesson-meta">@FormatLessonDate(item.Lesson.StartDate, item.Lesson.EndDate) · @FormatLessonType(item.Lesson.Type)</div>
                            <div class="lesson-progress-line">
                                <span class="lesson-places">@item.RemainingSpots / @item.Capacity places</span>
                                <div class="progress-bar" role="progressbar"
                                     aria-valuemin="0"
                                     aria-valuemax="100"
                                     aria-valuenow="@GetLessonAvailabilityPercent(item)"
                                     style="--progress:@GetLessonAvailabilityPercent(item);">
                                    <span></span>
                                </div>
                            </div>
                        </div>
                        <span class="lesson-status @GetInviteStatusClass(item.Status)">
                            @GetInviteStatusLabel(item.Status)
                        </span>
                    </a>
                }
            </div>
        </FluentCard>
    </div>
</div>

@if (isDrawerOpen)
{
    <button class="drawer-scrim" type="button" aria-hidden="true" @onclick="CloseDrawer"></button>
    <aside class="member-drawer" role="dialog" aria-modal="true" aria-labelledby="drawer-title">
        <div class="drawer-header">
            <h2 id="drawer-title">@drawerTitle</h2>
            <FluentButton Appearance="Appearance.Stealth" @onclick="CloseDrawer">Fermer</FluentButton>
        </div>
        <div class="drawer-content">
            @if (drawerMode == DrawerMode.SubscriptionDetails && selectedSubscription is not null)
            {
                <div class="drawer-section">
                    <div class="drawer-field">
                        <span class="drawer-label">Statut</span>
                        <span class="drawer-value">@GetSubscriptionStatusLabel(selectedSubscription.Status)</span>
                    </div>
                    <div class="drawer-field">
                        <span class="drawer-label">Debut</span>
                        <span class="drawer-value">@FormatDate(selectedSubscription.StartDate)</span>
                    </div>
                    <div class="drawer-field">
                        <span class="drawer-label">Fin</span>
                        <span class="drawer-value">@FormatDate(selectedSubscription.EndDate)</span>
                    </div>
                    <div class="drawer-field">
                        <span class="drawer-label">Seances achetees</span>
                        <span class="drawer-value">@selectedSubscription.LessonsTotal</span>
                    </div>
                    <div class="drawer-field">
                        <span class="drawer-label">Seances restantes</span>
                        <span class="drawer-value">@selectedSubscription.LessonsRemaining</span>
                    </div>
                    <div class="drawer-field">
                        <span class="drawer-label">Progression</span>
                        <div class="progress-bar" role="progressbar"
                             aria-valuemin="0"
                             aria-valuemax="100"
                             aria-valuenow="@GetLessonsRemainingPercent(selectedSubscription)"
                             style="--progress:@GetLessonsRemainingPercent(selectedSubscription);">
                            <span></span>
                        </div>
                    </div>
                </div>
            }
            else if (drawerMode == DrawerMode.EditDetails)
            {
                <div class="drawer-form">
                    <FluentTextField Label="Prenom" @bind-Value="editModel.FirstName" />
                    <FluentTextField Label="Nom" @bind-Value="editModel.LastName" />
                    <FluentTextField Label="Email" @bind-Value="editModel.Email" />
                    <FluentTextField Label="Telephone" @bind-Value="editModel.Phone" />
                    <FluentTextField Label="Adresse" @bind-Value="editModel.Street" />
                    <FluentTextField Label="Code postal" @bind-Value="editModel.ZipCode" />
                    <FluentTextField Label="Ville" @bind-Value="editModel.City" />
                    <FluentTextField Label="Pays" @bind-Value="editModel.Country" />
                </div>
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="CloseDrawer">Annuler</FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="SaveMember">
                        Enregistrer
                    </FluentButton>
                </div>
            }
            else if (drawerMode == DrawerMode.SubscriptionCreate)
            {
                <div class="drawer-form">
                    <FluentTextField Label="Debut (dd/MM/yyyy)" @bind-Value="subscriptionCreateModel.StartDate" />
                    <FluentTextField Label="Fin (dd/MM/yyyy)" @bind-Value="subscriptionCreateModel.EndDate" />
                    <FluentNumberField Label="Seances achetees" @bind-Value="subscriptionCreateModel.LessonsTotal" />
                </div>
                <div class="drawer-actions">
                    <FluentButton Appearance="Appearance.Outline" @onclick="CloseDrawer">Annuler</FluentButton>
                    <FluentButton Appearance="Appearance.Accent" @onclick="CreateSubscription">
                        Enregistrer
                    </FluentButton>
                </div>
            }
        </div>
    </aside>
}

@code {
    [Parameter]
    public int MemberId { get; set; }

    private readonly List<Member> members =
    [
        new Member("Camille", "Durand")
        {
            Id = 1,
            Email = "camille.durand@gymxyz.fr",
            Phone = "06 12 34 56 78",
            Address = new Address
            {
                Street = "12 rue des Lilas",
                ZipCode = "69003",
                City = "Lyon",
                Country = "France"
            }
        },
        new Member("Lucas", "Martin")
        {
            Id = 2,
            Email = "lucas.martin@gymxyz.fr",
            Phone = "06 87 65 43 21",
            Address = new Address
            {
                Street = "8 avenue du Prado",
                ZipCode = "13008",
                City = "Marseille",
                Country = "France"
            }
        }
    ];

    private readonly List<Lesson> lessons =
    [
        new CollectiveLesson
        {
            Id = 1,
            Name = "HIIT Blast",
            Type = LessonType.Collective,
            StartDate = DateTime.Today.AddHours(9),
            EndDate = DateTime.Today.AddHours(10),
            Coach = new Coach("Nora", "Lemoine")
        },
        new PrivateLesson
        {
            Id = 2,
            Name = "Coaching Perso",
            Type = LessonType.Private,
            StartDate = DateTime.Today.AddDays(-2).AddHours(11),
            EndDate = DateTime.Today.AddDays(-2).AddHours(12),
            Coach = new Coach("Samir", "El Amrani")
        },
        new CollectiveLesson
        {
            Id = 3,
            Name = "Mobility Flow",
            Type = LessonType.Collective,
            StartDate = DateTime.Today.AddDays(3).AddHours(18),
            EndDate = DateTime.Today.AddDays(3).AddHours(19),
            Coach = new Coach("Juliette", "Moreau")
        }
    ];

    private readonly List<SubscriptionItem> subscriptions =
    [
        new SubscriptionItem(
            DateOnly.FromDateTime(DateTime.Today.AddMonths(-2)),
            DateOnly.FromDateTime(DateTime.Today.AddMonths(10)),
            SubscriptionStatus.Active,
            24,
            16),
        new SubscriptionItem(
            DateOnly.FromDateTime(DateTime.Today.AddMonths(-6)),
            DateOnly.FromDateTime(DateTime.Today.AddMonths(-1)),
            SubscriptionStatus.Expired,
            10,
            0)
    ];

    private readonly List<MemberLessonItem> memberLessons =
    [
        new MemberLessonItem(new CollectiveLesson
        {
            Id = 1,
            Name = "HIIT Blast",
            Type = LessonType.Collective,
            StartDate = DateTime.Today.AddHours(9),
            EndDate = DateTime.Today.AddHours(10),
            Coach = new Coach("Nora", "Lemoine")
        }, InviteStatus.Confirmed, 20, 6),
        new MemberLessonItem(new PrivateLesson
        {
            Id = 2,
            Name = "Coaching Perso",
            Type = LessonType.Private,
            StartDate = DateTime.Today.AddDays(-2).AddHours(11),
            EndDate = DateTime.Today.AddDays(-2).AddHours(12),
            Coach = new Coach("Samir", "El Amrani")
        }, InviteStatus.Completed, 1, 0),
        new MemberLessonItem(new CollectiveLesson
        {
            Id = 3,
            Name = "Mobility Flow",
            Type = LessonType.Collective,
            StartDate = DateTime.Today.AddDays(3).AddHours(18),
            EndDate = DateTime.Today.AddDays(3).AddHours(19),
            Coach = new Coach("Juliette", "Moreau")
        }, InviteStatus.Pending, 12, 4)
    ];

    private Member selectedMember = default!;
    private MemberStats memberStats = new(18, 92, DateOnly.FromDateTime(DateTime.Today.AddDays(-3)), 68);
    private SubscriptionItem? selectedSubscription;
    private DrawerMode drawerMode = DrawerMode.None;
    private MemberEditModel editModel = new();
    private SubscriptionCreateModel subscriptionCreateModel = new();
    private bool isDrawerOpen => drawerMode != DrawerMode.None;
    private string drawerTitle => drawerMode switch
    {
        DrawerMode.EditDetails => "Editer le membre",
        DrawerMode.SubscriptionCreate => "Ajouter un abonnement",
        DrawerMode.SubscriptionDetails when selectedSubscription is not null => GetSubscriptionTitle(selectedSubscription),
        _ => "Abonnement"
    };

    protected override void OnParametersSet()
    {
        selectedMember = members.FirstOrDefault(member => member.Id == MemberId) ?? members[0];
        BreadcrumbService.SetItems(
        [
            new BreadcrumbItem { IsHome = true, Href = "/" },
            new BreadcrumbItem { Text = "Membres", Href = "/members" },
            new BreadcrumbItem { Text = $"{selectedMember.FirstName} {selectedMember.LastName}" }
        ]);
    }

    private static string FormatAddress(Address? address)
    {
        if (address is null)
        {
            return "-";
        }

        var parts = new List<string> { address.Street, address.ZipCode, address.City, address.Country }
            .Where(value => !string.IsNullOrWhiteSpace(value));
        return string.Join(", ", parts);
    }

    private static string FormatLessonType(LessonType type)
    {
        return type == LessonType.Collective ? "Collectif" : "Prive";
    }

    private static string FormatLessonDate(DateTime start, DateTime end)
    {
        return $"{start:dd/MM/yyyy} · {start:HH:mm} - {end:HH:mm}";
    }

    private static string FormatDate(DateOnly date)
    {
        return date.ToString("dd/MM/yyyy");
    }

    private static int GetLessonsRemainingPercent(SubscriptionItem subscription)
    {
        if (subscription.LessonsTotal <= 0)
        {
            return 0;
        }

        return (int)Math.Round(subscription.LessonsRemaining * 100d / subscription.LessonsTotal);
    }

    private static string GetSubscriptionTitle(SubscriptionItem subscription)
    {
        return $"Abonnement {subscription.LessonsTotal} seances";
    }

    private static int GetLessonAvailabilityPercent(MemberLessonItem item)
    {
        if (item.Capacity <= 0)
        {
            return 0;
        }

        return (int)Math.Round(item.RemainingSpots * 100d / item.Capacity);
    }

    private static string GetInviteStatusLabel(InviteStatus status)
    {
        return status switch
        {
            InviteStatus.Confirmed => "Confirme",
            InviteStatus.Pending => "En attente",
            _ => "Termine"
        };
    }

    private static string GetInviteStatusClass(InviteStatus status)
    {
        return status switch
        {
            InviteStatus.Confirmed => "status-confirmed",
            InviteStatus.Pending => "status-pending",
            _ => "status-completed"
        };
    }

    private static string GetSubscriptionStatusLabel(SubscriptionStatus status)
    {
        return status switch
        {
            SubscriptionStatus.Active => "Actif",
            SubscriptionStatus.Paused => "En pause",
            _ => "Expire"
        };
    }

    private static string GetSubscriptionStatusClass(SubscriptionStatus status)
    {
        return status switch
        {
            SubscriptionStatus.Active => "status-active",
            SubscriptionStatus.Paused => "status-paused",
            _ => "status-expired"
        };
    }

    private void OpenSubscriptionDetailsDrawer(SubscriptionItem subscription)
    {
        selectedSubscription = subscription;
        drawerMode = DrawerMode.SubscriptionDetails;
    }

    private void OpenSubscriptionCreateDrawer()
    {
        subscriptionCreateModel = new SubscriptionCreateModel();
        drawerMode = DrawerMode.SubscriptionCreate;
    }

    private void CreateSubscription()
    {
        var startDate = ParseDate(subscriptionCreateModel.StartDate, DateOnly.FromDateTime(DateTime.Today));
        var endDate = ParseDate(subscriptionCreateModel.EndDate, DateOnly.FromDateTime(DateTime.Today.AddMonths(1)));
        subscriptions.Add(new SubscriptionItem(
            startDate,
            endDate,
            SubscriptionStatus.Active,
            subscriptionCreateModel.LessonsTotal,
            subscriptionCreateModel.LessonsTotal));
        CloseDrawer();
    }

    private void OpenEditDrawer()
    {
        editModel = new MemberEditModel
        {
            FirstName = selectedMember.FirstName,
            LastName = selectedMember.LastName,
            Email = selectedMember.Email ?? string.Empty,
            Phone = selectedMember.Phone ?? string.Empty,
            Street = selectedMember.Address?.Street ?? string.Empty,
            ZipCode = selectedMember.Address?.ZipCode ?? string.Empty,
            City = selectedMember.Address?.City ?? string.Empty,
            Country = selectedMember.Address?.Country ?? string.Empty
        };
        drawerMode = DrawerMode.EditDetails;
    }

    private void SaveMember()
    {
        selectedMember.FirstName = editModel.FirstName;
        selectedMember.LastName = editModel.LastName;
        selectedMember.Email = editModel.Email;
        selectedMember.Phone = editModel.Phone;
        selectedMember.Address ??= new Address();
        selectedMember.Address.Street = editModel.Street;
        selectedMember.Address.ZipCode = editModel.ZipCode;
        selectedMember.Address.City = editModel.City;
        selectedMember.Address.Country = editModel.Country;
        CloseDrawer();
    }

    private void CloseDrawer()
    {
        drawerMode = DrawerMode.None;
        selectedSubscription = null;
    }

    private enum InviteStatus
    {
        Pending,
        Confirmed,
        Completed
    }

    private enum SubscriptionStatus
    {
        Active,
        Paused,
        Expired
    }

    private sealed record MemberLessonItem(Lesson Lesson, InviteStatus Status, int Capacity, int RemainingSpots);
    private sealed record SubscriptionItem(
        DateOnly StartDate,
        DateOnly EndDate,
        SubscriptionStatus Status,
        int LessonsTotal,
        int LessonsRemaining);
    private sealed record MemberStats(int TotalLessons, int AttendanceRate, DateOnly LastVisit, int SubscriptionRemainingPercent);

    private enum DrawerMode
    {
        None,
        SubscriptionDetails,
        EditDetails,
        SubscriptionCreate
    }

    private sealed class MemberEditModel
    {
        public string FirstName { get; set; } = string.Empty;
        public string LastName { get; set; } = string.Empty;
        public string Email { get; set; } = string.Empty;
        public string Phone { get; set; } = string.Empty;
        public string Street { get; set; } = string.Empty;
        public string ZipCode { get; set; } = string.Empty;
        public string City { get; set; } = string.Empty;
        public string Country { get; set; } = string.Empty;
    }

    private sealed class SubscriptionCreateModel
    {
        public string StartDate { get; set; } = DateTime.Today.ToString("dd/MM/yyyy");
        public string EndDate { get; set; } = DateTime.Today.AddMonths(1).ToString("dd/MM/yyyy");
        public int LessonsTotal { get; set; } = 10;
    }

    private static DateOnly ParseDate(string? value, DateOnly fallback)
    {
        if (string.IsNullOrWhiteSpace(value))
        {
            return fallback;
        }

        return DateOnly.TryParseExact(value, "dd/MM/yyyy", out var parsed) ? parsed : fallback;
    }
}
